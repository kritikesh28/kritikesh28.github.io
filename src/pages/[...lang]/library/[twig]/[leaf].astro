---
// One Leaf: one question, about two minutes. Also renders the twig's recap page.
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import LibraryGuide from '../../../../components/LibraryGuide.astro';
import LibraryCrumbs from '../../../../components/LibraryCrumbs.astro';
import ProgressMeter from '../../../../components/ProgressMeter.astro';
import { SITE } from '../../../../site.config';
import { findTwig } from '../../../../library.config';
import { getLibraryPages, getTwigPages, splitLibraryId, libraryUrl, readMinutes, translatedLangs } from '../../../../lib';
import { LANGS, DEFAULT_LANG, langFromUrl, localizePath, pick } from '../../../../i18n/config';
import { useT } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const pages = (await getLibraryPages(lang)).filter((p) => p.data.kind !== 'gateway');
    paths.push(...pages.map((page) => ({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, twig: splitLibraryId(page.id).twig, leaf: splitLibraryId(page.id).slug }, props: { page } })));
  }
  return paths;
}

const { page } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const L = (p: string) => localizePath(p, lang);
const { twig } = splitLibraryId(page.id);
const { Content } = await render(page);
const { title, description, answer, nextHook, kind, date, updated, aiAssisted, keywords } = page.data;
const twigInfo = findTwig(twig, lang)?.twig;
const all = await getTwigPages(twig, lang);
const T = pick({
  en: {
    quiz: (n: number) => `Test yourself: all ${n} questions`, quizHint: 'Try to answer each one in your head, then tap to check.', read: (n: number) => `Read Leaf ${n}`,
    endHook: (x: string) => `You have reached the end of ${x}. One page pulls it all together.`, last: 'Last step', recapQuiz: 'Recap and quick quiz',
    finished: (x: string) => `You finished ${x}`,
    whatNext: (lib: string, s: string, g: string) => `What next? Keep exploring the <a href="${lib}">library</a>, <a href="${s}">search for a question</a>, or start again from the <a href="${g}">beginning</a>.`,
    next: (n: number) => `Next · Leaf ${n}`, map: 'Course map', allOne: 'Read all on one page',
  },
  hi: {
    quiz: (n: number) => `ख़ुद को परखिए: सभी ${n} सवाल`, quizHint: 'हर सवाल का जवाब पहले मन में सोचिए, फिर छूकर जाँचिए।', read: (n: number) => `पत्ता ${n} पढ़ें`,
    endHook: (x: string) => `आप “${x}” के आख़िर तक पहुँच गए हैं। एक पन्ना पूरी बात को जोड़कर समझा देगा।`, last: 'आख़िरी कदम', recapQuiz: 'दोहराव और छोटी-सी क्विज़',
    finished: (x: string) => `आपने “${x}” पूरा कर लिया`,
    whatNext: (lib: string, s: string, g: string) => `आगे क्या? <a href="${lib}">लाइब्रेरी</a> में घूमते रहिए, <a href="${s}">कोई सवाल खोजिए</a>, या फिर से <a href="${g}">शुरुआत</a> से पढ़िए।`,
    next: (n: number) => `अगला · पत्ता ${n}`, map: 'कोर्स का नक्शा', allOne: 'सब एक पन्ने पर पढ़ें',
  },
}, lang);
const leaves = all.filter((p) => p.data.kind === 'leaf');
const recap = all.find((p) => p.data.kind === 'recap');
const index = leaves.findIndex((p) => p.slug === page.slug);
const isRecap = kind === 'recap';
const prev = isRecap ? leaves.at(-1) : leaves[index - 1];
const next = isRecap ? undefined : leaves[index + 1];
const url = new URL(libraryUrl(page.id, kind, lang), Astro.site).href;
const gatewayUrl = L(`/library/${twig}/`);
const leafUrl = (id: string, k = 'leaf') => libraryUrl(id, k, lang);

const schema: Record<string, unknown>[] = [
  {
    '@type': 'LearningResource',
    name: title,
    headline: title,
    description,
    url,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    inLanguage: page.lang,
    learningResourceType: isRecap ? 'Summary' : 'Lesson',
    educationalLevel: 'Beginner',
    keywords: keywords.join(', '),
    timeRequired: `PT${readMinutes(page.body)}M`,
    isPartOf: { '@type': 'Course', name: twigInfo?.title, url: new URL(gatewayUrl, Astro.site).href },
    author: { '@id': new URL('/#person', Astro.site).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav.library'), item: new URL(L('/library/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: twigInfo?.title, item: new URL(gatewayUrl, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
// The short answer doubles as a question-and-answer snippet for search engines
if (answer) schema.push({ '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: title, acceptedAnswer: { '@type': 'Answer', text: answer } }] });
---

<Base {title} {description} type="article" published={date} {updated} {schema} translated={await translatedLangs('library', page.slug)}>
  <div class="wrap leaf-layout">
    <article class="leaf">
      <LibraryCrumbs {twig} current={isRecap ? t('lib.recap') : t('lib.leafN', { n: index + 1 })} />
      {!isRecap && (
        <ol class="dots" aria-label={t('lib.leafNofM', { n: index + 1, m: leaves.length })}>
          {leaves.map((l, i) => (
            <li data-leaf-id={l.slug} class:list={{ now: i === index }}>
              <a href={leafUrl(l.id)} title={`${i + 1}. ${l.data.title}`}><span class="sr-only">{i + 1}. {l.data.title}</span></a>
            </li>
          ))}
        </ol>
      )}
      <p class="eyebrow">{isRecap ? t('lib.recap') : t('lib.leafNofM', { n: index + 1, m: leaves.length })} · {t('common.minRead', { n: readMinutes(page.body) })}</p>
      <h1 lang={page.lang}>{title}</h1>
      {answer && (
        <div class="answer" lang={page.lang}>
          <p class="eyebrow">{t('lib.shortAnswer')}</p>
          <p>{answer}</p>
        </div>
      )}
      <div class="prose body" lang={page.lang}><Content /></div>

      {isRecap && (
        <section class="quiz">
          <h2>{T.quiz(leaves.length)}</h2>
          <p class="muted small">{T.quizHint}</p>
          {leaves.map((l, i) => (
            <details>
              <summary><span class="n">{i + 1}</span>{l.data.title}</summary>
              <p>{l.data.answer} <a href={leafUrl(l.id)}>{T.read(i + 1)}</a></p>
            </details>
          ))}
        </section>
      )}

      {aiAssisted && <p class="note small" set:html={t('ai.leaf', { name: t('site.name'), contact: L('/contact/') })} />}

      <div class="end" data-leaf-end={page.slug}>
        {next && (
          <a class="next" href={leafUrl(next.id)} rel="next">
            {nextHook && <span class="hook">{nextHook}</span>}
            <span class="next-label">{T.next(index + 2)}</span>
            <strong>{next.data.title} <span aria-hidden="true">→</span></strong>
          </a>
        )}
        {!next && !isRecap && recap && (
          <a class="next" href={leafUrl(recap.id, 'recap')} rel="next">
            <span class="hook">{T.endHook(twigInfo?.title ?? '')}</span>
            <span class="next-label">{T.last}</span>
            <strong>{T.recapQuiz} <span aria-hidden="true">→</span></strong>
          </a>
        )}
        {isRecap && (
          <div class="finish">
            <p class="eyebrow">{T.finished(twigInfo?.title ?? '')}</p>
            <ProgressMeter {twig} total={leaves.length} />
            <p set:html={T.whatNext(L('/library/'), L('/search/'), gatewayUrl)} />
          </div>
        )}
        <p class="side-links small">
          {prev && <a href={leafUrl(prev.id)} rel="prev">← {isRecap ? t('lib.leafN', { n: leaves.length }) : t('lib.leafN', { n: index })}</a>}
          <a href={gatewayUrl}>{T.map}</a>
          <a href={`${gatewayUrl}all/`}>{T.allOne}</a>
        </p>
      </div>
    </article>

    <aside class="side">
      <div class="sticky">
        <LibraryGuide here="Leaf" />
        <div class="side-progress">
          <p class="small"><strong>{twigInfo?.title}</strong></p>
          <ProgressMeter {twig} total={leaves.length} />
        </div>
      </div>
    </aside>
  </div>
</Base>

<script>
  import { paintProgress, watchLeafEnds } from '../../../../scripts/library-progress';
  paintProgress();
  watchLeafEnds();
</script>

<style>
  .leaf-layout { display: grid; grid-template-columns: minmax(0, 720px) 280px; gap: 3rem; justify-content: center; }
  .side .sticky { position: sticky; top: 84px; display: grid; gap: 1rem; }
  .side-progress { padding: 0 0.3rem; }
  .side-progress p { margin: 0 0 0.4rem; }
  .dots { list-style: none; display: flex; gap: 5px; padding: 0; margin: 0 0 1rem; }
  .dots li { flex: 1; }
  .dots a { display: block; height: 6px; border-radius: 999px; background: var(--line); transition: background 0.3s; }
  .dots li.done a { background: color-mix(in srgb, var(--teal) 70%, transparent); }
  .dots li.now a { background: var(--accent); }
  .dots a:hover { background: var(--coral); }
  h1 { margin-top: 0.2rem; }
  .answer { margin: 1.2rem 0 1.4rem; padding: 1rem 1.2rem; border-radius: var(--radius); background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--teal) 10%, var(--surface))); border: 1px solid var(--line); }
  .answer .eyebrow { margin: 0 0 0.3rem; color: var(--accent); }
  .answer p:last-child { margin: 0; font-size: 1.08rem; line-height: 1.6; }
  .body :global(h2) { font-size: 1.3rem; margin-top: 1.8rem; }
  .end { margin-top: 2.4rem; }
  .next {
    display: grid; gap: 0.3rem; padding: 1.3rem 1.4rem; border-radius: 18px; text-decoration: none; color: #f6e7c8;
    background: radial-gradient(120% 140% at 85% 0%, #3a2b6a 0%, #1d1838 60%, #120f24 100%);
    box-shadow: 0 18px 40px -20px rgb(18 15 36 / 0.7); transition: transform 0.25s, box-shadow 0.25s;
  }
  .next:hover { transform: translateY(-3px); color: #fff3dc; box-shadow: 0 24px 48px -20px rgb(18 15 36 / 0.8); }
  .hook { font-style: italic; color: rgb(246 231 200 / 0.85); }
  .next-label { font: 600 0.72rem/1 var(--font-sans); letter-spacing: 0.2em; text-transform: uppercase; color: #e8c584; margin-top: 0.4rem; }
  .next strong { font: 600 1.35rem/1.3 var(--font-serif); color: #fff6e6; }
  .side-links { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1rem; }
  .quiz details { border: 1px solid var(--line); border-radius: 12px; padding: 0.7rem 0.9rem; margin: 0.5rem 0; background: var(--surface); }
  .quiz summary { cursor: pointer; font-weight: 600; display: flex; gap: 0.6rem; }
  .quiz .n { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 0.85rem; }
  .quiz details p { margin: 0.6rem 0 0.2rem; }
  .finish { padding: 1.2rem; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .finish .eyebrow { margin-top: 0; }
  .note { border-left: 3px solid var(--gold); padding: 0.3rem 0.8rem; color: var(--ink-soft); background: color-mix(in srgb, var(--gold) 8%, transparent); border-radius: 0 8px 8px 0; margin-top: 2rem; }
  @media (max-width: 980px) {
    .leaf-layout { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .side { order: 2; }
    .side .sticky { position: static; }
  }
</style>
