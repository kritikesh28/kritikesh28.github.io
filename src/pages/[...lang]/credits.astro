<Base title={T.title} description={T.description}>
  <article class="wrap credits">
    <header class="cr-head">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.h1}</h1>
      <p class="lede">{T.lede}</p>
      <p class="links"><a href={L('/aspirants/why-this-format/')}>{T.why}</a> · <a href={L('/aspirants/')} lang="hi">{T.talks}</a></p>
    </header>

    <section aria-labelledby="mine-h">
      <h2 id="mine-h">{T.mineH}</h2>
      <div class="two">
        <div class="box"><h3>{T.mineL}</h3><ul>{T.notMine.map((x) => <li>{x}</li>)}</ul></div>
        <div class="box mine"><h3>{T.mineR}</h3><ul>{T.mine.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="pyq-h">
      <h2 id="pyq-h">{T.pyqH}</h2>
      <p>{T.pyqP}</p>
      <ol class="bib">
        {T.pyq.map((p) => <li><cite>{p.b}</cite>, {T.by} {p.by}. <span class="pub">{T.pubL}: {p.pub}.</span> <span class="use">{p.use}</span></li>)}
      </ol>
    </section>

    <section aria-labelledby="ci-h">
      <h2 id="ci-h">{T.ciH}</h2>
      <p>{T.ciP}</p>
    </section>

    <section aria-labelledby="lib-h">
      <h2 id="lib-h">{T.libH}</h2>
      <p>{T.libP}</p>
      <ul class="shelves">{shelves.map((s) => <li><a href={L(s.href)}>{s.name}</a></li>)}</ul>
    </section>

    <section aria-labelledby="read-h">
      <h2 id="read-h">{T.readH}</h2>
      <p>{T.readP}</p>
      <ol class="bib">
        {reading.map((b) => <li><cite>{b.title}</cite>{b.by !== 'Traditional' && <>, {b.by}</>}{b.year > 0 && <> ({b.year})</>}. <span class="use">{tr(b.idea)}</span></li>)}
      </ol>
    </section>

    <section aria-labelledby="other-h">
      <h2 id="other-h">{T.otherH}</h2>
      <dl class="other">{T.other.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>

    <section class="cp" aria-labelledby="cp-h">
      <h2 id="cp-h">{T.cpH}</h2>
      {T.cp.map((p) => <p>{p}</p>)}
      <ol>{T.rules.map((r) => <li>{r}</li>)}</ol>
      <p class="note">{T.cpNote}</p>
    </section>

    <section class="pledge" aria-labelledby="pub-h">
      <h2 id="pub-h">{T.pubH}</h2>
      <p>{T.pubP}</p>
      <p><a class="btn" href={mail('About my work on Curious Sparoows')}>{T.write}: {SITE.email}</a></p>
      <h3>{T.shareH}</h3>
      <p>{T.shareP}</p>
    </section>

    <section aria-labelledby="nature-h">
      <h2 id="nature-h">{T.natureH}</h2>
      <p class="quiet">{T.natureP}</p>
      <h3>{T.missH}</h3>
      <p>{T.missP} <a href={mail('Credit correction')}>{SITE.email}</a></p>
    </section>
  </article>
</Base>

