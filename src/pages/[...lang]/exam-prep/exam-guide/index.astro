  .tiles dd { margin: 0.1rem 0 0; font: 600 1.6rem/1.2 var(--font-serif); color: var(--tree); font-variant-numeric: tabular-nums; }
  .tiles dd.src { font: 500 0.92rem/1.4 var(--font-sans); color: var(--ink); }
  .sec { font-size: 1.3rem; margin: 2rem 0 0.3rem; scroll-margin-top: 140px; }
  .bars { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .bars li { margin: 0; }
  .bars :global(button) { width: 100%; display: grid; grid-template-columns: 9rem 1fr 10rem; gap: 0.8rem; align-items: center; font: inherit; font-size: 0.9rem; color: var(--ink); background: none; border: 1px solid transparent; border-radius: 10px; padding: 0.35rem 0.5rem; cursor: pointer; text-align: left; }
