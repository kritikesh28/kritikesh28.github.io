  .filters label { min-width: 9rem; }
  .filters .grow { flex: 1; min-width: 12rem; }
  .filters .check { display: flex; align-items: center; gap: 0.45rem; min-width: 0; padding-bottom: 0.5rem; font-size: 0.88rem; cursor: pointer; }
  .filters .check input { width: 1.05rem; height: 1.05rem; accent-color: var(--tree); }
  .filters .check span { margin: 0; font-size: 0.88rem; color: var(--ink); }
  .list { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.45rem; }
  .list :global(li) { margin: 0; }
  .list :global(a) { display: grid; grid-template-columns: 2.6rem 1fr auto; gap: 0.8rem; align-items: center; padding: 0.75rem 1rem; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .list :global(a:hover) { border-color: var(--tree); transform: translateX(3px); }
  .list :global(.beyond a) { background: transparent; border-style: dashed; }
  .list :global(.rk) { font: 600 1.1rem var(--font-serif); color: var(--tree); text-align: right; font-variant-numeric: tabular-nums; }
