  .time .pair { display: flex; gap: 0.4rem; margin: 0; }
  .pair input { width: 45%; }
  .empty { margin: 1.4rem 0 0; padding: 2rem 1rem; text-align: center; color: var(--ink-soft); border: 1.5px dashed var(--line); border-radius: 20px; }
  .result { margin-top: 1.6rem; }
  .count { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; padding: 0.9rem 1.1rem; border-radius: 18px; color: #fff3dc; background: radial-gradient(120% 140% at 85% 0%, #2a1f4d 0%, #17132e 70%); }
  .count div { min-width: 5rem; text-align: center; }
  .count b { display: block; font: 600 1.9rem/1.1 var(--font-serif); font-variant-numeric: tabular-nums; color: #f2d7a6; }
  .count span { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.8; }
  .count p { margin: 0 0 0 0.4rem; opacity: 0.85; }
  .say { display: flex; gap: 0.8rem; align-items: flex-start; margin: 1rem 0; padding: 1rem 1.1rem; border-radius: 18px; background: color-mix(in srgb, var(--tree) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--tree) 30%, var(--line)); }
  .say p { margin: 0; }
  .avatar { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--tree); color: #fff; }
