  .list :global(.maj) { display: block; font-size: 0.84rem; color: var(--ink-soft); }
  .list :global(.num) { text-align: right; display: grid; gap: 0.1rem; }
  .list :global(.st) { color: var(--gold); letter-spacing: 0.08em; font-size: 0.9rem; }
  .list :global(.q) { font-size: 0.78rem; color: var(--ink-soft); white-space: nowrap; }
  .list :global(.none) { padding: 1rem; color: var(--ink-soft); }
  .pagelink { margin: 0.8rem 0 0; font-weight: 600; }
  .honest { margin-top: 1.6rem; padding: 1rem 1.2rem; border-radius: 16px; border-left: 4px solid var(--tree); background: var(--surface); }
