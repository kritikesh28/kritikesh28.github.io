---
// Ten real exam questions, exactly as they were asked, one to a screen. Pick an option: right or wrong shows at once,
// then "the facts behind it" (the Q&A rows made from this MCQ). Without JavaScript all ten show with a "Show answer".
// Guide: docs/19-pyq-practice.md
import ExamLayout from '../../../../../../../layouts/ExamLayout.astro';
import OrigToggle from '../../../../../../../components/exam/OrigToggle.astro';
import QuizModes from '../../../../../../../components/exam/QuizModes.astro';
import SolQA from '../../../../../../../components/exam/SolQA.astro';
import { BANKS, inLang, orig, mcqSets, pyqPath, rowsForMcq, setOfRow, solution, mostAsked, heat, ciTopicOfRow, type Bank, type Mcq } from '../../../../../../../pyq';
import { paths, ciTopic, topicUrlIn } from '../../../../../../../exam-prep';
import { langFromUrl, withLangs, pick } from '../../../../../../../i18n/config';
import '../../../../../../../styles/pyq.css';

export function getStaticPaths() {
  return withLangs(BANKS.flatMap((b) => mcqSets(b).map((s) => ({ params: { bank: b.slug, paper: s.paper.id, set: String(s.set) }, props: { key: b.key, seq: s.seq } }))));
}
const lang = langFromUrl(Astro.url);
const { key, seq } = Astro.props as { key: Bank['key']; seq: number };
const b = inLang(BANKS.find((x) => x.key === key)!, lang);
const all = mcqSets(b);
const S = all[seq];
const prev = all[seq - 1];
const next = all[seq + 1];
const cl = b.content;
const { BASE } = paths(lang);
const P = S.paper;
const chap = P.code ?? P.g ?? (cl === 'hi' ? `अध्याय ${P.no}` : `Chapter ${P.no}`);
const T = pick({
  en: {
    home: 'Exam Prep', pyq: 'PYQ', real: 'Real exam questions', page: `questions ${(S.set - 1) * 10 + 1}–${(S.set - 1) * 10 + S.m.length} of ${P.m.length}`,
    lede: 'Exactly as the exam asked them. Choose an option: you will see at once if it is right, and the small facts behind the question.',
    right: 'Right! ✓', wrong: 'Not this one. The answer is option', score: 'Score', show: 'Show answer', ans: 'Answer: option', starred: 'This answer was disputed, or the official key changed it later.',
    why: 'Why this is the answer', each: 'About each option', tip: 'Remember it',
    behind: 'What examiners ask from this', cards: 'Practise these as flip cards →', basics: 'New to this? The 30-second background', bTopic: 'What is this topic about?', bWhere: 'Where do I learn it from the basics?', bLink: 'Curriculum Index', hotT: (n: number) => `Asked in ${n} exams`, sol: 'Explanation', q: 'Question', prev: '← Back', next: 'Next →',
    pPrev: '← Previous 10', pNext: 'Next 10 →', back: 'All topics', end: 'End of the real questions 🎉', partA: 'Assistant Professor paper', partN: 'NTA UGC-NET/JRF',
    titleTail: 'Previous Year Questions with Answers', descMid: 'real past-paper MCQs with answers',
  },
  hi: {
    home: 'परीक्षा तैयारी', pyq: 'PYQ', real: 'असली परीक्षा के सवाल', page: `${P.m.length} में से सवाल ${(S.set - 1) * 10 + 1}–${(S.set - 1) * 10 + S.m.length}`,
    lede: 'ठीक वैसे जैसे परीक्षा में पूछे गए। कोई विकल्प चुनिए: तुरंत दिखेगा कि सही है या नहीं, और सवाल के पीछे के छोटे तथ्य भी।',
    right: 'सही! ✓', wrong: 'यह नहीं। सही उत्तर है विकल्प', score: 'स्कोर', show: 'उत्तर दिखाओ', ans: 'उत्तर: विकल्प', starred: 'इस उत्तर पर विवाद रहा है, या आधिकारिक कुंजी ने बाद में इसे बदला।',
    why: 'यही उत्तर क्यों', each: 'हर विकल्प के बारे में', tip: 'याद रखने की तरकीब',
    behind: 'इससे परीक्षक क्या-क्या पूछते हैं', cards: 'इन्हें फ़्लिप कार्ड में दोहराइए →', basics: 'नए हैं? 30 सेकंड की पृष्ठभूमि', bTopic: 'यह टॉपिक किस बारे में है?', bWhere: 'इसे शुरू से कहाँ पढ़ें?', bLink: 'करिकुलम इंडेक्स', hotT: (n: number) => `${n} परीक्षाओं में पूछा गया`, sol: 'व्याख्या', q: 'सवाल', prev: '← पीछे', next: 'आगे →',
    pPrev: '← पिछले 10', pNext: 'अगले 10 →', back: 'सारे टॉपिक', end: 'असली सवाल पूरे हुए 🎉', partA: 'असिस्टेंट प्रोफ़ेसर पेपर', partN: 'NTA UGC-NET/JRF',
    titleTail: 'पुराने सालों के सवाल उत्तर सहित', descMid: 'पुराने पेपरों के असली MCQ, उत्तर सहित',
  },
}, lang);
const idOf = (m: Mcq) => b.idPrefix(P, m);
// only the facts an examiner is most likely to ask, most-asked first
const facts = (m: Mcq) => mostAsked(rowsForMcq(b, idOf(m))).slice(0, 4);
const topicOf = (f: ReturnType<typeof facts>) => { for (const x of f) { const id = ciTopicOfRow(b, x.sub.slug, x.row); const t = id && ciTopic(id, lang); if (t) return { id, t }; } };
const plain = (m: Mcq) => m.s.find((x) => x.p)?.p ?? '';
const desc = `${b.short[lang]} · ${chap} ${P.t}: ${T.descMid}. ${plain(S.m[0])}`.slice(0, 160);
const schema = [{
  '@type': 'Quiz', name: `${chap} · ${P.t} (${T.page})`, inLanguage: cl, about: b.short[lang], educationalUse: 'Practice',
  hasPart: S.m.filter((m) => m.o && m.a).map((m) => ({ '@type': 'Question', eduQuestionType: 'Multiple choice', name: plain(m), acceptedAnswer: { '@type': 'Answer', text: m.o![m.a - 1] } })),
}];
---

<ExamLayout
  title={`${chap} ${P.t} (${T.page}): ${b.short[lang]} ${T.titleTail}`}
  description={desc}
  section="pyq"
  pyqBank={b.slug}
  {schema}
  crumbs={[{ href: `${BASE}/`, label: T.home }, { href: pyqPath(lang), label: T.pyq }, { href: pyqPath(lang, b.slug), label: b.short[lang] }, { href: `${pyqPath(lang, b.slug)}#real`, label: T.real }, { label: `${chap} · ${S.set}` }]}
>
  <div data-pyq-mcq data-bank={b.key} data-t-right={T.right} data-t-wrong={T.wrong} data-t-score={T.score}>
    <header class="pq-hero">
      <p class="eyebrow">{b.icon} {T.real} · {T.page}</p>
      <h1 lang={cl}>{chap} · <span data-orig={orig(P.t, P.t0)}>{P.t}</span></h1>
      <p class="sub">{T.lede}</p>
      <OrigToggle bank={b} />
      <ul class="pq-facts"><li data-score></li></ul>
    </header>

    <QuizModes n={S.m.length} />

    <div data-run data-screen-label={T.q}>
      {S.m.map((m, i) => {
        const f = facts(m);
        const keys = f.map(({ row, sub }) => `${sub.slug}:${row.n}`).join(' ');
        const firstFact = f[0] && setOfRow(b, f[0].sub, f[0].row.n);
        // two source MCQs can share an id (a parsing slip in the book); only the first one gets the solution
        const sol = P.m.find((x) => idOf(x) === idOf(m)) === m ? solution(b, idOf(m), lang) : undefined;
        return (
          <article class="pq-mcq" data-mcq data-a={m.a} data-keys={keys} data-screen={i} id={`m${m.n}`}>
            <p class="tag">#{m.n}{m.p && ` · ${m.p === 'A' ? T.partA : T.partN}`}{m.x && <> · <span lang={cl} data-orig={orig(m.x, m.o0?.x)}>{m.x}</span></>}</p>
            <div class="stem" lang={cl}>
              {m.s.map((x, bi) => { const o = m.o0?.s[bi]; return x.p ? <p data-orig={orig(x.p, o?.p)}>{x.p}</p> : x.img ? <img src={x.img} alt="" loading="lazy" decoding="async" /> : x.tb ? <table><tbody>{x.tb.map((r, ri) => <tr>{r.map((c, ci) => <td data-orig={orig(c, o?.tb?.[ri]?.[ci])}>{c}</td>)}</tr>)}</tbody></table> : null; })}
            </div>
            {m.o ? (
              <>
                <ul class="pq-opts" lang={cl}>
                  {m.o.map((o, k) => <li><button type="button" data-opt={k + 1}><span class="k">({k + 1})</span><span data-orig={orig(o, m.o0?.o?.[k])}>{o}</span></button></li>)}
                </ul>
                <p class="pq-say" aria-live="polite"></p>
                <details class="ans has-opts"><summary>{T.show}</summary><p>{T.ans} ({m.a}){m.a ? <>: <span lang={cl} data-orig={orig(m.o[m.a - 1], m.o0?.o?.[m.a - 1])}>{m.o[m.a - 1]}</span></> : ''}</p>{m.star && <p class="small muted">{T.starred}</p>}</details>
              </>
            ) : (
              <details class="ans"><summary>{T.show}</summary><p>{T.ans} ({m.a})</p>{m.star && <p class="small muted">{T.starred}</p>}</details>
            )}
            {sol && (
              <section class="pq-sol behind" lang={lang}>
                <h3>{T.sol}</h3>
                <SolQA sol={sol} a={m.a} />
              </section>
            )}
            {f.length > 0 && (() => {
              const top = topicOf(f);
              return (
                <div class="pq-facts-behind behind">
                  <h3>{T.behind}</h3>
                  <ol lang={cl}>{f.map(({ row }) => { const h = heat(row); return <li><span data-orig={orig(row.q, row.o0?.q)}>{row.q}</span> <b data-orig={orig(row.a, row.o0?.a)}>{row.a}</b>{h > 1 && <span class="pq-chip hot" title={T.hotT(h)}>🔥 {h}×</span>}</li>; })}</ol>
                  {top && (
                    <div class="pq-basics">
                      <h4>{T.basics}</h4>
                      <dl class="pq-qa" lang={lang}>
                        <dt>{T.bTopic}</dt>
                        <dd><span lang={top.t.en ? 'en' : undefined}>{top.t.t}</span>{top.t.d && <>: <span lang={top.t.en ? 'en' : undefined}>{top.t.d}</span></>}</dd>
                        <dt>{T.bWhere}</dt>
                        <dd><a href={topicUrlIn(top.id, lang)}>{T.bLink}: <span lang={top.t.en ? 'en' : undefined}>{top.t.t}</span> →</a></dd>
                      </dl>
                    </div>
                  )}
                  <p class="links">{firstFact && <a class="small" href={`${pyqPath(lang, b.slug, firstFact.sub.slug, firstFact.set)}#q${f[0].sub.slug}-${f[0].row.n}`}>{T.cards}</a>}</p>
                </div>
              );
            })()}
          </article>
        );
      })}
      <nav class="pq-pager" aria-label={T.q}>
        <button class="btn ghost" type="button" data-prev>{T.prev}</button>
        <span class="pq-dots" data-dots></span>
        <button class="btn" type="button" data-next>{T.next}</button>
      </nav>
    </div>

    <nav class="pq-pn">
      {prev ? <a href={pyqPath(lang, b.slug, 'paper', prev.paper.id, prev.set)} rel="prev"><small>{T.pPrev}</small><span lang={cl}>{prev.paper.t} · {prev.set}</span></a> : <a href={`${pyqPath(lang, b.slug)}#real`}><small>←</small><span>{T.back}</span></a>}
      {next ? <a class="nx" href={pyqPath(lang, b.slug, 'paper', next.paper.id, next.set)} rel="next"><small>{T.pNext}</small><span lang={cl}>{next.paper.t} · {next.set}</span></a> : <a class="nx" href={`${pyqPath(lang, b.slug)}#real`}><small>{T.end}</small><span>{T.back}</span></a>}
    </nav>
    <p class="pq-note small">{b.qsrc[lang]}</p>
  </div>
</ExamLayout>

<script>
  import '../../../../../../../scripts/pyq';
  import '../../../../../../../scripts/quiz-modes';
</script>
