---
// One question bank's home: the topic map (every sub-topic as a tile with its "mastered" meter)
// and the list of real exam chapters. Guide: docs/19-pyq-practice.md
import ExamLayout from '../../../../../layouts/ExamLayout.astro';
import { BANKS, pyqPath, splitTitle, heat, qaSets, mcqSets, type Bank } from '../../../../../pyq';
import { paths, fmt, topicUrlIn } from '../../../../../exam-prep';
import { langFromUrl, withLangs, pick } from '../../../../../i18n/config';
import { CI_LINKS } from '../../../../../pyq';
import '../../../../../styles/pyq.css';

export function getStaticPaths() {
  return withLangs(BANKS.map((b) => ({ params: { bank: b.slug }, props: { key: b.key } })));
}
const lang = langFromUrl(Astro.url);
const b = BANKS.find((x) => x.key === (Astro.props as { key: Bank['key'] }).key)!;
const { BASE } = paths(lang);
const cl = b.content;
const rows = b.groups.reduce((a, g) => a + g.subs.reduce((x, s) => x + s.rows.length, 0), 0);
const mcqs = b.papers.reduce((a, p) => a + p.m.length, 0);
const asked = b.groups.reduce((a, g) => a + g.subs.reduce((x, s) => x + s.rows.filter((r) => heat(r) > 1).length, 0), 0);
const minutes = Math.round(qaSets(b).length * 5);
const T = pick({
  en: {
    title: `${b.name.en}: Topic-wise Previous Year Questions, Flip Cards and Quiz`,
    desc: `${fmt(mcqs)} real ${b.short.en} exam questions and ${fmt(rows)} one-line flip cards, topic by topic, with quick quizzes. Free, no login. ${b.exams.en}.`,
    home: 'Exam Prep', pyq: 'PYQ', facts: [`${fmt(rows)} flip cards`, `${fmt(mcqs)} real exam questions`, `${fmt(asked)} facts asked in 2+ exams 🔥`, `about ${fmt(minutes)} minutes in all, 5 at a time`],
    meter: '{n} of {t} cards mastered on this device', got: '{n} mastered', mapH: 'Pick a topic', mapP: 'Each topic opens as small pages of about 40 cards (five minutes). Start anywhere.',
    cards: 'cards', set: (n: number) => (n > 1 ? ` · ${n} pages` : ''), hot: (n: number) => `🔥 ${n}`, hotT: 'facts asked in two or more exams',
    realH: 'Real exam questions, chapter by chapter', realP: 'Every MCQ exactly as the exam asked it, ten to a page, one at a time. Pick an option and see the facts behind it.', qs: 'questions',
    ci: 'In the Curriculum Index:', for: 'For', lang: b.content === 'hi' ? 'The questions are in Hindi, as they were asked.' : 'The questions are in English, as they were asked.',
    partA: 'Assistant Professor papers', partN: 'NTA UGC-NET/JRF',
  },
  hi: {
    title: `${b.name.hi}: टॉपिक-वार पुराने सवाल, फ़्लिप कार्ड और क्विज़`,
    desc: `${b.short.hi} के ${fmt(mcqs)} असली परीक्षा सवाल और ${fmt(rows)} एक-लाइन फ़्लिप कार्ड, टॉपिक-दर-टॉपिक, झटपट क्विज़ के साथ। मुफ़्त, बिना लॉग-इन। ${b.exams.hi}।`,
    home: 'परीक्षा तैयारी', pyq: 'PYQ', facts: [`${fmt(rows)} फ़्लिप कार्ड`, `${fmt(mcqs)} असली परीक्षा सवाल`, `${fmt(asked)} तथ्य 2+ परीक्षाओं में पूछे गए 🔥`, `कुल लगभग ${fmt(minutes)} मिनट, एक बार में 5`],
    meter: 'इस डिवाइस पर {t} में से {n} कार्ड याद हो गए', got: '{n} याद', mapH: 'कोई टॉपिक चुनिए', mapP: 'हर टॉपिक लगभग 40 कार्ड (पाँच मिनट) के छोटे पेजों में खुलता है। कहीं से भी शुरू कीजिए।',
    cards: 'कार्ड', set: (n: number) => (n > 1 ? ` · ${n} पेज` : ''), hot: (n: number) => `🔥 ${n}`, hotT: 'तथ्य जो दो या ज़्यादा परीक्षाओं में पूछे गए',
    realH: 'असली परीक्षा के सवाल, अध्याय-दर-अध्याय', realP: 'हर MCQ ठीक वैसा जैसा परीक्षा में आया, एक पेज पर दस, एक-एक करके। विकल्प चुनिए और उसके पीछे के तथ्य देखिए।', qs: 'सवाल',
    ci: 'पाठ्यक्रम सूचकांक में:', for: 'किसके लिए:', lang: b.content === 'hi' ? 'सवाल हिंदी में हैं, जैसे पूछे गए थे।' : 'सवाल अंग्रेज़ी में हैं, जैसे पूछे गए थे।',
    partA: 'असिस्टेंट प्रोफ़ेसर पेपर', partN: 'NTA UGC-NET/JRF',
  },
}, lang);
// Curriculum Index topics this bank links to
const ciIds = Object.entries(CI_LINKS).filter(([, refs]) => refs.some(([k]) => k === b.key)).map(([id]) => id);
const firstSet = (slug: string) => pyqPath(lang, b.slug, slug, 1);
const sets = qaSets(b);
const schema = [{
  '@type': 'Quiz', name: b.name[lang], about: b.short[lang], educationalLevel: 'Competitive exam', inLanguage: b.content,
  hasPart: b.papers.map((p) => ({ '@type': 'Quiz', name: p.t, url: new URL(pyqPath(lang, b.slug, 'paper', p.id, 1), Astro.site).href })),
}];
const nParts = (p: (typeof b.papers)[number]) => mcqSets(b).filter((s) => s.paper === p).length;
---

<ExamLayout title={T.title} description={T.desc} section="pyq" pyqBank={b.slug} {schema} crumbs={[{ href: `${BASE}/`, label: T.home }, { href: pyqPath(lang), label: T.pyq }, { label: b.short[lang] }]}>
  <div data-pyq-home data-bank={b.key} data-meter={T.meter} data-got={T.got}>
    <header class="pq-hero">
      <p class="eyebrow">{b.icon} PYQ · {b.exams[lang]}</p>
      <h1>{b.name[lang]}</h1>
      <p class="sub">{b.blurb[lang]} {T.lang}</p>
      <ul class="pq-facts">{T.facts.map((f) => <li>{f}</li>)}</ul>
      <div class="pq-meter"><span class="track"><span class="fill" data-meter-fill></span></span><span data-meter-text></span></div>
      <p class="pq-soon">{b.qaReady[lang]}</p>
    </header>

    <h2>{T.mapH}</h2>
    <p class="muted small">{T.mapP}</p>
    <div class="pq-groups">
      {b.groups.map((g) => (
        <section class="pq-group">
          <h3 lang={cl}>{splitTitle(g.t)[0]}</h3>
          <ul class="pq-tiles">
            {g.subs.map((s) => {
              const [t, note] = splitTitle(s.t);
              const hot = s.rows.filter((r) => heat(r) > 1).length;
              const n = sets.filter((x) => x.sub === s).length;
              return (
                <li class="pq-tile" data-sub={s.slug} data-n={s.rows.length}>
                  <a href={firstSet(s.slug)}>
                    <strong lang={cl}>{t}</strong>
                    {note && <small lang={cl}>{note}</small>}
                    <span class="meta">
                      <span class="pq-chip">{fmt(s.rows.length)} {T.cards}{T.set(n)}</span>
                      {hot > 0 && <span class="pq-chip hot" title={T.hotT}>{T.hot(hot)}</span>}
                      <span class="pq-chip" data-got></span>
                    </span>
                    <span class="mini"><span data-mini></span></span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <h2 id="real">{T.realH}</h2>
    <p class="muted small">{T.realP}</p>
    <ul class="pq-tiles">
      {b.papers.map((p) => {
        const a = p.m.filter((m) => m.p === 'A').length, nn = p.m.filter((m) => m.p === 'N').length;
        return (
          <li class="pq-tile">
            <a href={pyqPath(lang, b.slug, 'paper', p.id, 1)}>
              <strong lang={cl}>{p.code ?? (lang === 'hi' ? `अध्याय ${p.no}` : `Chapter ${p.no}`)} · {p.t}</strong>
              {p.code && <small>{T.partA}: {a} · {T.partN}: {nn}</small>}
              <span class="meta"><span class="pq-chip">{p.m.length} {T.qs}</span><span class="pq-chip">{nParts(p)} × 10</span></span>
            </a>
          </li>
        );
      })}
    </ul>

    {ciIds.length > 0 && (
      <p class="pq-note">{T.ci} {ciIds.slice(0, 14).map((id, i) => <>{i > 0 && ' · '}<a href={topicUrlIn(id, lang)}>{id}</a></>)}</p>
    )}
    <p class="pq-note">{b.source[lang]}</p>
  </div>
</ExamLayout>

<script>
  import '../../../../../scripts/pyq';
</script>
