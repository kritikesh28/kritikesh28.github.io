---
// All exam pages in one list: the page people land on when they search "RPSC RSSB important topics".
import ExamLayout from '../../../../layouts/ExamLayout.astro';
import { EXAM_PAGES, paths, STATS, examTitle, examTitleIn, tt, fmt } from '../../../../exam-prep';
import { langFromUrl, langParams, pick } from '../../../../i18n/config';

export const getStaticPaths = () => langParams().map((params) => ({ params }));
const lang = langFromUrl(Astro.url);
const { BASE, GUIDE } = paths(lang);
const name = (e: (typeof EXAM_PAGES)[number]) => examTitleIn(e, lang);
const P = pick({
  en: {
    full: { RPSC: 'Rajasthan Public Service Commission', RSSB: 'Rajasthan Staff Selection Board' } as Record<string, string>,
    list: 'RPSC and RSSB exams: most asked topics',
    title: 'RPSC and RSSB Exams: Most Asked Topics from Previous Year Papers',
    description: `Topic-wise previous year paper analysis for RPSC and RSSB exams: RAS, LDC, School Lecturer, CET, Patwari, VDO, Jail Prahari and more. ${fmt(STATS.questions)} questions mapped to topics. Free, no login.`,
    home: 'Exam Prep', crumb: 'Exams', eyebrow: 'Exam by exam', h1: 'Most asked topics, for every RPSC and RSSB exam',
    lede: `We read ${STATS.papers} past papers and ${STATS.syllabi} syllabi and matched ${fmt(STATS.questions)} questions to topics. Pick your exam to see what was asked most, and how much each subject weighs.`,
    papers: (n: number, y: string) => `${n} paper${n > 1 ? 's' : ''} · ${y === 'all' ? 'combined' : y}`, syl: 'Syllabus + related papers', top: 'Top:',
    foot1: 'UPSC, SSC, bank, railway, NTA and other national exams are listed on', allx: 'All exams of India', foot1b: '; their past papers come next. Until then, the', guide: 'Exam Mentor', foot2: 'shows the overall pattern across every paper we have.',
  },
  hi: {
    full: { RPSC: 'राजस्थान लोक सेवा आयोग', RSSB: 'राजस्थान कर्मचारी चयन बोर्ड' } as Record<string, string>,
    list: 'RPSC और RSSB परीक्षाएँ: सबसे ज़्यादा पूछे गए टॉपिक',
    title: 'RPSC और RSSB परीक्षाएँ: पिछले वर्षों के पेपरों से सबसे ज़्यादा पूछे गए टॉपिक',
    description: `RPSC और RSSB परीक्षाओं के पिछले वर्षों के पेपरों का टॉपिक-वार विश्लेषण: RAS, LDC, स्कूल व्याख्याता, CET, पटवारी, VDO, जेल प्रहरी और बाक़ी। ${fmt(STATS.questions)} सवाल टॉपिकों से मिलाए गए। मुफ़्त, बिना लॉग-इन।`,
    home: 'परीक्षा तैयारी', crumb: 'परीक्षाएँ', eyebrow: 'परीक्षा-वार', h1: 'हर RPSC और RSSB परीक्षा के सबसे ज़्यादा पूछे गए टॉपिक',
    lede: `${STATS.papers} पुराने पेपर और ${STATS.syllabi} सिलेबस पढ़े गए, और ${fmt(STATS.questions)} सवाल टॉपिकों से मिलाए गए। अपनी परीक्षा चुनिए और देखिए कि सबसे ज़्यादा क्या पूछा गया, और किस विषय का कितना वज़न (वेटेज) है।`,
    papers: (n: number, y: string) => `${n} पेपर · ${y === 'all' ? 'सब मिलाकर' : y}`, syl: 'सिलेबस + मिलते-जुलते पेपर', top: 'सबसे ऊपर:',
    foot1: 'UPSC, SSC, बैंक, रेलवे, NTA और देश की बाक़ी परीक्षाएँ', allx: 'भारत की सभी परीक्षाएँ', foot1b: ' वाले पन्ने पर हैं; उनके पुराने पेपर अगली बारी में जुड़ेंगे। तब तक', guide: 'परीक्षा मार्गदर्शक', foot2: 'हमारे पास के सभी पेपरों का मिला-जुला पैटर्न दिखाता है।',
  },
}, lang);
const groups = ['RPSC', 'RSSB'].map((ag) => ({
  ag,
  full: P.full[ag],
  list: EXAM_PAGES.filter((e) => e.agency === ag && !e.langOnly).sort((a, b) => Number(b.key.endsWith('-ALL')) - Number(a.key.endsWith('-ALL')) || b.papers - a.papers || examTitle(a).localeCompare(examTitle(b))),
}));
const schema = [{
  '@type': 'ItemList', name: P.list,
  itemListElement: EXAM_PAGES.filter((e) => !e.langOnly).map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: name(e), url: new URL(`${BASE}/exams/${e.slug}/`, Astro.site).href })),
}];
---

<ExamLayout
  title={P.title}
  description={P.description}
  section="exams"
  {schema}
  crumbs={[{ href: `${BASE}/`, label: P.home }, { label: P.crumb }]}
>
  <header>
    <p class="eyebrow">{P.eyebrow}</p>
    <h1>{P.h1}</h1>
    <p class="lede">{P.lede}</p>
    {lang === 'en' && <p class="hi" lang="hi">RPSC और RSSB परीक्षाओं के पिछले वर्षों के पेपरों का टॉपिक-वार विश्लेषण।</p>}
  </header>

  {groups.map((g) => (
    <section id={g.ag.toLowerCase()}>
      <h2>{g.ag} <span class="muted small">· {g.full}</span></h2>
      <ul class="ex">
        {g.list.map((e) => (
          <li>
            <a href={`${BASE}/exams/${e.slug}/`}>
              <strong>{name(e)}</strong>
              <span>{e.papers ? P.papers(e.papers, e.years) : P.syl}</span>
              <span class="top">{P.top} {e.top[0] && tt(e.top[0].id, e.top[0].t, lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="small muted">{P.foot1} <a href={`${BASE}/all-exams/`}>{P.allx}</a>{P.foot1b} <a href={`${GUIDE}/`}>{P.guide}</a> {P.foot2}</p>
</ExamLayout>

<style>
  h1 { font-size: clamp(1.9rem, 4.2vw, 2.7rem); }
  .lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 42rem; margin: 0; }
  .hi { color: var(--ink-soft); }
  .ex { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .ex li { margin: 0; }
  .ex a { height: 100%; display: grid; gap: 0.2rem; align-content: start; padding: 0.9rem 1rem; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .ex a:hover { border-color: var(--tree); transform: translateY(-2px); }
  .ex strong { font: 600 1.08rem var(--font-serif); }
  .ex span { font-size: 0.84rem; color: var(--ink-soft); }
  .ex .top { color: var(--tree); }
</style>
