---
// One page per Rajasthan exam, written to answer what aspirants actually search:
// "<exam> important topics", "<exam> subject wise weightage", "<exam> previous year paper analysis".
// The first paragraph answers in plain words, so search engines and AI assistants can quote it.
import ExamLayout from '../../../../layouts/ExamLayout.astro';
import { EXAM_PAGES, subjectsIn, paths, topicUrlIn, examTitleIn, tt, isEnglish, fmt, type ExamPage } from '../../../../exam-prep';
import { langFromUrl, withLangs } from '../../../../i18n/config';

export function getStaticPaths() {
  return withLangs(EXAM_PAGES.map((e) => ({ params: { exam: e.slug }, props: { e } })));
}
const { e: raw } = Astro.props as { e: ExamPage };
const lang = langFromUrl(Astro.url);
const hi = lang === 'hi';
const { BASE, GUIDE } = paths(lang);
const SUBJ = subjectsIn(lang);
const topicUrl = (id: string) => topicUrlIn(id, lang);
// topic titles in this language (major-topic name too)
const e = { ...raw, top: raw.top.map((t) => ({ ...t, t: tt(t.id, t.t, lang), major: t.major ? tt(t.id.match(/^[A-Z]{3}-\d+/)?.[0] ?? '', t.major, lang) : '' })) };
const name = examTitleIn(e, lang);
const has = e.papers > 0;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const sname = (i: number) => SUBJ[i].name;
const and = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} ${hi ? 'और' : 'and'} ${a.at(-1)}` : a.join(''));
const top3 = e.top.slice(0, 3).map((t) => t.t);
const subj = e.subjects.filter(([, q]) => q >= 0.1);
const totalQ = subj.reduce((a, [, q]) => a + q, 0) || 1;
const yearsText = e.years === 'all' ? (hi ? `${e.papers} पेपर` : `${e.papers} papers`) : e.years;
const paperText = hi ? (e.papers === 1 ? 'एक पेपर' : `${e.papers} पेपरों`) : e.papers === 1 ? 'one paper' : `${e.papers} papers`;
const langPaper = e.langOnly ? (e.paperList[0]?.[1] ?? (hi ? 'भाषा' : 'language paper')) : '';
const guideUrl = `${GUIDE}/?exam=${e.key}`;

const title = hi
  ? e.langOnly ? `${name}: ${langPaper} पेपर के सबसे ज़्यादा पूछे गए टॉपिक`
    : has ? `${name} के सबसे ज़्यादा पूछे गए टॉपिक: टॉपिक-वार PYQ विश्लेषण और विषय-वार वेटेज`
    : `${name} सिलेबस के टॉपिक, ${e.agency} के पुराने पेपरों के हिसाब से क्रम में`
  : e.langOnly ? `${name}: Most Asked Topics in the ${langPaper} Paper`
    : has ? `${name} Most Asked Topics: Topic-wise PYQ Analysis and Subject Weightage`
    : `${name} Syllabus Topics Ranked by ${e.agency} Past Papers`;
const description = hi
  ? has ? `${name} के ${paperText} (${yearsText}) का मुफ़्त टॉपिक-वार विश्लेषण: सबसे ज़्यादा पूछे गए टॉपिक, विषय-वार वेटेज, और आपके समय के हिसाब से पढ़ाई की योजना। बिना लॉग-इन।`
    : `${name}: सिलेबस का हर टॉपिक, इस हिसाब से क्रम में कि ${e.agency} की दूसरी परीक्षाओं में वह कितनी बार पूछा गया, आधिकारिक सिलेबस से विषय-वार वेटेज और मुफ़्त पढ़ाई योजना के साथ।`
  : has ? `Free topic-wise analysis of ${paperText} of ${name} (${yearsText}): the most asked topics, subject-wise weightage, and a study plan sized to your time. No login.`
    : `${name}: every syllabus topic, ranked by how often other ${e.agency} exams asked it, with subject weightage from the official syllabus and a free study plan.`;

const answer = hi
  ? e.langOnly ? `${name} का सिर्फ़ ${langPaper} पेपर पढ़ा गया (${yearsText}), इसलिए यह पेज सिर्फ़ उसी पेपर के बारे में है। उसमें सबसे ज़्यादा पूछे गए टॉपिक थे: ${and(top3)}।`
    : has ? `${name} के जिन ${paperText} को पढ़ा गया (${yearsText}), उनमें सबसे ज़्यादा पूछे गए टॉपिक थे: ${and(top3)}। सबसे ज़्यादा सवाल ${sname(subj[0][0])} से आए, ${e.qpp} सवालों वाले पेपर में लगभग ${subj[0][1]}${subj[1] ? `, फिर ${sname(subj[1][0])} (${subj[1][1]})` : ''}${subj[2] ? ` और ${sname(subj[2][0])} (${subj[2][1]})` : ''}। सिर्फ़ ऊपर के 10 टॉपिकों से पुराने सवालों का लगभग ${pct(e.cov10)} हिस्सा आ गया, और लगभग ${fmt(e.n85)} टॉपिकों से 85%।`
    : `${name} के पुराने पेपर अभी हमारे पास नहीं हैं। यह क्रम विषयों का वज़न आधिकारिक सिलेबस से लेता है, फिर टॉपिकों को इस हिसाब से रखता है कि ${e.agency} की दूसरी परीक्षाओं में वे कितनी बार पूछे गए। इस हिसाब से सबसे ज़रूरी टॉपिक हैं: ${and(top3)}, और सबसे ज़्यादा वज़न ${sname(subj[0][0])} का है।`
  : e.langOnly
    ? `We analysed only the ${langPaper} paper of ${name} (${yearsText}), so this page covers that paper alone. Its most asked topics were ${and(top3)}.`
    : has
      ? `In ${paperText} of ${name} that we analysed (${yearsText}), the most asked topics were ${and(top3)}. ${sname(subj[0][0])} brought the most questions, about ${subj[0][1]} in a ${e.qpp}-question paper${subj[1] ? `, followed by ${sname(subj[1][0])} (${subj[1][1]})` : ''}${subj[2] ? ` and ${sname(subj[2][0])} (${subj[2][1]})` : ''}. The top 10 topics alone covered about ${pct(e.cov10)} of past questions, and about ${fmt(e.n85)} topics covered 85%.`
      : `We don't have past papers of ${name} yet. This ranking takes subject weights from the official syllabus, then ranks topics by how often other ${e.agency} exams asked them. By that measure the most important topics are ${and(top3)}, and ${sname(subj[0][0])} carries the most weight.`;

const faq: [string, string][] = hi ? [
  [`${name} के लिए सबसे ज़रूरी टॉपिक कौन-से हैं?`, `${has ? 'पुराने पेपरों के हिसाब से' : `सिलेबस और ${e.agency} के दूसरे पेपरों के हिसाब से`} ऊपर के पाँच टॉपिक हैं: ${and(e.top.slice(0, 5).map((t) => t.t))}। पूरी क्रमवार सूची नीचे है।`],
  [`${name} में किस विषय का वेटेज सबसे ज़्यादा है?`, `${sname(subj[0][0])} का, ${e.qpp} सवालों वाले पेपर में लगभग ${subj[0][1]} सवाल${subj[1] ? `, फिर ${sname(subj[1][0])} (लगभग ${subj[1][1]})` : ''}। ये पढ़े गए पेपरों के औसत हैं, कोई आधिकारिक योजना नहीं।`],
  [`${name} के लिए कितने टॉपिक पढ़ने होंगे?`, `लगभग ${fmt(e.n85)} टॉपिकों से पुराने सवालों का 85% हिस्सा आया। अगर समय कम है, तो परीक्षा मार्गदर्शक इसे उतना छोटा कर देता है जितना आप पूरा कर सकें: हर टॉपिक के लिए लगभग दो घंटे की ध्यान से पढ़ाई, और आख़िरी पाँचवाँ हिस्सा दिन दोहराने (रिवीज़न) के लिए ख़ाली।`],
  ['क्या यह आधिकारिक सूची है?', `नहीं। यह ${has ? `${paperText} (${yearsText})` : `${e.agency} के दूसरे पेपरों और आधिकारिक सिलेबस`} का स्वतंत्र विश्लेषण है, जिसे कंप्यूटर से पढ़ा गया, इसलिए इसमें ग़लतियाँ हो सकती हैं। पुराने पेपर बताते हैं कि क्या पूछा गया, यह नहीं कि क्या पूछा जाएगा। मौजूदा सिलेबस हमेशा ${e.agency} की आधिकारिक वेबसाइट पर ज़रूर देखिए।`],
] : [
  [`What are the most important topics for ${name}?`, `${has ? 'Going by past papers' : `Going by the syllabus and other ${e.agency} papers`}, the top five are ${and(e.top.slice(0, 5).map((t) => t.t))}. The full ranked list is below.`],
  [`Which subject has the most weightage in ${name}?`, `${sname(subj[0][0])}, at about ${subj[0][1]} questions per ${e.qpp}-question paper${subj[1] ? `, then ${sname(subj[1][0])} (about ${subj[1][1]})` : ''}. These are averages from the papers we analysed, not an official scheme.`],
  [`How many topics do I need to study for ${name}?`, `About ${fmt(e.n85)} topics covered 85% of past questions. If you have little time, the Exam Mentor trims that to what you can finish, about two focused hours per topic, and keeps the last fifth of your days free for revision.`],
  [`Is this an official list?`, `No. It is an independent analysis of ${has ? `${paperText} (${yearsText})` : `other ${e.agency} papers and the official syllabus`}, read by machine, so it can contain mistakes. Past papers show what was asked, not what will be asked. Always check the current syllabus on the official ${e.agency} website.`],
];
const W = hi ? {
  home: 'परीक्षा तैयारी', exams: 'परीक्षाएँ', based: has ? `${paperText} पर आधारित` : 'सिलेबस + मिलते-जुलते पेपरों पर आधारित',
  h1: e.langOnly ? `${name}: ${langPaper} पेपर के सबसे ज़्यादा पूछे गए टॉपिक` : has ? `${name}: पुराने पेपरों में सबसे ज़्यादा पूछे गए टॉपिक` : `${name}: सिलेबस के टॉपिक, क्रम में`,
  plan: `${name} के लिए मेरी पढ़ाई योजना बनाओ`, seeTop: `ऊपर के ${e.top.length} टॉपिक देखें`, weight: 'विषय-वार वेटेज',
  avg: `${e.qpp} सवालों वाले पेपर में औसत सवाल${has ? `, ${paperText} से` : ', आधिकारिक सिलेबस से'}।`,
  qs: 'सवाल', topH: `ऊपर के ${e.top.length} टॉपिक, सबसे ज़रूरी पहले`, cols: ['#', 'टॉपिक', 'विषय', '≈ सवाल प्रति पेपर', has ? 'कितनी बार पूछा' : 'दूसरे पेपरों में', 'आख़िरी बार'], in: 'इसमें:',
  more1: `पूरे क्रम में ${fmt(e.ranked)} टॉपिक हैं।`, more2: 'इसे परीक्षा मार्गदर्शक में खोलिए', more3: ', अपनी परीक्षा की तारीख़ डालिए, और वह सूची को आपके समय के हिसाब से छोटा कर देगा।',
  faqH: 'अभ्यर्थी जो पूछते हैं', papersH: 'यह पेज इन पेपरों पर आधारित है', andMore: (n: number) => `…और ${n} और`,
  note1: `Curious Sparoows का स्वतंत्र विश्लेषण, ${e.agency} से कोई संबंध नहीं।`, how: 'क्रम कैसे बनता है', other: 'दूसरी परीक्षाएँ',
} : {
  home: 'Exam Prep', exams: 'Exams', based: has ? `Based on ${paperText}` : 'Based on syllabus + related papers',
  h1: e.langOnly ? `${name}: most asked topics in the ${langPaper} paper` : has ? `${name}: most asked topics in past papers` : `${name}: syllabus topics, ranked`,
  plan: `Make my study plan for ${name}`, seeTop: `See the top ${e.top.length} topics`, weight: 'Subject-wise weightage',
  avg: `Average questions per ${e.qpp}-question paper${has ? `, from ${paperText}` : ', from the official syllabus'}.`,
  qs: 'Qs', topH: `Top ${e.top.length} topics, most important first`, cols: ['#', 'Topic', 'Subject', '≈ Qs per paper', has ? 'Times asked' : 'Asked in other papers', 'Last asked'], in: 'in',
  more1: `The full ranking has ${fmt(e.ranked)} topics.`, more2: 'Open it in the Exam Mentor', more3: ', add your exam date, and it sizes the list to your time.',
  faqH: 'Questions aspirants ask', papersH: 'Papers this page is based on', andMore: (n: number) => `…and ${n} more`,
  note1: `Independent analysis by Curious Sparoows, not affiliated with ${e.agency}.`, how: 'How the ranking works', other: 'Other exams',
};
const schema = [
  { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  {
    '@type': 'ItemList', name: `${name}: topics ranked by past papers`, numberOfItems: e.top.length,
    itemListElement: e.top.slice(0, 20).map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.t, url: new URL(topicUrl(t.id), Astro.site).href })),
  },
];
---

<ExamLayout
  {title}
  {description}
  section="exams"
  noindex={e.langOnly}
  {schema}
  crumbs={[{ href: `${BASE}/`, label: W.home }, { href: `${BASE}/exams/`, label: W.exams }, { label: name }]}
>
  <header class="x-hero">
    <p class="eyebrow">{e.agency} · {W.based}</p>
    <h1>{W.h1}</h1>
    <p class="answer">{answer}</p>
    {!hi && <p class="hi" lang="hi">{has ? `${name} के पिछले पेपरों के आधार पर सबसे ज़्यादा पूछे गए टॉपिक और विषय-वार वेटेज।` : `${name} सिलेबस के टॉपिक, ${e.agency} के दूसरे पेपरों के आधार पर महत्व के क्रम में।`}</p>}
    <div class="cta">
      <a class="btn" href={guideUrl}>{W.plan}</a>
      <a class="btn ghost" href="#topics">{W.seeTop}</a>
    </div>
  </header>

  <h2>{W.weight}</h2>
  <p class="muted small">{W.avg}</p>
  <ul class="w">
    {subj.map(([s, q]) => (
      <li>
        <span class="nm">{sname(s)}</span>
        <span class="track"><span class="fill" data-w={Math.max(2, (q / subj[0][1]) * 100).toFixed(1)}></span></span>
        <span class="val">≈{q} {W.qs} · {Math.round((q / totalQ) * 100)}%</span>
      </li>
    ))}
  </ul>

  <h2 id="topics">{W.topH}</h2>
  <div class="tbl">
    <table>
      <thead><tr><th>{W.cols[0]}</th><th>{W.cols[1]}</th><th>{W.cols[2]}</th><th class="r">{W.cols[3]}</th><th class="r">{W.cols[4]}</th><th class="r">{W.cols[5]}</th></tr></thead>
      <tbody>
        {e.top.map((t, i) => (
          <tr>
            <td class="rk">{i + 1}</td>
            <td><a href={topicUrl(t.id)} lang={hi && isEnglish(t.t) ? 'en' : undefined}>{t.t}</a>{t.major && <span class="maj">{hi ? `${t.major} में` : `in ${t.major}`}</span>}</td>
            <td>{sname(t.s)}</td>
            <td class="r">{t.q.toFixed(2)}</td>
            <td class="r">{(has ? t.here : t.all) || '–'}</td>
            <td class="r">{t.last || '–'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="more">{W.more1} <a href={guideUrl}>{W.more2}</a>{W.more3}</p>

  <h2>{W.faqH}</h2>
  <div class="faq">
    {faq.map(([q, a]) => (
      <section>
        <h3>{q}</h3>
        <p>{a}</p>
      </section>
    ))}
  </div>

  {has && (
    <>
      <h2>{W.papersH}</h2>
      <ul class="papers small">
        {e.paperList.map(([y, p]) => <li>{y} · {p}</li>)}
        {e.papers > e.paperList.length && <li>{W.andMore(e.papers - e.paperList.length)}</li>}
      </ul>
    </>
  )}

  <p class="small muted note">{W.note1} <a href={`${GUIDE}/how-it-works/`}>{W.how}</a> · <a href={`${BASE}/exams/`}>{W.other}</a></p>
</ExamLayout>

<script>
  // widths are set from data attributes (the site's security policy blocks inline styles)
  document.querySelectorAll<HTMLElement>('.fill[data-w]').forEach((el) => (el.style.width = `${el.dataset.w}%`));
</script>

<style>
  .x-hero h1 { font-size: clamp(1.9rem, 4.2vw, 2.7rem); max-width: 22em; }
  .answer { font-size: 1.12rem; line-height: 1.6; max-width: 44rem; padding: 1rem 1.2rem; border-radius: 16px; border-left: 4px solid var(--tree); background: var(--surface); margin: 0.8rem 0 0.6rem; }
  .hi { color: var(--ink-soft); margin: 0 0 1rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  h2 { margin-top: 2.4rem; scroll-margin-top: 140px; }
  .w { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.35rem; max-width: 46rem; }
  .w li { display: grid; grid-template-columns: 10rem 1fr 8.5rem; gap: 0.8rem; align-items: center; font-size: 0.92rem; margin: 0; }
  .track { height: 10px; border-radius: 999px; background: var(--accent-soft); overflow: hidden; }
  .fill { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--tree), color-mix(in srgb, var(--tree) 55%, var(--coral))); }
  .val { text-align: right; color: var(--ink-soft); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .tbl { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); }
  table { font-size: 0.92rem; }
  th { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); background: color-mix(in srgb, var(--tree) 8%, var(--surface)); }
  .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rk { color: var(--tree); font-weight: 700; }
  td a { text-decoration: none; font-weight: 500; }
  .maj { display: block; font-size: 0.8rem; color: var(--ink-soft); }
  .more { margin-top: 0.8rem; }
  .faq { display: grid; gap: 0.6rem; max-width: 46rem; }
  .faq section { padding: 0.9rem 1.1rem; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); }
  .faq h3 { margin: 0 0 0.3rem; font-size: 1.05rem; }
  .faq p { margin: 0; color: var(--ink-soft); }
  .papers { columns: 2; padding-left: 1.1rem; }
  .note { margin-top: 2rem; }
  @media (max-width: 640px) { .w li { grid-template-columns: 1fr; gap: 0.2rem; } .val { text-align: left; } .papers { columns: 1; } }
</style>
