---
import { render } from 'astro:content';
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import ShelfPage from '../../../components/portfolio/ShelfPage.astro';
import { PF_SECTIONS, pfSection, pfName } from '../../../portfolio.config';
import FormattedDate from '../../../components/FormattedDate.astro';
import LiveDemo from '../../../components/LiveDemo.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { SITE } from '../../../site.config';
import { getProjects, translatedLangs } from '../../../lib';
import { LANGS, DEFAULT_LANG, langFromUrl, localizePath, pick } from '../../../i18n/config';
import { useT } from '../../../i18n/ui';

export async function getStaticPaths() {
  const all = await Promise.all(LANGS.map(async (lang) => ({ lang, projects: await getProjects(lang) })));
  return all.flatMap(({ lang, projects }) => [
    ...projects.map((project) => ({
      params: { lang: lang === DEFAULT_LANG ? undefined : lang, id: project.slug },
      props: { project, shelf: undefined },
    })),
    // the shelves: /portfolio/ai-ml/, /portfolio/kitchen/ ...
    ...PF_SECTIONS.map((s) => ({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, id: s.slug }, props: { project: undefined, shelf: s.slug } })),
  ]);
}

const shelf = pfSection(Astro.props.shelf);
const project = Astro.props.project ?? (await getProjects())[0];
// which languages this project is really written in (for the language switch and search engines)
const translated = await translatedLangs('projects', project.slug);
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const L = (p: string) => localizePath(p, lang);
const { Content } = await render(project);
const { title, summary, date, tags, links, image, imageAlt, status, demo, aiAssisted } = project.data;
const statusLabel = t(`status.${status}`);
const T = pick({ en: { back: '← Portfolio', try: 'Try it' }, hi: { back: '← मेरा काम', try: 'ख़ुद चलाकर देखिए' } }, lang);
const sec = pfSection(project.data.section);
const code = links.find((l) => l.href.includes('github.com'));
const schema = [
  {
    '@type': code ? 'SoftwareSourceCode' : 'CreativeWork',
    name: title,
    description: summary,
    dateCreated: date.toISOString().slice(0, 10),
    author: { '@id': new URL('/#person', Astro.site).href },
    url: new URL(L(`/portfolio/${project.slug}/`), Astro.site).href,
    inLanguage: project.lang,
    ...(image && { image: new URL(image, Astro.site).href }),
    ...(code && { codeRepository: code.href, programmingLanguage: 'Python' }),
    keywords: tags.join(', '),
  },
];
---

{shelf ? (
<PortfolioLayout title={pfName(shelf, lang)} description={lang === 'hi' ? shelf.blurbHi : shelf.blurbEn} current={shelf.slug}>
  <ShelfPage s={shelf} />
</PortfolioLayout>
) : (
<PortfolioLayout title={title} description={summary} image={image} {schema} {translated} current={project.data.section}>
  <article>
    <div class="prose" lang={project.lang}>
      <p class="small muted"><a href={L('/portfolio/')}>{T.back}</a>{sec && <> › <a href={L(`/portfolio/${sec.slug}/`)}>{pfName(sec, lang)}</a></>}</p>
      <h1>{title}</h1>
      <p class="muted">{summary}</p>
      <p><span class={`chip ${status}`}>{statusLabel}</span> <span class="small muted"><FormattedDate date={date} /></span></p>
      <p>{tags.map((t) => <span class="chip">{t}</span>)}</p>
      {aiAssisted && <p class="note small">{t('ai.project', { name: t('site.name') })}</p>}
      {links.length > 0 && <p class="links">{links.map((l) => <a class="btn ghost" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}</p>}
    </div>
    {demo && <div class="demo-wrap reveal"><h2>{T.try}</h2><LiveDemo /></div>}
    <div class="prose" lang={project.lang}>
      {image && !demo && <img src={image} alt={imageAlt ?? ''} />}
      <Content />
    </div>
  </article>
</PortfolioLayout>
)}

<style>
  .links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .note { border-left: 3px solid var(--gold); padding: 0.3rem 0.8rem; color: var(--ink-soft); background: color-mix(in srgb, var(--gold) 8%, transparent); border-radius: 0 8px 8px 0; }
  .demo-wrap { margin: 2rem 0; }
</style>
