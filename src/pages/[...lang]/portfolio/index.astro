---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getProjects } from '../../../lib';
import { langFromUrl, langParams, pick } from '../../../i18n/config';

export const getStaticPaths = () => langParams().map((params) => ({ params }));

const lang = langFromUrl(Astro.url);
const projects = await getProjects(lang);
const T = pick({
  en: { title: 'Portfolio', description: 'Data, AI and GIS projects by Kritikesh Rajpurohit.', intro: 'Projects in data, applied AI and maps. Each one has its code or a demo, and says honestly what is finished and what is still being built.' },
  hi: { title: 'मेरा काम (पोर्टफ़ोलियो)', description: 'कृतिकेश राजपुरोहित के डेटा, AI और GIS (कंप्यूटर पर नक्शे) वाले प्रोजेक्ट।', intro: 'डेटा, अप्लाइड AI (असली कामों में लगने वाली कृत्रिम बुद्धि) और नक्शों के प्रोजेक्ट। हर एक के साथ उसका कोड या चलाकर देखने लायक़ डेमो है, और ईमानदारी से लिखा है कि क्या पूरा हुआ और क्या अभी बन रहा है।' },
}, lang);
---

<Base title={T.title} description={T.description}>
  <div class="wrap">
    <h1>{T.title}</h1>
    <p class="muted narrow">{T.intro}</p>
    <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </div>
</Base>
