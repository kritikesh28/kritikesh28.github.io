---
// The Portfolio: every shelf, its projects, and what is on the workbench. Shelves: src/portfolio.config.ts
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Workbench from '../../../components/portfolio/Workbench.astro';
import { getProjects } from '../../../lib';
import { PF_GROUPS, PF_SECTIONS, pfName, pfUrl } from '../../../portfolio.config';
import { langFromUrl, langParams, localizePath, pick } from '../../../i18n/config';

export const getStaticPaths = () => langParams().map((params) => ({ params }));

const lang = langFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const projects = await getProjects(lang);
const T = pick({
  en: { title: 'Portfolio', description: 'Projects, research and handmade work by Kritikesh Rajpurohit: AI and data, maps, research papers, sketches, cooking and gardening.', intro: 'Projects in AI, data and maps; research from the field; and the things I make by hand. Each piece says honestly what is finished and what is still being built.', open: 'Open this shelf →', live: 'projects', way: 'on the way' },
  hi: { title: 'मेरा काम (पोर्टफ़ोलियो)', description: 'कृतिकेश राजपुरोहित का काम: AI और डेटा, नक्शे, शोध पत्र, स्केच, खाना और बागवानी।', intro: 'AI, डेटा और नक्शों के प्रोजेक्ट; मैदान से आया शोध; और हाथ से बनी चीज़ें। हर काम ईमानदारी से बताता है कि क्या पूरा हुआ और क्या अभी बन रहा है।', open: 'यह हिस्सा खोलें →', live: 'प्रोजेक्ट', way: 'आने वाले' },
}, lang);
---

<PortfolioLayout title={T.title} description={T.description}>
  <header class="pf-head">
    <h1>{T.title}</h1>
    <p class="muted">{T.intro}</p>
    <ul class="pf-stats">
      <li><b>{projects.length}</b> {T.live}</li>
      <li><b>{PF_SECTIONS.length}</b> {lang === 'hi' ? 'हिस्से' : 'shelves'}</li>
      <li><b>{PF_SECTIONS.reduce((a, s) => a + s.comingEn.length, 0)}</b> {T.way}</li>
    </ul>
  </header>

  {PF_GROUPS.map((g) => (
    <section class="pf-g">
      <h2 class="pf-gh">{lang === 'hi' ? g.hi : g.en}</h2>
      {PF_SECTIONS.filter((s) => s.group === g.id).map((s) => {
        const mine = projects.filter((p) => p.data.section === s.slug);
        return (
          <div class="pf-shelf" id={s.slug}>
            <div class="pf-sh">
              <h3><span aria-hidden="true">{s.icon}</span> <a href={L(pfUrl(s))}>{pfName(s, lang)}</a></h3>
              <a class="small" href={L(pfUrl(s))}>{T.open}</a>
            </div>
            <p class="muted small">{lang === 'hi' ? s.blurbHi : s.blurbEn}</p>
            {mine.length > 0 ? <div class="grid">{mine.map((p) => <ProjectCard project={p} />)}</div> : <Workbench s={s} empty={true} />}
          </div>
        );
      })}
    </section>
  ))}
</PortfolioLayout>

<style>
  .pf-head h1 { margin-bottom: 0.4rem; }
  .pf-stats { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; list-style: none; padding: 0; margin: 1rem 0 0; color: var(--ink-soft); }
  .pf-stats b { font-family: var(--font-serif); font-size: 1.4rem; color: var(--ink); margin-right: 0.2rem; }
  .pf-g { margin-top: 2.6rem; }
  .pf-gh { font: 700 0.78rem/1 var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 0.6rem; }
  .pf-shelf { margin-top: 1.6rem; scroll-margin-top: 90px; }
  .pf-sh { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; justify-content: space-between; }
  .pf-sh h3 { margin: 0; font-size: 1.3rem; }
  .pf-sh h3 a { color: var(--ink); text-decoration: none; }
  .pf-sh h3 span { color: var(--accent); font-size: 0.9em; }
  .pf-shelf > p { margin: 0.3rem 0 0.9rem; }
</style>
