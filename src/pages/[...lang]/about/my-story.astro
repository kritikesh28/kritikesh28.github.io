---
// My story: Kritikesh's life story as questions and answers, one at a time, with the milestones of his life.
// The words are in src/data/my-story.ts (English and Hindi). Layout: the questions are listed down the left and right,
// grouped under milestones, so a reader can jump straight to any of them; the middle shows one answer at a time
// (Previous / Next, the ← → keys, or a swipe on phones). "Read it all at once" shows every answer as one long page.
// Without JavaScript every answer simply shows, one below the other. Guide: docs/17-library-map.md, section 5, "My story".
import Base from '../../../layouts/Base.astro';
import { STORY } from '../../../data/my-story';
import { langFromUrl, langParams, localizePath, pick } from '../../../i18n/config';

export const getStaticPaths = () => langParams().map((params) => ({ params }));
const lang = langFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const hi = lang === 'hi';
const tr = (x: { en: string; hi: string }) => (hi ? x.hi : x.en);
const tra = (x: { en: string[]; hi: string[] }) => (hi && x.hi.length ? x.hi : x.en);

// every question in order, with the milestone it belongs to
const flat = STORY.flatMap((m) => m.qs.map((q) => ({ ...q, m })));
const N = flat.length;
const num = (id: string) => flat.findIndex((q) => q.id === id) + 1;
// the milestones are shared between the two side lists, about half the questions on each side
const half = N / 2;
let count = 0;
const leftM: typeof STORY = [];
const rightM: typeof STORY = [];
for (const m of STORY) { (count < half ? leftM : rightM).push(m); count += m.qs.length; }
const words = flat.reduce((s, q) => s + tra(q.a).join(' ').split(/\s+/).length, 0);
const minutes = Math.max(2, Math.round(words / 230));

const T = pick({
  en: {
    title: 'My story', description: 'The story of Kritikesh Rajpurohit, told question by question: from a naughty boy in Rawatbhata to years of UPSC preparation, geology, geography, research and applied AI.',
    eyebrow: 'My story · Kritikesh Rajpurohit', h1: 'My story, one question at a time',
    lede: 'Hello, I’m Kritikesh. This is not a CV; it is the story behind it, told the way I would tell you over a cup of tea. Pick any question from the lists, or simply start at the beginning.',
    meta: `${N} questions · about ${minutes} minutes`, start: 'Start at the beginning', all: 'Read it all at once', slides: 'One question at a time',
    jump: `All ${N} questions`, of: 'of', q: 'Question', prev: '← Previous', next: 'Next →', nextQ: 'Next:', end: 'To be continued… much more is coming.',
    rail1: 'Questions, part 1', rail2: 'Questions, part 2',
    moreT: 'This is only the beginning', more: 'What you just read is the short version. The minute details are still to come: every mistake, every wrong turn, the exact moments that cost me months, and the 100-page booklet of my teachers’ advice. I will keep sharing them here, one story at a time, so that you can learn from my mistakes and save the time I lost. Stay tuned.',
    close: 'Thank you for reading this far. If any part of it feels like your story too, I would love to hear from you.',
    contact: 'Write to me', about: 'About me', portfolio: 'My work',
    hireE: 'For recruiters', hireH: 'Years of preparation, no job title.', hireH2: 'So why AI now, and why me?',
    hireP: 'Short answer: those years built exactly what many AI teams lack. Here is what they bring to yours.',
    hire: [
      ['Real-world context', 'Geography, geology, GIS and remote sensing, governance, the economy and rural India: the ground truth that AI for real people needs.'],
      ['Research into answers', 'Eight years of turning huge syllabi into clear notes, and a field dissertation on tribal poverty. I read deeply, check sources and summarise fast.'],
      ['Self-driven discipline', 'Up at 5 a.m. for years, with no boss and no salary to push me. I learn new tools quickly and finish what I start.'],
      ['Ethics built in', 'Integrity, objectivity and empathy, studied for years as a subject and practised as a habit: the base of responsible AI.'],
    ],
    hireGo: 'Read my full answer', hireWork: 'See my work',
    ai: 'Told in my own words; arranged and lightly edited with AI help.',
  },
  hi: {
    title: 'मेरी कहानी', description: 'कृतिकेश राजपुरोहित की कहानी, सवाल-दर-सवाल: रावतभाटा के एक शरारती लड़के से UPSC की सालों की तैयारी, भूविज्ञान, भूगोल, रिसर्च और अप्लाइड AI तक।',
    eyebrow: 'मेरी कहानी · कृतिकेश राजपुरोहित', h1: 'मेरी कहानी, एक-एक सवाल करके',
    lede: 'नमस्ते, मैं कृतिकेश हूँ। यह बायोडाटा नहीं, उसके पीछे की कहानी है, वैसे ही जैसे चाय पर आपको सुनाता। सूची से कोई भी सवाल चुनिए, या बस शुरू से पढ़िए।',
    meta: `${N} सवाल · लगभग ${minutes} मिनट`, start: 'शुरू से पढ़िए', all: 'सब एक साथ पढ़िए', slides: 'एक-एक सवाल करके',
    jump: `सारे ${N} सवाल`, of: 'में से', q: 'सवाल', prev: '← पिछला', next: 'अगला →', nextQ: 'अगला:', end: 'कहानी जारी है… बहुत कुछ आना बाक़ी है।',
    rail1: 'सवाल, भाग 1', rail2: 'सवाल, भाग 2',
    moreT: 'यह तो बस शुरुआत है', more: 'आपने अभी जो पढ़ा, वह छोटा रूप है। बारीक बातें अभी आनी हैं: हर ग़लती, हर ग़लत मोड़, वे पल जिनमें मेरे महीने गए, और टीचरों की सलाहों वाली 100 पन्नों की पुस्तिका। मैं इन्हें यहाँ एक-एक करके बाँटता रहूँगा, ताकि आप मेरी ग़लतियों से सीखें और वह समय बचाएँ जो मैंने खोया। जुड़े रहिए।',
    close: 'यहाँ तक पढ़ने के लिए शुक्रिया। अगर इसका कोई हिस्सा आपको अपनी कहानी जैसा लगे, तो मुझे ज़रूर बताइए।',
    contact: 'मुझे लिखिए', about: 'मेरे बारे में', portfolio: 'मेरा काम',
    hireE: 'रिक्रूटर्स के लिए', hireH: 'सालों की तैयारी, कोई नौकरी का पद नहीं।', hireH2: 'तो अब AI क्यों, और मैं ही क्यों?',
    hireP: 'छोटा जवाब: उन सालों ने ठीक वही बनाया जिसकी कई AI टीमों में कमी होती है। यह आपकी टीम को मिलेगा।',
    hire: [
      ['ज़मीनी समझ', 'भूगोल, भूविज्ञान, GIS और रिमोट सेंसिंग, शासन, अर्थव्यवस्था और ग्रामीण भारत: वह ज़मीनी सच जिसकी असली लोगों के लिए बने AI को ज़रूरत है।'],
      ['रिसर्च से जवाब तक', 'आठ साल तक विशाल सिलेबस को साफ़ नोट्स में बदलना, और आदिवासी ग़रीबी पर फ़ील्ड शोध-प्रबंध। मैं गहराई से पढ़ता हूँ, स्रोत जाँचता हूँ और जल्दी सार निकालता हूँ।'],
      ['ख़ुद से चलने वाला अनुशासन', 'सालों तक सुबह 5 बजे उठना, बिना किसी बॉस या तनख़्वाह के। मैं नए टूल जल्दी सीखता हूँ और जो शुरू करता हूँ, पूरा करता हूँ।'],
      ['नैतिकता शुरू से', 'सत्यनिष्ठा, निष्पक्षता और सहानुभूति, सालों तक विषय के रूप में पढ़ी और आदत के रूप में जी: ज़िम्मेदार AI की नींव।'],
    ],
    hireGo: 'मेरा पूरा जवाब पढ़िए', hireWork: 'मेरा काम देखिए',
    ai: 'मेरे अपने शब्दों में; AI की मदद से सजाया और हल्का-सा सँवारा गया।',
  },
}, lang);

// for search engines: the questions and answers of this page
const schema = [{
  '@type': 'FAQPage',
  url: new URL(L('/about/my-story/'), Astro.site).href,
  mainEntity: flat.map((q) => ({ '@type': 'Question', name: tr(q.q), acceptedAnswer: { '@type': 'Answer', text: tra(q.a).join(' ') } })),
}];
---

<Base title={T.title} description={T.description} type="profile" {schema}>
  <article class="wrap mystory" data-story data-words={JSON.stringify({ all: T.all, slides: T.slides, nextQ: T.nextQ, end: T.end })}>
    <header class="ms-head">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.h1}</h1>
      <p class="lede">{T.lede}</p>
      <p class="meta">{T.meta}</p>
      <p class="modes">
        <a class="btn" href={`#${flat[0].id}`} data-go={flat[0].id}>{T.start}</a>
        <button class="btn ghost" type="button" data-mode aria-pressed="false">{T.all}</button>
      </p>
    </header>

    <section class="hire" id="for-recruiters" aria-labelledby="hire-h">
      <p class="hire-e">{T.hireE}</p>
      <h2 id="hire-h">{T.hireH} <span>{T.hireH2}</span></h2>
      <p class="hire-p">{T.hireP}</p>
      <ul>{T.hire.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ul>
      <p class="hire-go"><a class="btn" href="#why-ai" data-go="why-ai">{T.hireGo} →</a> <a class="btn ghost" href={L('/portfolio/')}>{T.hireWork}</a></p>
    </section>

    <div class="ms-grid">
      {[{ ms: leftM, label: T.rail1, side: 'left' }, { ms: rightM, label: T.rail2, side: 'right' }].map((r) => (
        <nav class:list={['rail', r.side]} aria-label={r.label}>
          <ol>
            {r.ms.map((m) => (
              <li class="mile">
                <span class="when">{tr(m.when)}</span>
                <span class="mt">{tr(m.title)}</span>
                <ol>
                  {m.qs.map((q) => <li><a href={`#${q.id}`} data-go={q.id}><span class="n">{num(q.id)}</span>{tr(q.q)}</a></li>)}
                </ol>
              </li>
            ))}
          </ol>
        </nav>
      ))}

      <div class="stage">
        <details class="jump">
          <summary>{T.jump}</summary>
          <ol>
            {STORY.map((m) => (
              <li class="mile">
                <span class="when">{tr(m.when)}</span> <span class="mt">{tr(m.title)}</span>
                <ol>{m.qs.map((q) => <li><a href={`#${q.id}`} data-go={q.id}><span class="n">{num(q.id)}</span>{tr(q.q)}</a></li>)}</ol>
              </li>
            ))}
          </ol>
        </details>

        <div class="slides" data-slides>
          {flat.map((q, i) => (
            <section class="slide" id={q.id} data-slide={i} aria-labelledby={`${q.id}-h`}>
              <p class="chip"><span class="when">{tr(q.m.when)}</span> {tr(q.m.title)}</p>
              <p class="count">{T.q} {i + 1} {T.of} {N}</p>
              <h2 id={`${q.id}-h`} tabindex="-1">{tr(q.q)}</h2>
              {tra(q.a).map((p) => <p>{p}</p>)}
            </section>
          ))}
        </div>

        <div class="controls" data-controls hidden>
          <button class="btn ghost" type="button" data-step="-1">{T.prev}</button>
          <div class="where">
            <span class="track" aria-hidden="true"><span class="fill" data-fill></span></span>
            <span class="pos" data-pos aria-live="polite"></span>
          </div>
          <button class="btn" type="button" data-step="1">{T.next}</button>
        </div>
        <p class="upnext" data-upnext></p>
      </div>
    </div>

    <footer class="ms-foot">
      <div class="more"><p class="more-t"><span class="dot" aria-hidden="true"></span>{T.moreT}</p><p>{T.more}</p></div>
      <p class="thanks">{T.close}</p>
      <p class="links"><a class="btn" href={L('/contact/')}>{T.contact}</a> <a class="btn ghost" href={L('/about/')}>{T.about}</a> <a class="btn ghost" href={L('/portfolio/')}>{T.portfolio}</a></p>
      <p class="ai">{T.ai}</p>
    </footer>
  </article>
</Base>

<script>
  import { onPage } from '../../../scripts/page';
  // runs on every page (pages change without reloading: see src/scripts/page.ts)
  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-story]');
    if (!root) return;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-go]')];
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const pos = root.querySelector<HTMLElement>('[data-pos]')!;
    const fill = root.querySelector<HTMLElement>('[data-fill]')!;
    const upnext = root.querySelector<HTMLElement>('[data-upnext]')!;
    const mode = root.querySelector<HTMLButtonElement>('[data-mode]')!;
    const jump = root.querySelector<HTMLDetailsElement>('details.jump');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const w = JSON.parse(root.dataset.words ?? '{}');
    let at = 0;
    let allMode = false;

    const show = (i: number, focus = false, mark = true) => {
      at = Math.max(0, Math.min(slides.length - 1, i));
      slides.forEach((s, k) => s.classList.toggle('on', k === at));
      const id = slides[at].id;
      links.forEach((a) => { if (a.dataset.go === id) a.setAttribute('aria-current', 'step'); else a.removeAttribute('aria-current'); });
      pos.textContent = `${at + 1} / ${slides.length}`;
      fill.style.transform = `scaleX(${(at + 1) / slides.length})`;
      prevBtn.disabled = at === 0;
      nextBtn.disabled = at === slides.length - 1;
      const nxt = slides[at + 1]?.querySelector('h2')?.textContent;
      upnext.textContent = nxt ? `${w.nextQ} ${nxt}` : w.end;
      if (mark) history.replaceState(history.state, '', `#${id}`);
      if (focus) {
        slides[at].querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
        // keep the question in view (mainly on phones, where the lists sit above it)
        const top = slides[at].getBoundingClientRect().top;
        if (top < 70 || top > innerHeight * 0.6) slides[at].scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };

    const setMode = (all: boolean) => {
      allMode = all;
      root.classList.toggle('slider', !all);
      controls.hidden = all;
      upnext.hidden = all;
      mode.setAttribute('aria-pressed', String(all));
      mode.textContent = all ? w.slides : w.all;
      if (!all) show(at, false, !!location.hash);
    };

    links.forEach((a) => a.addEventListener('click', (e) => {
      const i = slides.findIndex((s) => s.id === a.dataset.go);
      if (i < 0) return;
      if (jump) jump.open = false;
      if (allMode) { history.replaceState(history.state, '', `#${slides[i].id}`); return; } // let the browser scroll to it
      e.preventDefault();
      show(i, true);
    }));
    prevBtn.addEventListener('click', () => show(at - 1));
    nextBtn.addEventListener('click', () => show(at + 1));
    mode.addEventListener('click', () => setMode(!allMode));

    // ← and → move between questions (not while typing, and not in "read it all" mode)
    addEventListener('keydown', (e) => {
      if (allMode || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if ((e.target as HTMLElement)?.closest?.('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    }, { signal });

    // swipe on phones
    const box = root.querySelector<HTMLElement>('[data-slides]')!;
    let x0 = 0, y0 = 0;
    box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      if (allMode) return;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
    });

    // a link to one question (#why-geology) from elsewhere on the page or the address bar
    addEventListener('hashchange', () => {
      const i = slides.findIndex((s) => `#${s.id}` === location.hash);
      if (i >= 0 && !allMode && i !== at) show(i, true);
    }, { signal });

    // open at the question named in the address (#why-geology), if any
    const start = slides.findIndex((s) => `#${s.id}` === location.hash);
    at = start >= 0 ? start : 0;
    setMode(false);
  });
</script>

<style>
  .mystory { max-width: 1240px; margin-top: 1.5rem; }
  .ms-head { max-width: 46rem; margin: 0 auto 1.6rem; text-align: center; }
  .ms-head h1 { margin: 0.2rem 0 0.7rem; }
  .lede { font-family: var(--font-serif); font-size: 1.15rem; color: var(--ink-soft); margin: 0 0 0.6rem; }
  .meta { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 1rem; }
  .modes { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin: 0; }
  /* without JavaScript the "read it all" switch does nothing, so it is only shown when the slider is working */
  .mystory:not(.slider) .modes [data-mode][aria-pressed='false'] { display: none; }

  .ms-grid { display: grid; grid-template-columns: 1fr; gap: 1.2rem; align-items: start; }
  .rail { display: none; }
  @media (min-width: 1100px) {
    .ms-grid { grid-template-columns: 250px minmax(0, 1fr) 250px; gap: 1.6rem; }
    .rail { display: block; position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; }
    .rail.left { grid-column: 1; grid-row: 1; }
    .stage { grid-column: 2; grid-row: 1; }
    .rail.right { grid-column: 3; grid-row: 1; }
    .jump { display: none; }
  }

  /* the side lists: a thin line of milestones, each with its questions */
  .rail ol, .jump ol { list-style: none; margin: 0; padding: 0; }
  .rail > ol { border-left: 2px solid var(--line); margin-left: 6px; }
  .mile { position: relative; padding: 0 0 0.9rem 1rem; }
  .rail .mile::before { content: ''; position: absolute; left: -7px; top: 0.25rem; width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 3px var(--bg); }
  .when { display: inline-block; font: 700 0.72rem/1.4 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; color: #8a6438; }
  :global([data-theme='dark']) .when { color: var(--gold); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .when { color: var(--gold); } }
  .mt { display: block; font-family: var(--font-serif); font-weight: 600; font-size: 0.95rem; color: var(--ink); margin: 0.05rem 0 0.35rem; }
  .mile ol li a { display: flex; gap: 0.5rem; padding: 0.32rem 0.5rem; margin-left: -0.5rem; border-radius: 10px; color: var(--ink-soft); text-decoration: none; font-size: 0.88rem; line-height: 1.35; transition: background 0.2s, color 0.2s; }
  .mile ol li a:hover { background: var(--accent-soft); color: var(--ink); }
  .mile ol li a[aria-current] { background: var(--accent-soft); color: var(--ink); font-weight: 600; }
  .n { flex: none; min-width: 1.4rem; font: 600 0.75rem/1.6 var(--font-sans); color: var(--accent); }

  /* phones and tablets: all questions in one fold-out list */
  .jump { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 0.2rem 1rem; margin-bottom: 1rem; }
  .jump summary { cursor: pointer; padding: 0.6rem 0; font-weight: 600; }
  .jump > ol { padding-bottom: 0.6rem; }
  .jump .mile { padding-left: 0; }
  .jump .mt { display: inline; }

  /* the answer cards */
  .slide { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 1.6rem 1.6rem 1.3rem; margin-bottom: 1.2rem; scroll-margin-top: 90px; box-shadow: 0 10px 30px rgb(42 35 80 / 0.06); }
  .slide::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; border-radius: 20px 20px 0 0; background: linear-gradient(90deg, #8f7be8, var(--coral), var(--gold)); }
  .chip { display: inline-flex; gap: 0.5rem; align-items: baseline; flex-wrap: wrap; margin: 0 0 0.6rem; padding: 0.25rem 0.75rem; border-radius: 999px; background: var(--accent-soft); font-size: 0.85rem; color: var(--ink); }
  .count { margin: 0 0 0.3rem; font-size: 0.8rem; color: var(--ink-soft); }
  .slide h2 { margin: 0 0 0.8rem; font-size: clamp(1.35rem, 2.6vw, 1.8rem); line-height: 1.25; outline: none; }
  .slide p:not(.chip):not(.count) { font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.75; margin: 0 0 0.85rem; }
  .slide p:last-child { margin-bottom: 0; }

  .mystory.slider .slide { display: none; margin-bottom: 0; }
