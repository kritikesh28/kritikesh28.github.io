---
// One "not found" page for every language: it speaks both, because we cannot know which one the lost visitor reads.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · पन्ना नहीं मिला" langs={['en']} noindex>
  <div class="wrap narrow">
    <h1>This page flew away</h1>
    <p class="muted">The link may be old or mistyped. Try the <a href="/">home page</a> or the <a href="/library/">library</a>, or <a href="/search/">search</a>.</p>
    <h2 lang="hi">यह पन्ना उड़ गया</h2>
    <p class="muted" lang="hi">हो सकता है लिंक पुराना हो या उसमें टाइप की गलती हो। <a href="/hi/">होम पेज</a> या <a href="/hi/library/">लाइब्रेरी</a> पर जाइए, या <a href="/hi/search/">खोजिए</a>।</p>
  </div>
</Base>
