---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { getProjects } from '../lib';

const top = (await getProjects())[0];
---

<Base title="Start here" description="New here? Three quick paths: for recruiters, for learners and for collaborators.">
  <div class="wrap">
    <p class="eyebrow">Welcome</p>
    <h1>Start here</h1>
    <p class="muted narrow">Hi, I'm Kritikesh. Pick the door that fits you; each one takes under a minute.</p>

    <div class="doors">
      <section class="card door reveal">
        <p class="icon" aria-hidden="true">💼</p>
        <h2>You're hiring</h2>
        <ul>
          <li>Geology and Geography graduate, learning applied and agentic AI at IIIT Bangalore (2026 to 2027).</li>
          <li>Python, pandas and QGIS, with a public data project you can run in the browser.</li>
          <li>Years of teaching and exam preparation: I explain clearly and work steadily.</li>
        </ul>
        <p class="go">
          <a class="btn" href={SITE.resumePdf}>Resume (PDF)</a>
          {top && <a class="btn ghost" href={`/portfolio/${top.id}/`}>Best project</a>}
          <a class="btn ghost" href="/contact/?intent=hiring">Contact me</a>
        </p>
      </section>

      <section class="card door reveal">
        <p class="icon" aria-hidden="true">📚</p>
        <h2>You want to learn</h2>
        <ul>
          <li>{SITE.blogBrand} explains ideas from the basics up: AI, geography, exams, mind and more.</li>
          <li>Pick a theme on the blog, or follow new posts by RSS.</li>
          <li>Want a topic explained? Ask, and it may become the next post.</li>
        </ul>
        <p class="go">
          <a class="btn" href="/blog/">Open the blog</a>
          <a class="btn ghost" href="/contact/?intent=learning">Suggest a topic</a>
        </p>
      </section>

      <section class="card door reveal">
        <p class="icon" aria-hidden="true">🤝</p>
        <h2>You want to build something</h2>
        <ul>
          <li>Open to data, GIS and AI projects, research on water and poverty, and teaching content.</li>
          <li>See what I'm working on right now.</li>
        </ul>
        <p class="go">
          <a class="btn" href="/now/">What I'm doing now</a>
          <a class="btn ghost" href="/contact/?intent=collab">Propose an idea</a>
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .doors { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); margin-top: 2rem; }
  .door h2 { margin: 0; font-size: 1.3rem; }
  .icon { font-size: 2rem; margin: 0; }
  .door ul { padding-left: 1.1rem; margin: 0.3rem 0 0.6rem; color: var(--ink-soft); }
  .go { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
</style>
