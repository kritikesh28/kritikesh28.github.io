---
// The whole Library tree: every theme and discipline of The Universal Index of Human Knowledge,
// with the written topics placed on their branches. Guide: docs/17-library-map.md
import LibraryLayout from '../../../layouts/LibraryLayout.astro';
import LibraryTree from '../../../components/library/LibraryTree.astro';
import ThemeGrid from '../../../components/library/ThemeGrid.astro';
import LevelIcon from '../../../components/LevelIcon.astro';
import { BOOK, SHELVES, LINKS, THEMES, fieldUrl, FIELDS } from '../../../library-map';

const description = `The whole Curious Sparoows Library as one tree: ${BOOK.fields} disciplines and ${BOOK.nodes.toLocaleString('en-IN')} topics of human knowledge in 8 themes, with the ${SHELVES.length} shelves you can read today.`;
const schema = [
  { '@type': 'CollectionPage', name: 'The Library tree', url: new URL('/library/map/', Astro.site).href, description, inLanguage: 'en',
    hasPart: FIELDS.map((f) => ({ '@type': 'CreativeWork', name: f.name, url: new URL(fieldUrl(f.code), Astro.site).href })) },
];
const levels = [
  { level: 'Forest', name: 'Forest', means: 'The whole Library' },
  { level: 'Tree', name: 'Theme and Tree', means: `8 themes group ${BOOK.fields} disciplines, like Arts & Crafts` },
  { level: 'Branch', name: 'Branch', means: 'A main area, like Crafts and material practice' },
  { level: 'Twig', name: 'Twig', means: 'A topic told in short pages, like Crochet' },
  { level: 'Leaf', name: 'Leaf', means: 'One page, one question, a few minutes' },
] as const;
---

<LibraryLayout title="The Library tree" {description} {schema} section="map" langs={['en']}>
  <header class="mh">
    <p class="eyebrow">The Curious Sparoows Library · the whole tree</p>
    <h1>Everything people study, on one tree</h1>
    <p class="lede">{BOOK.fields} disciplines and {BOOK.nodes.toLocaleString('en-IN')} named topics, from Accounting to Veterinary science, grouped into {THEMES.length} themes. The coloured twigs are shelves you can read today. Every other name is planted first and filled with pages next, so you can watch the forest grow.</p>
  </header>

  <LibraryTree big />

  <section class="blk">
    <h2>The eight themes and their disciplines</h2>
    <p class="muted">Open a discipline to see all its branches and topics. A solid outline means pages are ready; a dashed one means the names are here and the pages are on their way.</p>
    <ThemeGrid detail />
  </section>

  <section class="blk">
    <h2>How the tree is organised</h2>
    <ol class="lv">
      {levels.map((l) => <li><LevelIcon level={l.level} size={36} /><strong>{l.name}</strong><span class="small muted">{l.means}</span></li>)}
    </ol>
  </section>

  <section class="blk" id="links">
    <h2>Where branches meet</h2>
    <p class="muted">Big questions grow across many disciplines at once. A few examples from the Index:</p>
    <dl class="links">
      {LINKS.map((k) => <div><dt>{k.topic}</dt><dd>{k.fields}</dd></div>)}
    </dl>
  </section>

  <p class="src small muted">The map is <em>{BOOK.title}</em>, {BOOK.edition}, compiled by Kritikesh Rajpurohit. It draws on UNESCO ISCED-F, the OECD Fields of Research and Development and the Library of Congress Classification outline, and it is checked and extended edition by edition. Spot a missing field? <a href="/contact/">Tell me</a>.</p>
</LibraryLayout>

<style>
  .mh { max-width: 52rem; }
  .mh h1 { margin: 0.2rem 0 0.6rem; }
  .lede { font-size: 1.1rem; color: var(--ink-soft); }
  .blk { margin-top: 3.2rem; }
  .lv { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .lv li { display: grid; gap: 0.2rem; padding: 0.9rem; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: #8a6a3b; }
  .lv strong { color: var(--ink); }
  .links { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin: 1rem 0 0; }
  .links div { padding: 0.8rem 0.9rem; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  .links dt { font-weight: 600; }
  .links dd { margin: 0.2rem 0 0; color: var(--ink-soft); font-size: 0.86rem; line-height: 1.45; }
  .src { margin: 3rem 0 2rem; max-width: 52rem; }
</style>
