---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Comments from '../../../components/Comments.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { SITE, categoryLabel } from '../../../site.config';
import { getPosts, slugify } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, date, updated, category, tags, lang, aiAssisted } = post.data;
const url = new URL(`/library/read/${post.id}/`, Astro.site).href;
const schema = [
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    inLanguage: lang,
    author: { '@id': new URL('/#person', Astro.site).href },
    publisher: { '@id': new URL('/#person', Astro.site).href },
    mainEntityOfPage: url,
    image: new URL('/images/sparrows.webp', Astro.site).href,
    articleSection: categoryLabel(category),
    keywords: tags.join(', '),
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Library', item: new URL('/library/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: categoryLabel(category), item: new URL(`/library/${category}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={title} {description} image="/images/sparrows.webp" type="article" published={date} {updated} {schema}>
  <article class="wrap">
    <div class="prose" lang={lang}>
      <p class="small muted">
        <a href="/library/">Library</a> › <a href={`/library/${category}/`}>{categoryLabel(category)}</a> › Long read
      </p>
      <h1>{title}</h1>
      <p class="small muted">
        By <a href="/about/">{SITE.name}</a> · <FormattedDate date={date} />
        {updated && <span> · updated <FormattedDate date={updated} /></span>}
      </p>
      {aiAssisted && <p class="note small">Written by {SITE.name} with help from an AI assistant, and checked by me.</p>}
      <Content />
      {tags.length > 0 && <p>{tags.map((t) => <a class="chip" href={`/library/tag/${slugify(t)}/`}>{t}</a>)}</p>}
      <Comments />
    </div>
    <CtaBand />
  </article>
</Base>

<style>
  .note { border-left: 3px solid var(--gold); padding: 0.3rem 0.8rem; color: var(--ink-soft); background: color-mix(in srgb, var(--gold) 8%, transparent); border-radius: 0 8px 8px 0; }
</style>
