---
// One short page of a shelf (English). The page itself: src/components/explore/pages/ShelfSection.astro
// Long Sections are cut into several pages by tools/explore/build_explore.py: /library/<topic>/<section>/, then .../2/, .../3/
import ShelfSection from '../../../components/explore/pages/ShelfSection.astro';
import { shelfPagePaths } from '../../../explore';
export const getStaticPaths = shelfPagePaths;
---
<ShelfSection topic={Astro.params.topic!} url={(Astro.props as { url: string }).url} />
