---
// The Forest: the whole library on one page.
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import ProgressMeter from '../../components/ProgressMeter.astro';
import { SITE } from '../../site.config';
import { TREES, LEVELS, BUILD_STATUS } from '../../library.config';
import { getLibraryPages } from '../../lib';

const pages = await getLibraryPages();
const leafCount = (twig: string) => pages.filter((p) => p.id.startsWith(`${twig}/`) && p.data.kind === 'leaf').length;
const statusLabel = { live: 'Read now', next: 'Being written', planned: 'Planned' } as const;
const buildLabel = { live: 'Live', 'in-progress': 'In progress', planned: 'Not started' } as const;
const schema = [
  {
    '@type': 'CollectionPage',
    name: `${SITE.blogBrand} Library`,
    url: new URL('/library/', Astro.site).href,
    description: 'An open library for curious minds: short, question-led pages that start from zero.',
  },
];
---

<Base title="Library" description="An open library for curious minds. Short, question-led pages on the Universe, the Earth, AI and ideas, each readable in about two minutes." {schema}>
  <section class="wrap hero">
    <div>
      <p class="eyebrow">{SITE.blogBrand} Library</p>
      <h1>An open library for curious minds</h1>
      <p class="lede">Every page answers one real question in about two minutes, starting from zero. Follow a path from the first page, or jump straight to the question on your mind.</p>
      <form class="find" action="/search/" method="get" role="search">
        <label class="sr-only" for="lib-q">Ask the library</label>
        <input id="lib-q" name="q" type="search" placeholder="Ask anything, e.g. why is space dark?" autocomplete="off" />
        <button class="btn" type="submit">Search</button>
      </form>
    </div>
    <QuestionCard />
  </section>

  <section class="wrap block">
    <p class="eyebrow">How it is organised</p>
    <h2>A forest of questions</h2>
    <ol class="levels">
      {LEVELS.map((l) => (
        <li>
          <span class="icon" aria-hidden="true">{l.icon}</span>
          <strong>{l.name}</strong>
          <span>{l.means}</span>
          <span class="small muted">Like {l.like}. e.g. <em>{l.example}</em></span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap block">
    <p class="eyebrow">Explore</p>
    <h2>The trees</h2>
    <div class="trees">
      {TREES.map((tree) => (
        <article class="tree" id={tree.slug}>
          <h3>{tree.title}</h3>
          <p class="small muted">{tree.blurb}</p>
          {tree.branches.map((branch) => (
            <div class="branch">
              <p class="branch-name">🌿 {branch.title}</p>
              <ul>
                {branch.twigs.map((twig) => (
                  <li class:list={['twig', twig.status]}>
                    {twig.status === 'live' ? (
                      <a href={`/library/${twig.slug}/`}>
                        <strong>{twig.title}</strong>
                        <span class="small">{twig.question}</span>
                        <span class="small muted">{leafCount(twig.slug)} Leaves · {statusLabel[twig.status]} →</span>
                        <ProgressMeter twig={twig.slug} total={leafCount(twig.slug)} />
                      </a>
                    ) : (
                      <div>
                        <strong>{twig.title}</strong>
                        <span class="small">{twig.question}</span>
                        <span class="tag small">{statusLabel[twig.status]}, not written yet</span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </article>
      ))}
    </div>
  </section>

  <section class="wrap block">
    <p class="eyebrow">Honest status</p>
    <h2>What is growing</h2>
    <p class="muted narrow">The library is new. Here is exactly what works today and what is still being built, so you never click on a promise.</p>
    <ul class="build">
      {BUILD_STATUS.map((b) => (
        <li>
          <span class:list={['chip', b.status]}>{buildLabel[b.status]}</span>
          <strong>{b.name}</strong>
          <span class="small muted">{b.note}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { paintProgress } from '../../scripts/library-progress';
  paintProgress();
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 2.5rem; align-items: center; margin-top: 1rem; }
  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 36rem; }
  .find { display: flex; gap: 0.5rem; margin-top: 1.4rem; max-width: 34rem; }
  .find input { flex: 1; min-width: 0; padding: 0.7rem 1rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; }
  .find input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .block { margin-top: 4rem; }
  .levels { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.8rem; counter-reset: lv; }
  .levels li { position: relative; display: grid; gap: 0.2rem; padding: 1rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .levels li:not(:last-child)::after { content: '›'; position: absolute; right: -0.65rem; top: 50%; transform: translateY(-50%); color: var(--ink-soft); font-size: 1.2rem; }
  .levels .icon { font-size: 1.5rem; }
  .trees { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: 1rem; }
  .tree { --tree: #2f9a83; }
  .tree:nth-child(3n + 2) { --tree: #8f7be8; }
  .tree:nth-child(3n) { --tree: #c56b9c; }
  .tree { padding: 1.2rem; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--tree); scroll-margin-top: 80px; }
  .tree h3 { margin: 0 0 0.2rem; font-size: 1.3rem; }
  .tree > p { margin: 0 0 0.8rem; }
  .branch-name { margin: 0.6rem 0 0.4rem; font-weight: 600; font-size: 0.95rem; }
  .branch ul { list-style: none; padding: 0 0 0 0.8rem; margin: 0; border-left: 2px solid color-mix(in srgb, var(--tree) 40%, transparent); display: grid; gap: 0.5rem; }
  .twig > a, .twig > div { display: grid; gap: 0.2rem; padding: 0.7rem 0.8rem; border-radius: 12px; text-decoration: none; color: var(--ink); }
  .twig.live > a { background: color-mix(in srgb, var(--tree) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--tree) 35%, transparent); transition: transform 0.2s; }
  .twig.live > a:hover { transform: translateX(3px); color: var(--ink); }
  .twig:not(.live) > div { opacity: 0.75; border: 1px dashed var(--line); }
  .tag { justify-self: start; padding: 0.1rem 0.5rem; border-radius: 999px; background: var(--accent-soft); color: var(--ink-soft); }
  .build { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.6rem; max-width: 760px; }
  .build li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.1rem 0.8rem; align-items: baseline; padding: 0.8rem 1rem; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .build .chip { grid-row: span 2; justify-self: start; margin: 0; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .levels { grid-template-columns: 1fr; }
    .levels li:not(:last-child)::after { content: '↓'; right: 50%; top: auto; bottom: -0.95rem; transform: none; }
    .build li { grid-template-columns: 1fr; }
    .build .chip { grid-row: auto; }
  }
</style>
