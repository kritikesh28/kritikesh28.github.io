---
// All exam pages in one list: the page people land on when they search "RPSC RSSB important topics".
import ExamLayout from '../../../layouts/ExamLayout.astro';
import { EXAM_PAGES, SUBJECTS, BASE, GUIDE, STATS, examTitle, fmt } from '../../../exam-prep';

const groups = ['RPSC', 'RSSB'].map((ag) => ({
  ag,
  full: ag === 'RPSC' ? 'Rajasthan Public Service Commission' : 'Rajasthan Staff Selection Board',
  list: EXAM_PAGES.filter((e) => e.agency === ag && !e.langOnly).sort((a, b) => Number(b.key.endsWith('-ALL')) - Number(a.key.endsWith('-ALL')) || b.papers - a.papers || examTitle(a).localeCompare(examTitle(b))),
}));
const schema = [{
  '@type': 'ItemList', name: 'RPSC and RSSB exams: most asked topics',
  itemListElement: EXAM_PAGES.filter((e) => !e.langOnly).map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: examTitle(e), url: new URL(`${BASE}/exams/${e.slug}/`, Astro.site).href })),
}];
---

<ExamLayout
  title="RPSC and RSSB Exams: Most Asked Topics from Previous Year Papers"
  description={`Topic-wise previous year paper analysis for RPSC and RSSB exams: RAS, LDC, School Lecturer, CET, Patwari, VDO, Jail Prahari and more. ${fmt(STATS.questions)} questions mapped to topics. Free, no login.`}
  section="exams"
  {schema}
  crumbs={[{ href: `${BASE}/`, label: 'Exam Prep' }, { label: 'Exams' }]}
>
  <header>
    <p class="eyebrow">Exam by exam</p>
    <h1>Most asked topics, for every RPSC and RSSB exam</h1>
    <p class="lede">We read {STATS.papers} past papers and {STATS.syllabi} syllabi and matched {fmt(STATS.questions)} questions to topics. Pick your exam to see what was asked most, and how much each subject weighs.</p>
    <p class="hi" lang="hi">RPSC और RSSB परीक्षाओं के पिछले वर्षों के पेपरों का टॉपिक-वार विश्लेषण।</p>
  </header>

  {groups.map((g) => (
    <section>
      <h2>{g.ag} <span class="muted small">· {g.full}</span></h2>
      <ul class="ex">
        {g.list.map((e) => (
          <li>
            <a href={`${BASE}/exams/${e.slug}/`}>
              <strong>{examTitle(e)}</strong>
              <span>{e.papers ? `${e.papers} paper${e.papers > 1 ? 's' : ''} · ${e.years === 'all' ? 'combined' : e.years}` : 'Syllabus + related papers'}</span>
              <span class="top">Top: {e.top[0]?.t}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="small muted">SSC, UPSC, Railway, NTA and bank papers are not added yet. For those exams, the <a href={`${GUIDE}/`}>Exam Guide</a> shows the overall pattern across every paper we have.</p>
</ExamLayout>

<style>
  h1 { font-size: clamp(1.9rem, 4.2vw, 2.7rem); }
  .lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 42rem; margin: 0; }
  .hi { color: var(--ink-soft); }
  .ex { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .ex li { margin: 0; }
  .ex a { height: 100%; display: grid; gap: 0.2rem; align-content: start; padding: 0.9rem 1rem; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .ex a:hover { border-color: var(--tree); transform: translateY(-2px); }
  .ex strong { font: 600 1.08rem var(--font-serif); }
  .ex span { font-size: 0.84rem; color: var(--ink-soft); }
  .ex .top { color: var(--tree); }
</style>
