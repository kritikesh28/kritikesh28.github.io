---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PosterHero from '../components/PosterHero.astro';
import CuriosityOrbit from '../components/CuriosityOrbit.astro';
import LiveDemo from '../components/LiveDemo.astro';
import CtaBand from '../components/CtaBand.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { SITE } from '../site.config';
import { getPosts, getProjects } from '../lib';

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects()).slice(0, 3);
---

<Base type="profile">
  <PosterHero />

  {/* keep Google's search snippet on the intro above: the demo and card text below should not be quoted */}
  <div data-nosnippet>

  <section id="library" class="wrap section reveal">
    <div class="lib">
      <div>
        <p class="eyebrow">New · The Library</p>
        <h2>Learn something real in two minutes</h2>
        <p class="muted">Short, question-led pages that start from zero. The first course follows the Universe from its first second to the atoms in your body, in 12 small steps.</p>
        <p class="lib-links">
          <a class="btn" href="/library/the-universe/">Start The Universe →</a>
          <a class="btn ghost" href="/library/">Browse the library</a>
        </p>
      </div>
      <QuestionCard />
    </div>
  </section>

  <section id="explore" class="wrap section reveal">
    <div class="split">
      <div>
        <p class="eyebrow">Explore</p>
        <h2>Pick a thread</h2>
        <p class="muted">Six trees grow in one forest. Each subject is a tree in the library, and they all meet in the middle.</p>
        <p><a href="/library/">Open the library →</a></p>
      </div>
      <CuriosityOrbit />
    </div>
  </section>

  <section id="live" class="wrap section reveal">
    <p class="eyebrow">Live project</p>
    <h2>Where New York takes a taxi, hour by hour</h2>
    <LiveDemo />
  </section>

  <section class="wrap section reveal">
    <p class="eyebrow">Portfolio</p>
    <h2>Projects</h2>
    <div class="grid3">{projects.map((p) => <ProjectCard project={p} />)}</div>
    <p><a href="/portfolio/">All projects →</a></p>
  </section>

  <section class="wrap section reveal">
    <p class="eyebrow">{SITE.blogBrand} Library</p>
    <h2>Latest long reads</h2>
    {posts.length > 0
      ? <div class="grid3">{posts.map((post) => <PostCard post={post} />)}</div>
      : <p class="muted">The first posts are being written.</p>}
  </section>

  <div class="wrap"><CtaBand /></div>
  </div>
</Base>

<style>
  .section { margin-top: 4rem; }
  .split { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 2rem; align-items: center; }
  .lib { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  .lib-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .grid3 { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  @media (max-width: 860px) {
    .split, .lib { grid-template-columns: minmax(0, 1fr); }
  }
</style>
