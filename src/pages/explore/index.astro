---
// Explore: the hub of the 12 Encyclopedic Indexes, grouped on four shelves. Guide: docs/16-explore.md
import Base from '../../layouts/Base.astro';
import TopicCard from '../../components/explore/TopicCard.astro';
import { SHELVES, TOPICS, topicsIn } from '../../explore';
import '../../styles/explore.css';
import '../../styles/explore-topics.css';

const entries = TOPICS.reduce((a, t) => a + t.entries, 0);
const pages = TOPICS.reduce((a, t) => a + t.sections, 0);
const description = 'Explore 12 encyclopedic maps of human knowledge: movies, books, music, instruments, cooking, gardening, sports, technology, crochet, knitting, embroidery and sewing, compared across the world and India.';
const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Explore: the Encyclopedic Indexes',
    url: new URL('/explore/', Astro.site).href,
    description,
    inLanguage: 'en',
    hasPart: TOPICS.map((t) => ({ '@type': 'CreativeWork', name: `${t.short}: The Encyclopedic Index`, url: new URL(t.url, Astro.site).href })),
  },
];
// one starting question from each topic
const questions = TOPICS.map((t) => ({ t, q: t.leaves[0] })).filter((x) => x.q);
---

<Base title="Explore: 12 worlds, mapped" {description} {schema} langs={['en']}>
  <section class="x-wrap x-hub-hero">
    <p class="eyebrow">Curious Sparoows · The Encyclopedic Indexes</p>
    <h1>Twelve worlds, mapped.</h1>
    <p class="lede">Every corner of a subject, from the first question to the latest award, in short pages you can tick off as you go. Made for curious people everywhere, with India beside the world.</p>
    <ul class="x-stats">
      <li><b>12</b><span>subjects</span></li>
      <li><b>{pages}</b><span>pages</span></li>
      <li><b>{entries.toLocaleString('en-IN')}</b><span>entries</span></li>
    </ul>
  </section>

  {SHELVES.map((s) => (
    <section class="x-wrap x-shelf" id={s.id}>
      <div class="x-shelf-head"><h2>{s.title}</h2><p>{s.blurb}</p></div>
      <div class="x-grid">{topicsIn(s.id).map((t) => <TopicCard t={t} />)}</div>
    </section>
  ))}

  <section class="x-wrap x-shelf">
    <div class="x-shelf-head"><h2>Start with a question</h2><p>Each one takes about two minutes.</p></div>
    <ul class="x-questions">
      {questions.map(({ t, q }) => (
        <li class={`t-${t.slug}`}><a class="x-q" href={q.url}><small>{t.short}</small><span>{q.title}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="x-wrap x-shelf">
    <div class="x-shelf-head"><h2>How these maps are made</h2></div>
    <div class="x-read">
      <p>Each index follows one pattern: five short questions to begin, then the whole subject as a map of Parts and pages, registers of landmark works and awards, the history, the people, the big ideas, a practical guide and the sources. Every entry has an ID, like a page number, so the website and the printed booklet match line for line.</p>
      <p>Facts were checked against the sources named at the end of each index, and the latest winners were checked on the edition date. Where something could not be verified, the index says so. Spot a mistake? <a href="/contact/">Tell me</a>.</p>
    </div>
  </section>
</Base>
