---
// One page of an Encyclopedic Index: one Section (for example SEW-07), with contents, ticks and previous/next.
import Base from '../../../layouts/Base.astro';
import Contents from '../../../components/explore/Contents.astro';
import MediaBlock from '../../../components/explore/MediaBlock.astro';
import Progress from '../../../components/explore/Progress.astro';
import { TOPICS, getTopic, flatSections, sectionSlug, minutes, isLeaf } from '../../../explore';
import '../../../styles/explore.css';
import '../../../styles/explore-topics.css';

export function getStaticPaths() {
  return TOPICS.flatMap((ts) => {
    const t = getTopic(ts.slug);
    return flatSections(t).map((s) => ({ params: { topic: t.slug, section: sectionSlug(s) }, props: { id: s.id } }));
  });
}
const t = getTopic(Astro.params.topic!);
const all = flatSections(t);
const k = all.findIndex((s) => s.id === (Astro.props as { id: string }).id);
const s = all[k];
const prev = all[k - 1];
const next = all[k + 1];
const leaf = isLeaf(s.id);
const title = leaf ? s.title : `${s.title} (${t.short})`;
const description = (s.summary || `${s.title}: part of ${t.short}, The Encyclopedic Index by Curious Sparoows.`).slice(0, 300);
const schema = [
  {
    '@type': 'Article',
    headline: s.title,
    url: new URL(s.url, Astro.site).href,
    inLanguage: 'en',
    isPartOf: { '@type': 'Book', name: `${t.short}: The Encyclopedic Index`, url: new URL(t.url, Astro.site).href },
    author: { '@id': new URL('/#person', Astro.site).href },
    wordCount: s.words,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Explore', item: new URL('/explore/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.short, item: new URL(t.url, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: s.title, item: new URL(s.url, Astro.site).href },
    ],
  },
];
const ids = s.entries.map((e) => e.id);
---

<Base {title} {description} {schema} langs={['en']} type="article">
  <div class={`t-${t.slug}`}>
    <div class="x-wrap x-page">
      <Contents t={t} current={s.id} />
      <article>
        <header class="x-head">
          <p class="x-crumbs">
            <a href="/explore/">Explore</a><span aria-hidden="true">›</span>
            <a href={t.url}>{t.short}</a><span aria-hidden="true">›</span>
            <span>Part {s.part.num}: {s.part.title}</span>
          </p>
          <span class="x-idchip">{s.id}</span>
          <h1>{s.title}</h1>
          <p class="x-meta">{minutes(s.words)} min read{ids.length > 0 && <> · {ids.length} entries to tick</>} · <a href={t.url}>{t.short}: The Encyclopedic Index</a></p>
        </header>

        <div class="x-body">
          {k === all.findIndex((x) => x.part.num === s.part.num) && s.part.intro && <Fragment set:html={s.part.intro} />}
          <MediaBlock items={s.media.filter((_, i) => i === 0)} />
          <Fragment set:html={s.html} />
          <MediaBlock items={s.media.slice(1)} />
        </div>

        {ids.length > 2 && <Progress ids={ids} label="This page" />}

        <nav class="x-pager" aria-label="Previous and next">
          {prev ? <a href={prev.url}><small>← Previous · {prev.id}</small><span>{prev.title}</span></a> : <a href={t.url}><small>← Back to</small><span>{t.short}</span></a>}
          {next ? <a class="next" href={next.url}><small>Next · {next.id} →</small><span>{next.title}</span></a> : <a class="next" href="/explore/"><small>All subjects →</small><span>Explore</span></a>}
        </nav>
      </article>
    </div>

    <button class="x-toc-btn" type="button" data-open-toc>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      Contents
    </button>
    <dialog class="toc-sheet" aria-label="Contents">
      <div class="sheet-head"><strong>{t.short}</strong><button type="button" data-close-toc>Close</button></div>
      <Contents t={t} current={s.id} />
    </dialog>
  </div>
</Base>

<script>
  import '../../../scripts/explore';
</script>
