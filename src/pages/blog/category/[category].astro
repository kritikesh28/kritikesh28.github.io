---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { CATEGORIES } from '../../../site.config';
import { getPosts } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((c) => ({
    params: { category: c.slug },
    props: { cat: c, posts: posts.filter((p) => p.data.category === c.slug) },
  }));
}

const { cat, posts } = Astro.props;
---

<Base title={cat.label} description={cat.blurb}>
  <div class="wrap">
    <p class="small muted"><a href="/blog/">← Blog</a></p>
    <h1>{cat.label}</h1>
    <p class="muted">{cat.blurb}</p>
    {posts.length > 0
      ? <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
      : <p class="muted">No posts here yet.</p>}
  </div>
</Base>
