---
import Redirect from '../../../layouts/Redirect.astro';
import { getPosts, slugify } from '../../../lib';

export async function getStaticPaths() {
  const tags = new Set((await getPosts()).flatMap((p) => p.data.tags.map(slugify)));
  return [...tags].map((tag) => ({ params: { tag } }));
}
---

<Redirect to={`/library/tag/${Astro.params.tag}/`} />
