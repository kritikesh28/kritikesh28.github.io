---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, slugify } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  for (const p of posts) for (const t of p.data.tags) tags.set(slugify(t), t);
  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}

const { label, posts } = Astro.props;
---

<Base title={`Tag: ${label}`}>
  <div class="wrap">
    <p class="small muted"><a href="/blog/">← Blog</a></p>
    <h1>#{label}</h1>
    <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </div>
</Base>
