---
// The frame of the Portfolio pages: left, every shelf in three groups; middle, the page; right, a short "about me" and ways to follow.
// On phones the left bar becomes a row of chips and the right bar moves below. Shelves: src/portfolio.config.ts
import Base from './Base.astro';
import { PF_GROUPS, PF_SECTIONS, pfName, pfUrl } from '../portfolio.config';
import { getProjects } from '../lib';
import { SITE, SOCIALS, BRAND_SOCIALS } from '../site.config';
import { langFromUrl, localizePath, pick, type Lang } from '../i18n/config';

interface Props { title: string; description: string; current?: string; schema?: Record<string, unknown>[]; image?: string; translated?: Lang[] }
const { title, description, current, schema, image, translated } = Astro.props;
const lang = langFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const projects = await getProjects(lang);
const count = (slug: string) => projects.filter((p) => p.data.section === slug).length;
const T = pick({
  en: { all: 'All work', allSub: 'Everything in one place', shelves: 'Portfolio shelves', soon: 'soon', me: 'Kritikesh Rajpurohit', meText: 'Geographer, teacher and applied AI learner from Rawatbhata, Rajasthan. I build things in the open and write down what I learn.', story: 'Read my story →', follow: 'Follow along', followText: 'New work goes up here first. Say hello any time.', write: 'Write to me', resume: 'Résumé (PDF)', alt: 'Kritikesh Rajpurohit' },
  hi: { all: 'सारा काम', allSub: 'सब एक जगह', shelves: 'पोर्टफ़ोलियो के हिस्से', soon: 'जल्द', me: 'कृतिकेश राजपुरोहित', meText: 'रावतभाटा, राजस्थान से भूगोलवेत्ता, शिक्षक और अप्लाइड AI सीखने वाला। यहाँ का हर काम खुले में बना है, और हर सीख लिखकर रखी गई है।', story: 'मेरी कहानी पढ़िए →', follow: 'साथ जुड़िए', followText: 'नया काम सबसे पहले यहीं आता है। कभी भी नमस्ते कहिए।', write: 'मुझे लिखिए', resume: 'रिज़्यूमे (PDF)', alt: 'कृतिकेश राजपुरोहित' },
}, lang);
const links = [...BRAND_SOCIALS.filter((s) => s.href), ...SOCIALS];
---

<Base {title} {description} {schema} {image} {translated}>
  <div class="pf wrap">
    <aside class="pf-side" aria-label={T.shelves}>
      <a class="pf-home" href={L('/portfolio/')} aria-current={!current ? 'page' : undefined}>
        <span class="pf-mark" aria-hidden="true">✦</span><span><strong>{T.all}</strong><small>{T.allSub}</small></span>
      </a>
      {PF_GROUPS.map((g) => (
        <div class="pf-group">
          <p class="pf-gt">{lang === 'hi' ? g.hi : g.en}</p>
          <ul>
            {PF_SECTIONS.filter((s) => s.group === g.id).map((s) => {
              const n = count(s.slug);
              return (
                <li><a href={L(pfUrl(s))} aria-current={s.slug === current ? 'page' : undefined}>
                  <span class="pf-ic" aria-hidden="true">{s.icon}</span><span class="nm">{pfName(s, lang)}</span>
                  <span class:list={['ct', { soon: n === 0 }]}>{n === 0 ? T.soon : n}</span>
                </a></li>
              );
            })}
          </ul>
        </div>
      ))}
    </aside>

    <div class="pf-main"><slot /></div>

    <aside class="pf-rail">
      <div class="pf-box pf-me">
        <img src="/images/kritikesh.jpg" alt={T.alt} width="72" height="72" loading="lazy" />
        <h2>{T.me}</h2>
        <p>{T.meText}</p>
        <a href={L('/about/my-story/')}>{T.story}</a>
      </div>
      <div class="pf-box">
        <h2>{T.follow}</h2>
        <p>{T.followText}</p>
        <ul class="pf-links">
          {links.map((s) => <li><a href={s.href} target="_blank" rel="me noopener noreferrer">{s.label} ↗</a></li>)}
          <li><a href={L('/contact/')}>{T.write} →</a></li>
          <li><a href={SITE.resumePdf}>{T.resume}</a></li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .pf { display: grid; grid-template-columns: 240px minmax(0, 1fr) 250px; gap: 2.4rem; padding-block: 2rem 1rem; align-items: start; }
  .pf-side, .pf-rail { position: sticky; top: 84px; display: grid; gap: 1rem; font-size: 0.92rem; }
  .pf-home { display: flex; gap: 0.7rem; align-items: center; padding: 0.7rem 0.8rem; border-radius: 14px; text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); }
  .pf-home small { display: block; color: var(--ink-soft); font-size: 0.78rem; }
  .pf-home[aria-current='page'] { border-color: var(--accent); background: var(--accent-soft); }
  .pf-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--gold), var(--coral)); color: #fff; }
  .pf-gt { margin: 0 0 0.3rem; padding-left: 0.4rem; font: 700 0.7rem/1 var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .pf-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .pf-group a { display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.6rem; border-radius: 10px; color: var(--ink-soft); text-decoration: none; line-height: 1.3; }
  .pf-group a:hover { background: var(--accent-soft); color: var(--ink); }
  .pf-group a[aria-current='page'] { background: var(--accent-soft); color: var(--ink); font-weight: 600; }
  .pf-ic { flex: none; width: 1.6em; text-align: center; color: var(--accent); font-size: 0.85rem; font-weight: 700; }
  .nm { flex: 1; }
  .ct { font-size: 0.72rem; font-variant-numeric: tabular-nums; padding: 0.05rem 0.45rem; border-radius: 99px; background: var(--accent-soft); color: var(--ink); }
  .ct.soon { background: none; border: 1px dashed var(--line); color: var(--ink-soft); font-style: italic; }
  .pf-box { padding: 1rem 1.1rem; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
  .pf-box h2 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .pf-box p { margin: 0 0 0.6rem; color: var(--ink-soft); line-height: 1.5; font-size: 0.88rem; }
  .pf-me img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; margin-bottom: 0.5rem; box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px color-mix(in srgb, var(--gold) 60%, transparent); }
  .pf-me > a { font-weight: 600; text-decoration: none; }
  .pf-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .pf-links a { text-decoration: none; }
  @media (max-width: 1180px) { .pf { grid-template-columns: 220px minmax(0, 1fr); } .pf-rail { grid-column: 2; position: static; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); } }
  @media (max-width: 820px) {
    .pf { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; padding-top: 1rem; }
    .pf-side { position: static; display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.3rem; scrollbar-width: thin; }
    .pf-home { flex: none; padding: 0.4rem 0.7rem; }
    .pf-home small, .pf-mark, .pf-gt { display: none; }
    .pf-group ul { display: flex; gap: 0.4rem; }
    .pf-group a { white-space: nowrap; border: 1px solid var(--line); border-radius: 99px; padding: 0.35rem 0.75rem; }
    .pf-rail { grid-column: 1; }
  }
</style>
