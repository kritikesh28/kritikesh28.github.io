---
// A page that has moved. Sends the visitor (and search engines) to the new address.
interface Props { to: string; title?: string }
const { to, title = 'This page has moved' } = Astro.props;
const href = new URL(to, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={href} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>The blog is now part of the library. This page has moved to <a href={to}>{href}</a>.</p>
  </body>
</html>
