---
// The frame of every /exam-prep/ page: the site header and footer (Base), a left sidebar with
// both tools (Curriculum Index, Exam Guide) and the page itself. On phones the sidebar opens as a drawer.
// Guide: docs/14-exam-prep.md
import Base from './Base.astro';
import { SUBJECTS, GLYPH, BASE, CI, GUIDE, fmt } from '../exam-prep';

interface Props {
  title: string;
  description: string;
  section: 'home' | 'ci' | 'guide' | 'how' | 'exams';
  subject?: string; // slug of the subject being read
  major?: string; // slug of the major topic being read
  crumbs?: { href?: string; label: string }[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, section, subject, major, crumbs = [], schema, noindex } = Astro.props;
const current = SUBJECTS.find((s) => s.slug === subject);
// Breadcrumbs for search engines, built from the visible crumbs
const crumbSchema = crumbs.length
  ? [{
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.label,
        ...(c.href ? { item: new URL(c.href, Astro.site).href } : { item: new URL(Astro.url.pathname, Astro.site).href }),
      })),
    }]
  : [];
const allSchema = [...crumbSchema, ...(schema ?? [])];
---

<Base {title} {description} {noindex} schema={allSchema} langs={['en']}>
  <div class="ex wrap t-exam-prep">
    <button class="ex-menu" type="button" aria-expanded="false" aria-controls="ex-side" data-ex-menu>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <span>Exam Prep menu</span>
      {current && <span class="ex-menu-where">· {current.name}</span>}
    </button>
    <div class="ex-scrim" data-ex-scrim hidden></div>

    <aside class="ex-side" id="ex-side" aria-label="Exam Prep sections">
      <a class="side-home" href={`${BASE}/`} aria-current={section === 'home' ? 'page' : undefined}>
        <span class="side-mark" aria-hidden="true">✦</span>
        <span><strong>Exam Prep</strong><small>Start here</small></span>
      </a>

      <div class="side-group">
        <a class="side-title" href={`${CI}/`} aria-current={section === 'ci' && !subject ? 'page' : undefined}>
          <span class="num" aria-hidden="true">1</span> Exhaustive Curriculum Index
        </a>
        <ul class="side-subjects">
          {SUBJECTS.map((s) => (
            <li class:list={[{ open: s.slug === subject }]}>
              <a href={`${CI}/${s.slug}/`} aria-current={s.slug === subject && !major ? 'page' : undefined} class:list={[{ here: s.slug === subject }]}>
                <span class="g" aria-hidden="true">{GLYPH[s.slug]}</span>
                <span class="nm">{s.name}</span>
                <span class="ct">{fmt(s.total)}</span>
              </a>
              {s.slug === subject && (
                <div class="side-majors">
                  <label class="sr-only" for="side-filter">Filter the topics of {s.name}</label>
                  <input id="side-filter" type="search" placeholder={`Filter ${s.majors.length} major topics…`} autocomplete="off" data-side-filter />
                  <ol data-side-list>
                    {s.majors.map((m, i) => (
                      <li>
                        <a href={`${CI}/${s.slug}/${m.slug}/`} aria-current={m.slug === major ? 'page' : undefined} data-t={m.t.toLowerCase()}>
                          <span class="i">{i + 1}</span>{m.t}
                        </a>
                      </li>
                    ))}
                  </ol>
                  <p class="side-none small muted" data-side-none hidden>No major topic has that word. Try the full search above the topics.</p>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="side-group">
        <a class="side-title" href={`${GUIDE}/`} aria-current={section === 'guide' ? 'page' : undefined}>
          <span class="num" aria-hidden="true">2</span> Exam Guide
        </a>
        <ul class="side-links">
          <li><a href={`${GUIDE}/`} aria-current={section === 'guide' ? 'page' : undefined}>Find my topics</a></li>
          <li><a href={`${BASE}/exams/`} aria-current={section === 'exams' ? 'page' : undefined}>Most asked topics, exam by exam</a></li>
          <li><a href={`${GUIDE}/how-it-works/`} aria-current={section === 'how' ? 'page' : undefined}>How the ranking works</a></li>
          <li><a href={`${GUIDE}/how-it-works/#papers`}>Papers analysed</a></li>
        </ul>
      </div>

      <p class="side-note">View only. Nothing you type or pick here is saved, sent or tracked.</p>
    </aside>

    <div class="ex-main">
      {crumbs.length > 0 && (
        <nav class="ex-crumbs small" aria-label="Where you are">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">›</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <slot />
    </div>
  </div>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-ex-menu]');
  const side = document.getElementById('ex-side');
  const scrim = document.querySelector<HTMLElement>('[data-ex-scrim]');
  const setOpen = (open: boolean) => {
    if (!btn || !side || !scrim) return;
    btn.setAttribute('aria-expanded', String(open));
    side.classList.toggle('open', open);
    scrim.hidden = !open;
    document.body.classList.toggle('ex-lock', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  scrim?.addEventListener('click', () => setOpen(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Keep the current topic visible inside the sidebar
  side?.querySelector('.side-majors [aria-current="page"]')?.scrollIntoView({ block: 'center' });

  // Filter the major topics of this subject
  const input = document.querySelector<HTMLInputElement>('[data-side-filter]');
  const none = document.querySelector<HTMLElement>('[data-side-none]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLAnchorElement>('[data-side-list] a').forEach((a) => {
      const ok = !q || (a.dataset.t ?? '').includes(q);
      a.parentElement!.hidden = !ok;
      if (ok) shown++;
    });
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .ex { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 2.4rem; align-items: start; max-width: 1240px; }
  .ex-menu, .ex-scrim { display: none; }
  .ex-side {
    position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow-y: auto; overscroll-behavior: contain;
    padding: 1rem 0.9rem 1.2rem; border: 1px solid var(--line); border-radius: 18px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tree) 7%, var(--surface)), var(--surface) 160px);
    font-size: 0.93rem; scrollbar-width: thin;
  }
  .side-home { display: flex; gap: 0.7rem; align-items: center; padding: 0.55rem 0.6rem; border-radius: 12px; text-decoration: none; color: var(--ink); }
  .side-home strong { display: block; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.1; }
  .side-home small { color: var(--ink-soft); font-size: 0.8rem; }
  .side-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--tree); color: #fff; font-size: 1rem; flex: none; }
  .side-home:hover, .side-home[aria-current='page'] { background: color-mix(in srgb, var(--tree) 12%, transparent); }
  .side-group { margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .side-title {
    display: flex; align-items: center; gap: 0.55rem; padding: 0.3rem 0.6rem; border-radius: 10px;
    font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); text-decoration: none;
  }
  .side-title:hover, .side-title[aria-current='page'] { color: var(--ink); background: color-mix(in srgb, var(--tree) 10%, transparent); }
  .num { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--tree); color: var(--tree); font-size: 0.7rem; letter-spacing: 0; }
  ul, ol { list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .side-subjects > li > a, .side-links a {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.38rem 0.6rem; border-radius: 10px; color: var(--ink); text-decoration: none; line-height: 1.3;
  }
  .side-subjects .g { width: 1.5rem; text-align: center; font-size: 0.95rem; flex: none; }
  .side-subjects .nm { flex: 1; }
  .side-subjects .ct { font-size: 0.72rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .side-subjects > li > a:hover, .side-links a:hover { background: var(--accent-soft); }
  .side-subjects > li > a.here { background: color-mix(in srgb, var(--tree) 16%, transparent); font-weight: 600; }
  .side-links a { padding-left: 2.7rem; }
  .side-links a[aria-current='page'] { background: color-mix(in srgb, var(--tree) 16%, transparent); font-weight: 600; }
  .side-majors { margin: 0.3rem 0 0.6rem 1.2rem; padding-left: 0.7rem; border-left: 2px solid color-mix(in srgb, var(--tree) 40%, transparent); }
  .side-majors input {
    width: 100%; margin: 0.3rem 0 0.4rem; padding: 0.4rem 0.6rem; border: 1px solid var(--line); border-radius: 8px;
    background: var(--bg); color: var(--ink); font: inherit; font-size: 0.85rem;
  }
  .side-majors a { display: flex; gap: 0.45rem; padding: 0.28rem 0.4rem; border-radius: 8px; color: var(--ink-soft); text-decoration: none; font-size: 0.85rem; line-height: 1.35; }
  .side-majors a:hover { color: var(--ink); background: var(--accent-soft); }
  .side-majors a[aria-current='page'] { color: var(--ink); background: color-mix(in srgb, var(--tree) 18%, transparent); font-weight: 600; }
  .side-majors .i { min-width: 1.4rem; color: var(--tree); font-variant-numeric: tabular-nums; font-size: 0.78rem; padding-top: 0.08rem; }
  .side-note { margin: 1.1rem 0.4rem 0; padding: 0.6rem 0.7rem; border-radius: 10px; background: var(--accent-soft); color: var(--ink-soft); font-size: 0.78rem; line-height: 1.45; }
  .ex-crumbs { display: flex; flex-wrap: wrap; gap: 0.45rem; color: var(--ink-soft); margin-bottom: 1rem; }
  .ex-crumbs a { color: var(--ink-soft); }
  .ex-main { min-width: 0; }

  @media (max-width: 960px) {
    .ex { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ex-menu {
      display: inline-flex; align-items: center; gap: 0.5rem; justify-self: start; margin-bottom: 1rem;
      position: sticky; top: 76px; z-index: 20; padding: 0.5rem 0.9rem; border-radius: 999px; border: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(8px); color: var(--ink); font: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer;
      box-shadow: 0 6px 18px rgb(42 35 80 / 0.08);
    }
    .ex-menu svg { width: 18px; height: 18px; }
    .ex-menu-where { font-weight: 400; color: var(--ink-soft); }
    .ex-side {
      position: fixed; top: 0; bottom: 0; left: 0; z-index: 70; width: min(86vw, 330px); max-height: none; border-radius: 0 18px 18px 0;
      transform: translateX(-105%); transition: transform 0.3s ease; box-shadow: 0 20px 60px rgb(0 0 0 / 0.25); background: var(--surface);
    }
    .ex-side.open { transform: none; }
    .ex-scrim { display: block; position: fixed; inset: 0; z-index: 65; background: rgb(18 15 36 / 0.45); }
    .ex-scrim[hidden] { display: none; }
    :global(body.ex-lock) { overflow: hidden; }
    /* without JavaScript the menu simply sits above the page */
    :global(html:not(.js)) .ex-side { position: static; transform: none; width: auto; border-radius: 18px; box-shadow: none; margin-bottom: 1.5rem; }
    :global(html:not(.js)) .ex-menu { display: none; }
  }
  @media (max-width: 720px) { .ex-menu { top: 134px; } }
  @media print { .ex-side, .ex-menu { display: none; } .ex { display: block; } }
</style>
