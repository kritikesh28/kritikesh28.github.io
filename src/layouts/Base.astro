---
import LogoMark from '../components/LogoMark.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '../styles/global.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
// Hindi fonts: each file only downloads when a page shows Devanagari letters
import '@fontsource-variable/noto-sans-devanagari';
import '@fontsource-variable/noto-serif-devanagari';
import '@fontsource/tiro-devanagari-hindi/devanagari-400.css';
import '@fontsource/tiro-devanagari-hindi/devanagari-400-italic.css';
import { SITE, NAV, SOCIALS } from '../site.config';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Wordmark from '../components/Wordmark.astro';
import SparrowSeal from '../components/SparrowSeal.astro';
import { LANGS, LOCALES, DEFAULT_LANG, langFromUrl, localizePath, stripLang, type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: SeoProps['type'];
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Languages this page has an address in (default: all). Exam Prep is English-only for now. */
  langs?: Lang[];
  /** Languages this page is really written in (default: same as langs). The others show English with a note. */
  translated?: Lang[];
}

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const {
  title,
  description = t('site.description'),
  image = '/images/banner-cosmic.webp',
  type,
  published,
  updated,
  noindex,
  schema,
  langs = LANGS,
  translated = langs,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.blogBrand}` : SITE.blogBrand;
const path = Astro.url.pathname;
const bare = stripLang(path);
const L = (href: string) => localizePath(href, lang);
const isActive = (href: string) => (href === '/' ? bare === '/' : bare.startsWith(href));
// this page in every language (or that language's home page, when the page does not exist there yet)
const switcher = LANGS.map((l) => ({ lang: l, ...LOCALES[l], href: langs.includes(l) ? localizePath(bare, l) : localizePath('/', l), exists: langs.includes(l) }));
const alternates = translated.filter((l) => langs.includes(l)).map((l) => ({ hreflang: LOCALES[l].hreflang, href: localizePath(bare, l) }));
const fallback = !translated.includes(lang);
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1d1636" />
    <script is:inline src="/theme-init.js"></script>
    <Seo title={pageTitle} {description} {image} {type} {published} {updated} noindex={noindex || fallback} {schema} {lang} {alternates} defaultHref={alternates.length > 1 ? localizePath(bare, DEFAULT_LANG) : undefined} />
    {/* returns visitors to the language they chose last time; needs the alternate links above */}
    <script is:inline src="/lang-init.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.blogBrand} Library`} href="/rss.xml" />
  </head>
  <body id="top">
    <div class="progress" aria-hidden="true"></div>
    <a class="skip" href="#main">{t('header.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={L('/')}>
          <LogoMark height={40} />
          <span class="sr-only">{SITE.blogBrand}</span>
          {/* the double o is drawn as one infinity sign, in the text colour */}
          <span class="brand-name" aria-hidden="true">Curious Spar<svg class="oo" viewBox="0 0 100 40"><path d="M96.0 20.0 L95.5 24.6 L94.0 28.8 L91.6 32.4 L88.7 35.2 L85.4 37.2 L81.9 38.3 L78.4 38.7 L74.9 38.4 L71.7 37.6 L68.6 36.4 L65.8 34.9 L63.1 33.1 L60.7 31.1 L58.4 29.0 L56.2 26.8 L54.1 24.6 L52.0 22.3 L50.0 20.0 L48.0 17.7 L45.9 15.4 L43.8 13.2 L41.6 11.0 L39.3 8.9 L36.9 6.9 L34.2 5.1 L31.4 3.6 L28.3 2.4 L25.1 1.6 L21.6 1.3 L18.1 1.7 L14.6 2.8 L11.3 4.8 L8.4 7.6 L6.0 11.2 L4.5 15.4 L4.0 20.0 L4.5 24.6 L6.0 28.8 L8.4 32.4 L11.3 35.2 L14.6 37.2 L18.1 38.3 L21.6 38.7 L25.1 38.4 L28.3 37.6 L31.4 36.4 L34.2 34.9 L36.9 33.1 L39.3 31.1 L41.6 29.0 L43.8 26.8 L45.9 24.6 L48.0 22.3 L50.0 20.0 L52.0 17.7 L54.1 15.4 L56.2 13.2 L58.4 11.0 L60.7 8.9 L63.1 6.9 L65.8 5.1 L68.6 3.6 L71.7 2.4 L74.9 1.6 L78.4 1.3 L81.9 1.7 L85.4 2.8 L88.7 4.8 L91.6 7.6 L94.0 11.2 L95.5 15.4 L96.0 20.0Z" /></svg>ws</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.href === '/exam-prep/' ? item.href : L(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{t(item.key)}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="langs" aria-label={t('header.lang')}>
          {switcher.map((s) => (
            <a href={s.href} hreflang={s.htmlLang} lang={s.htmlLang} data-lang={s.lang} aria-current={s.lang === lang ? 'true' : undefined} title={s.exists ? s.name : useT(s.lang)('header.langMissing', { lang: s.name })}>{s.label}</a>
          ))}
        </nav>
        <a class="theme" href={L('/search/')} aria-label={t('header.search')} title={t('header.searchTitle')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </a>
        <button class="theme" type="button" aria-label={t('header.theme')} title={t('header.themeTitle')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor" /></svg>
        </button>
      </div>
    </header>

    <main id="main">
      {fallback && <p class="wrap lang-note" role="note">{t('notice.fallback', { lang: LOCALES[lang].name })}</p>}
      <slot />
    </main>

    {/* brand signature: a faint two-sparrows watermark behind every page, and the living seal in the corner */}
    <div class="sig-wm" aria-hidden="true"><LogoMark height={400} /></div>
    <SparrowSeal />

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a class="foot-logo" href={L('/')} aria-label={`${SITE.blogBrand}, ${t('footer.home')}`}>
            <LogoMark height={34} />
            <Wordmark />
          </a>
          <p class="foot-motto">{t('site.motto')}</p>
          <a class="foot-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <nav class="foot-cols" aria-label="Footer">
          <div>
            <h2>{t('footer.explore')}</h2>
            <ul>
              {NAV.filter((n) => n.href !== '/').map((n) => <li><a href={n.href === '/exam-prep/' ? n.href : L(n.href)}>{t(n.key)}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>{t('footer.begin')}</h2>
            <ul>
              <li><a href={L('/start/')}>{t('footer.start')}</a></li>
              <li><a href={L('/library/the-universe/')}>{t('footer.universe')}</a></li>
              <li><a href={L('/search/')}>{t('footer.search')}</a></li>
              <li><a href={L('/now/')}>{t('footer.now')}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t('footer.connect')}</h2>
            <ul>
              {SOCIALS.map((s) => <li><a href={s.href} rel="me noopener noreferrer" target="_blank">{s.label}<span class="ext" aria-hidden="true">↗</span></a></li>)}
            </ul>
          </div>
        </nav>
      </div>
      <div class="wrap foot-base">
        <p>© {new Date().getFullYear()} {t('site.name')}</p>
        <p><a href={L('/privacy/')}>{t('footer.privacy')}</a><a href="#top" class="top">{t('footer.top')} <span aria-hidden="true">↑</span></a></p>
      </div>
    </footer>


    {SITE.goatcounterCode && (
      <script
        is:inline
        async
        data-goatcounter={`https://${SITE.goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>

<script>
  const root = document.documentElement;

  // Light / dark toggle
  document.querySelector('button.theme')?.addEventListener('click', () => {
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });


  // Language switcher: remember the choice, so the next visit opens in the same language (public/lang-init.js)
  document.querySelectorAll<HTMLAnchorElement>('.langs a[data-lang]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang!); } catch {} }),
  );

  // Reading progress bar
  const bar = document.querySelector<HTMLElement>('.progress');
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Gentle reveal as sections scroll into view
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Soft 3D tilt on cards (mouse only)
  if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      card.addEventListener('pointermove', (ev) => {
        const r = card.getBoundingClientRect();
        const x = (ev.clientX - r.left) / r.width - 0.5;
        const y = (ev.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(700px) rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg) translateY(-3px)`;
        card.style.setProperty('--mx', `${(x + 0.5) * 100}%`);
        card.style.setProperty('--my', `${(y + 0.5) * 100}%`);
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  }
</script>

<style>
  .progress {
    position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 50; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, #8f7be8, var(--coral), var(--gold));
  }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 0.4rem 0.8rem; z-index: 60; }
  .site-header {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 64px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; font-family: var(--font-serif); font-weight: 600; font-size: 1.1rem; }
  .brand-name { font-size: 1.45rem; font-weight: 600; letter-spacing: 0.01em; line-height: 1; color: #3b2a1e; }
  .brand-name .oo { display: inline-block; width: 1.02em; height: 0.43em; margin: 0 0.02em; vertical-align: 0; overflow: visible; }
  .brand-name .oo path { fill: none; stroke: currentColor; stroke-width: 9; stroke-linejoin: round; }
  :global([data-theme="dark"]) .brand-name { color: #d9bb7a; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .brand-name { color: #d9bb7a; } }
  .brand :global(.logo-mark) { flex: none; color: #3b2a1e; transition: transform 0.4s; }
  :global([data-theme="dark"]) .brand :global(.logo-mark) { color: #d9bb7a; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .brand :global(.logo-mark) { color: #d9bb7a; } }
  .brand:hover :global(.logo-mark) { transform: scale(1.06); }
  nav { margin-left: auto; }
  .site-header nav ul { list-style: none; display: flex; gap: 0.2rem; margin: 0; padding: 0; flex-wrap: wrap; }
  .site-header nav a { white-space: nowrap; display: block; padding: 0.35rem 0.75rem; border-radius: 999px; color: var(--ink-soft); text-decoration: none; font-size: 0.95rem; transition: background 0.2s, color 0.2s; }
  .site-header nav a:hover { color: var(--ink); background: var(--accent-soft); }
  .site-header nav a[aria-current='page'] { color: var(--ink); background: var(--accent-soft); font-weight: 600; }
  /* the EN / हिंदी switch */
  .site-header .langs { margin-left: 0; display: flex; flex: none; border: 1px solid var(--line); border-radius: 999px; padding: 2px; gap: 2px; }
  .site-header .langs a { display: block; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.85rem; line-height: 1.45; color: var(--ink-soft); text-decoration: none; transition: background 0.2s, color 0.2s; }
  .site-header .langs a:hover { color: var(--ink); background: var(--accent-soft); }
  .site-header .langs a[aria-current] { background: var(--accent); color: var(--on-accent); font-weight: 600; }
  .lang-note { margin-top: 1rem; font-size: 0.9rem; color: var(--ink-soft); }
  .lang-note::before { content: 'ⓘ '; }
  .theme { display: grid; place-items: center; background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; width: 36px; height: 36px; cursor: pointer; transition: transform 0.4s; }
  .theme:hover { transform: rotate(-25deg); }
  .theme svg { width: 18px; height: 18px; }
  @media (max-width: 720px) {
    .bar { padding-top: 0.5rem; padding-bottom: 0.5rem; gap: 0.5rem; }
    nav { order: 3; width: 100%; margin-left: 0; }
    .site-header nav ul { gap: 0; overflow-x: auto; flex-wrap: nowrap; }
    a.theme { margin-left: auto; }
    /* second row: the menu scrolls sideways, the language switch stays visible at its end */
    .site-header nav[aria-label='Main'] { flex: 1 1 60%; width: auto; min-width: 0; }
    .site-header .langs { order: 4; width: auto; }
  }
  .sig-wm {
    position: fixed; right: -9vw; bottom: -6vh; z-index: -1; width: min(58vw, 760px); pointer-events: none;
    color: #3b2a1e; opacity: 0.045;
  }
  .sig-wm :global(svg) { display: block; width: 100%; height: auto; }
  :global([data-theme="dark"]) .sig-wm { color: #d9bb7a; opacity: 0.05; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .sig-wm { color: #d9bb7a; opacity: 0.05; } }
  @media (max-width: 760px) { .sig-wm { width: 92vw; right: -18vw; bottom: -4vh; opacity: 0.035; } }
  @media print { .sig-wm { display: none; } }
  /* footer: the poster's night sky, quiet type, three short columns */
  .site-footer {
    margin-top: 4rem; color: rgb(246 231 200 / 0.72);
    background: radial-gradient(120% 140% at 85% 0%, #2a1f4d 0%, #17132e 55%, #120f24 100%);
    border-top: 1px solid rgb(242 215 166 / 0.16);
  }
  .foot { display: grid; grid-template-columns: minmax(16rem, 1.2fr) 2fr; gap: 3rem; padding-block: 3.6rem 2.6rem; }
  .foot-logo { display: inline-flex; align-items: center; gap: 0.6rem; color: #f2d7a6; text-decoration: none; font-size: 1.45rem; }
  .foot-logo :global(.logo-mark) { color: #f2d7a6; }
  .foot-motto { margin: 1rem 0 1.1rem; max-width: 22rem; font: italic 500 1.2rem/1.45 var(--font-display); color: rgb(246 231 200 / 0.85); }
  .foot-mail { color: #f2d7a6; font-size: 0.92rem; text-decoration: none; border-bottom: 1px solid rgb(242 215 166 / 0.35); padding-bottom: 1px; }
  .foot-mail:hover { border-color: #f2d7a6; }
  .foot-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .foot-cols h2 { margin: 0 0 1rem; font: 600 0.72rem/1 var(--font-sans, Inter, sans-serif); letter-spacing: 0.22em; text-transform: uppercase; color: #e8c584; }
  .foot-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .foot-cols li { margin: 0; padding: 0; }
  .foot-cols a, .foot-base a { color: rgb(246 231 200 / 0.72); text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
  .foot-cols a:hover, .foot-base a:hover, .foot-cols a:focus-visible, .foot-base a:focus-visible { color: #fff3dc; }
  .ext { font-size: 0.75em; margin-left: 0.3em; opacity: 0.6; }
  .foot-base {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center;
    border-top: 1px solid rgb(242 215 166 / 0.12); padding-block: 1.3rem 1.6rem; font-size: 0.85rem; color: rgb(246 231 200 / 0.55);
  }
  .foot-base p { margin: 0; display: flex; gap: 1.6rem; }
  .foot-base a { font-size: 0.85rem; }
  @media (max-width: 760px) {
    .foot { grid-template-columns: 1fr; gap: 2.4rem; padding-block-start: 2.8rem; }
    .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
