---
// "Curious Sparoows" with the two o's drawn as linked rings, so the spelling reads as intentional.
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<span class:list={['wordmark', cls]} aria-label="Curious Sparoows" role="img">
  <span aria-hidden="true">Curious Spar</span><svg aria-hidden="true" viewBox="0 0 100 64" class="oo">
    <circle cx="28" cy="32" r="23" fill="none" stroke="currentColor" stroke-width="10" />
    <circle cx="72" cy="32" r="23" fill="none" stroke="var(--coral)" stroke-width="10" />
    <circle cx="35" cy="22" r="3.8" fill="var(--coral)" />
    <circle cx="65" cy="22" r="3.8" fill="currentColor" />
  </svg><span aria-hidden="true">ws</span>
</span>

<style>
  .wordmark { font-family: var(--font-serif); font-weight: 600; white-space: nowrap; display: inline-flex; align-items: baseline; }
  .oo { height: 0.6em; width: 0.94em; align-self: baseline; transform: translateY(0.01em); margin: 0 0.03em; overflow: visible; }
  .oo { transform-box: fill-box; transform-origin: center; transition: transform 0.2s; }
  .wordmark:hover .oo, a:hover > .wordmark .oo { animation: roll 1.1s ease-in-out; }
  @keyframes roll { to { transform: translateY(0.01em) rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .wordmark:hover .oo { animation: none; } }
</style>
