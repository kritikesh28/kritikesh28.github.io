---
// A live demo served from this site (public/demos/<which>/), framed like a small app window.
// 'nyc-taxi': the NYC taxi demand explorer. 'predictive-maintenance': the machine failure predictor.
import { langFromUrl } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { height?: number; which?: 'nyc-taxi' | 'predictive-maintenance' }
const { which = 'nyc-taxi' } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const DEMOS = {
  'nyc-taxi': {
    src: '/demos/nyc-taxi/', height: 760, prefix: 'demo',
    links: [
      { key: 'demo.hf', href: 'https://huggingface.co/spaces/kritikesh28/nyc-taxi-demand-explorer' },
      { key: 'demo.code', href: 'https://github.com/kritikesh28/nyc-taxi-2023-eda' },
    ],
  },
  'predictive-maintenance': {
    src: `/demos/predictive-maintenance/${lang === 'hi' ? '?lang=hi' : ''}`, height: 1500, prefix: 'demoPm',
    links: [
      { key: 'demoPm.space', href: 'https://huggingface.co/spaces/kritikesh28/machine-failure-predictor' },
      { key: 'demoPm.model', href: 'https://huggingface.co/kritikesh28/predictive-maintenance-xgboost' },
    ],
  },
} as const;
const d = DEMOS[which];
const height = Astro.props.height ?? d.height;
---

<figure class="demo">
  <div class="frame">
    <div class="chrome" aria-hidden="true"><span></span><span></span><span></span><em>{t(`${d.prefix}.chrome`)}</em></div>
    <iframe
      src={d.src}
      title={t(`${d.prefix}.title`)}
      loading="lazy"
      height={height}
      data-autosize={which === 'predictive-maintenance' ? '' : undefined}
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <figcaption>
    <span class="muted small">{t(`${d.prefix}.caption`)}</span>
    {d.links.length > 0 && (
      <span class="links">
        {d.links.map((l) => <a class="btn ghost" href={l.href} target="_blank" rel="noopener noreferrer">{t(l.key as any)}</a>)}
      </span>
    )}
  </figcaption>
</figure>

<script>
  // Same-origin demos grow to fit their content, so there is no inner scrollbar
  for (const f of document.querySelectorAll<HTMLIFrameElement>('iframe[data-autosize]')) {
    const fit = () => {
      const doc = f.contentDocument;
      if (doc?.body) f.style.height = doc.documentElement.scrollHeight + 'px';
    };
    f.addEventListener('load', () => {
      fit();
      const doc = f.contentDocument;
      if (doc && 'ResizeObserver' in window) new ResizeObserver(fit).observe(doc.body);
    });
  }
</script>

<style>
  .demo { margin: 0; }
  .frame { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); box-shadow: 0 18px 50px rgb(42 35 80 / 0.14); }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--accent-soft); }
  .chrome span { width: 10px; height: 10px; border-radius: 50%; background: #f0906f; }
  .chrome span:nth-child(2) { background: #e0b45e; }
  .chrome span:nth-child(3) { background: #6cc9b0; }
  .chrome em { font-style: normal; font-size: 0.8rem; color: var(--ink-soft); margin-left: 8px; }
  iframe { display: block; width: 100%; border: 0; background: #fff; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.8rem 1.5rem; align-items: center; justify-content: space-between; margin-top: 0.9rem; }
  .links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  @media (max-width: 600px) { iframe:not([data-autosize]) { height: 980px; } }
</style>
