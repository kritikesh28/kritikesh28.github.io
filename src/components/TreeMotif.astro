      <path d="M30 176c26-6 48 2 74-4" />
      <g transform="translate(93 52) scale(0.9)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
  )}
  {tree === 'ai-ml' && (
    <>
      <path d="M110 176V120M110 120l-40-34M110 120l40-34M110 120V70M70 86l-30-24M70 86l-6-40M150 86l30-24M150 86l6-40M110 70l-22-34M110 70l22-34" />
