---
// The "My story" invitation card, on the home page (just after "Hi, I'm Kritikesh") and on the About page.
// It leads with the struggle, because people connect to the struggle, and every question on it opens that exact
// answer on /about/my-story/ (so the card never promises something the story does not answer).
// The questions are picked by id from src/data/my-story.ts; the numbers come from his Life History sheet
// (3 UPSC Prelims: 10 Oct 2021, 5 Jun 2022, 24 May 2026; 3 RAS Prelims: Oct 2021, Oct 2023, Feb 2025; preparing since 2018).
// Guide: docs/17-library-map.md, section 5, "My story".
import { STORY } from '../data/my-story';
import { langFromUrl, localizePath, pick } from '../i18n/config';

interface Props { /** one column, for narrow pages such as About */ stack?: boolean }
const { stack = false } = Astro.props;
const lang = langFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const hi = lang === 'hi';
const all = STORY.flatMap((m) => m.qs);
const N = all.length;
// reading time, worked out the same way as on the story page
const words = all.reduce((s, q) => s + (hi ? q.a.hi : q.a.en).join(' ').split(/\s+/).length, 0);
const minutes = Math.max(2, Math.round(words / 230));

// the hooks: a short, honest teaser for a question, and the question it opens
const HOOKS: { id: string; en: string; hi: string }[] = [
  { id: 'miranda-house', en: 'Why did I study two years for a women’s college?', hi: 'मैं दो साल लड़कियों के कॉलेज के लिए क्यों पढ़ता रहा?' },
  { id: 'what-changed-you', en: 'How did one friend change the naughtiest boy in class?', hi: 'एक दोस्त ने क्लास के सबसे शरारती लड़के को कैसे बदल दिया?' },
  { id: 'no-shortcut', en: 'What did it feel like when my dream of IAS at 21 broke?', hi: '21 साल में IAS का सपना टूटा, तब कैसा लगा?' },
  { id: 'delhi-coaching', en: 'What did 5 a.m. mornings in Delhi teach me?', hi: 'दिल्ली की सुबह 5 बजे वाली सुबहों ने मुझे क्या सिखाया?' },
  { id: 'one-percent', en: 'How does it feel to miss a dream by 1%?', hi: 'किसी सपने से 1% से चूकना कैसा लगता है?' },
].filter((h) => all.some((q) => q.id === h.id));
// the one question shown larger and bolder than the rest (his wish, 15 Nov 2026)
const FEATURE = all.find((q) => q.id === 'why-ai');

const T = pick({
  en: {
    eyebrow: 'My story', time: `${N} questions · about ${minutes} minutes`,
    h: 'I didn’t clear the exam I gave years to.', h2: 'Here’s why I wouldn’t change a single day.',
    text: 'From the naughtiest boy in class in Rawatbhata, to UPSC and RAS attempts, 5 a.m. mornings for Delhi coaching, two degrees and now applied AI. No filter, no shortcuts: just what the struggle taught me, and what it can save you.',
    stats: [['8', 'years of preparation'], ['3', 'UPSC attempts'], ['3', 'RAS attempts'], ['1', 'reason to keep going']],
    ask: 'Pick a question, I’ll answer it:', gainedT: 'If I could go back, would I change anything?', gainedA: 'Not a single day. The struggle gave me:', why: 'Here’s why →', featA: 'My answer →',
    gained: ['Discipline that runs without a boss', 'A plan for every big goal', 'Calm after every “no”', 'A reason bigger than myself'],
    go: 'Read my story →', sub: 'Talk to me like a friend would: one question at a time.',
  },
  hi: {
    eyebrow: 'मेरी कहानी', time: `${N} सवाल · लगभग ${minutes} मिनट`,
    h: 'जिस परीक्षा को बरसों दिए, वह मैं पास नहीं कर पाया।', h2: 'फिर भी मैं एक भी दिन क्यों नहीं बदलूँगा।',
    text: 'रावतभाटा में क्लास के सबसे शरारती लड़के से, UPSC और RAS के प्रयासों, दिल्ली कोचिंग के लिए सुबह 5 बजे की सुबहों, दो डिग्रियों और अब अप्लाइड AI तक। कोई दिखावा नहीं, कोई शॉर्टकट नहीं: बस वह जो संघर्ष ने मुझे सिखाया, और जो आपका समय बचा सकता है।',
    stats: [['8', 'साल की तैयारी'], ['3', 'UPSC प्रयास'], ['3', 'RAS प्रयास'], ['1', 'चलते रहने की वजह']],
    ask: 'कोई सवाल चुनिए, जवाब मैं दूँगा:', gainedT: 'अगर पीछे जा सकूँ, तो क्या कुछ बदलूँगा?', gainedA: 'एक भी दिन नहीं। संघर्ष ने मुझे दिया:', why: 'वजह पढ़िए →', featA: 'मेरा जवाब →',
    gained: ['बिना किसी के कहे चलने वाला अनुशासन', 'हर बड़े लक्ष्य के लिए एक योजना', 'हर “ना” के बाद भी शांत मन', 'अपने से बड़ी एक वजह'],
    go: 'मेरी कहानी पढ़िए →', sub: 'जैसे कोई दोस्त बात करे: एक-एक सवाल करके।',
  },
}, lang);
const url = L('/about/my-story/');
---

<section class:list={['story-teaser', 'reveal', { stack }]} aria-labelledby="st-h">
  <div class="st-glow" aria-hidden="true"></div>
  <div class="st-main">
    <p class="st-eyebrow"><span class="dot" aria-hidden="true"></span>{T.eyebrow} · {T.time}</p>
    <h2 id="st-h"><a href={`${url}#would-you-change-anything`}><span class="h1">{T.h}</span> <span class="h2">{T.h2}</span></a></h2>
    <p class="st-text">{T.text}</p>
    <ul class="st-stats">{T.stats.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}</ul>
    <p class="st-cta"><a class="st-btn" href={url}>{T.go}</a><span>{T.sub}</span></p>
  </div>
  <div class="st-side">
    {FEATURE && <a class="st-feat" href={`${url}#${FEATURE.id}`}><b>{hi ? FEATURE.q.hi : FEATURE.q.en}</b><span>{T.featA}</span></a>}
    <div class="st-gained">
      <p class="gq">{T.gainedT}</p>
      <p class="ga">{T.gainedA}</p>
      <ul>{T.gained.map((g) => <li>{g}</li>)}</ul>
      <a class="gw" href={`${url}#would-you-change-anything`}>{T.why}</a>
    </div>
    <p class="st-ask">{T.ask}</p>
    <ul class="st-qs">{HOOKS.map((h) => <li><a href={`${url}#${h.id}`}><span class="qn" aria-hidden="true">?</span>{hi ? h.hi : h.en}<span class="arr" aria-hidden="true">→</span></a></li>)}</ul>
  </div>
</section>

<style>
  .story-teaser {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2rem;
    padding: clamp(1.4rem, 3.5vw, 2.6rem); border-radius: 26px;
    background: linear-gradient(135deg, #1d1636 0%, #2c1f52 55%, #3b2546 100%);
    color: #f3eefc; box-shadow: 0 24px 60px rgb(29 22 54 / 0.35);
  }
  .st-glow { position: absolute; inset: -40% -10% auto auto; width: 70%; aspect-ratio: 1; z-index: -1; border-radius: 50%;
    background: radial-gradient(circle, rgb(240 142 112 / 0.35), transparent 62%); animation: st-drift 14s ease-in-out infinite alternate; }
  @keyframes st-drift { to { transform: translate(-18%, 22%) scale(1.15); } }
  .story-teaser::after { content: ''; position: absolute; inset: auto 0 0 0; height: 5px; background: linear-gradient(90deg, #8f7be8, #f08e70, #e0b45e); }
  .st-eyebrow { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.8rem; font: 600 0.78rem/1.4 var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; color: #e0b45e; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #f08e70; box-shadow: 0 0 0 0 rgb(240 142 112 / 0.7); animation: st-pulse 2.2s infinite; }
  @keyframes st-pulse { 70% { box-shadow: 0 0 0 10px rgb(240 142 112 / 0); } 100% { box-shadow: 0 0 0 0 rgb(240 142 112 / 0); } }
  .story-teaser h2 { margin: 0 0 0.9rem; font-size: clamp(1.6rem, 3.6vw, 2.5rem); line-height: 1.15; }
  .story-teaser h2 a { color: inherit; text-decoration: none; }
  .story-teaser h2 .h2 { display: block; margin-top: 0.3rem; font-family: var(--font-display); font-style: italic; font-weight: 500; color: #e0b45e; }
  .story-teaser h2 a:hover .h1 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .st-text { margin: 0 0 1.2rem; font-family: var(--font-serif); font-size: 1.06rem; line-height: 1.7; color: #d9d2ee; max-width: 36rem; }
  .st-stats { list-style: none; margin: 0 0 1.4rem; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .st-stats li { padding: 0.7rem 0.6rem; border-radius: 14px; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.12); text-align: center; }
  .st-stats b { display: block; font: 700 1.7rem/1.1 var(--font-serif); color: #fff; }
  .st-stats span { display: block; margin-top: 0.2rem; font-size: 0.78rem; line-height: 1.3; color: #c9c1e3; }
  .st-cta { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; margin: 0; }
  .st-cta span { font-size: 0.9rem; color: #c9c1e3; }
  .st-btn { display: inline-block; padding: 0.8rem 1.4rem; border-radius: 999px; font-weight: 700; color: #1d1636; text-decoration: none;
    background: linear-gradient(90deg, #e0b45e, #f08e70); box-shadow: 0 10px 26px rgb(240 142 112 / 0.35); transition: transform 0.2s, box-shadow 0.2s; }
  .st-btn:hover { color: #1d1636; transform: translateY(-2px) scale(1.02); box-shadow: 0 14px 32px rgb(240 142 112 / 0.5); }

  .st-feat { display: block; margin: 0 0 1rem; padding: 1rem 1.1rem; border-radius: 18px; text-decoration: none;
    background: linear-gradient(135deg, rgb(224 180 94 / 0.22), rgb(240 142 112 / 0.16)); border: 2px solid #e0b45e; transition: transform 0.2s, background 0.2s; }
  .st-feat b { display: block; font: 800 clamp(1.3rem, 2.6vw, 1.7rem)/1.25 var(--font-serif); color: #fff; }
  .st-feat span { display: block; margin-top: 0.35rem; font-weight: 700; color: #e0b45e; }
  .st-feat:hover, .st-feat:focus-visible { transform: translateY(-2px); background: linear-gradient(135deg, rgb(224 180 94 / 0.32), rgb(240 142 112 / 0.24)); }
  .st-ask { margin: 1.1rem 0 0.6rem; font-weight: 600; color: #fff; }
  .st-qs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .st-qs a { display: flex; align-items: center; gap: 0.7rem; padding: 0.65rem 0.8rem; border-radius: 14px; color: #f3eefc; text-decoration: none;
    background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.12); font-size: 0.88rem; line-height: 1.35;
    transition: background 0.2s, border-color 0.2s, transform 0.2s; }
  .st-qs a:hover, .st-qs a:focus-visible { background: rgb(255 255 255 / 0.13); border-color: #e0b45e; transform: translateX(4px); color: #fff; }
  .qn { flex: none; display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: #8f7be8; color: #fff; font: 700 0.9rem/1 var(--font-serif); }
  .arr { margin-left: auto; color: #e0b45e; opacity: 0; transition: opacity 0.2s; }
  .st-qs a:hover .arr, .st-qs a:focus-visible .arr { opacity: 1; }
  .st-gained { padding: 0.9rem 1rem; border-radius: 16px; background: rgb(224 180 94 / 0.1); border: 1px dashed rgb(224 180 94 / 0.5); }
  .st-gained .gq { margin: 0 0 0.25rem; font: 600 1.25rem/1.3 var(--font-display); font-style: italic; color: #e0b45e; }
  .st-gained .ga { margin: 0 0 0.5rem; font-weight: 700; color: #fff; }
  .st-gained .gw { display: inline-block; margin-top: 0.6rem; font-weight: 700; color: #e0b45e; text-decoration: none; }
  .st-gained .gw:hover, .st-gained .gw:focus-visible { color: #fff; text-decoration: underline; }
  .st-gained ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.9rem; }
  .st-gained li { position: relative; padding-left: 1.3rem; font-size: 0.9rem; color: #e9e3f7; }
  .st-gained li::before { content: '✓'; position: absolute; left: 0; color: #6cc9b0; font-weight: 700; }

  .story-teaser.stack { grid-template-columns: 1fr; gap: 1.4rem; margin: 1.8rem 0; }
  @media (max-width: 860px) {
    .story-teaser { grid-template-columns: 1fr; gap: 1.4rem; }
    .st-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 420px) { .st-gained ul { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .st-glow, .dot { animation: none; } }
</style>
