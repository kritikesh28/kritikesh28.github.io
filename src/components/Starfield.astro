---
// Twinkling stars drawn once at build time (same picture every time), animated with CSS only.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: 90 }, () => ({
  x: +(rand() * 1000).toFixed(1),
  y: +(rand() * 600).toFixed(1),
  r: +(0.6 + rand() * 1.5).toFixed(2),
  k: Math.floor(rand() * 4),
}));
---

<svg class="starfield" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g class="layer far">
    {stars.slice(0, 55).map((s) => <circle cx={s.x} cy={s.y} r={s.r * 0.8} class={`tw tw${s.k}`} />)}
  </g>
  <g class="layer near">
    {stars.slice(55).map((s) => <circle cx={s.x} cy={s.y} r={s.r} class={`tw tw${s.k}`} />)}
  </g>
  <line class="shoot" x1="0" y1="0" x2="70" y2="22" />
</svg>

<style>
  .starfield { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .layer { transition: transform 0.6s ease-out; }
  .tw { fill: #fff; opacity: 0.7; transform-box: fill-box; transform-origin: center; }
  .tw0 { animation: twinkle 3.2s ease-in-out infinite; }
  .tw1 { animation: twinkle 4.6s ease-in-out infinite 1.1s; }
  .tw2 { animation: twinkle 5.8s ease-in-out infinite 2.3s; opacity: 0.45; }
  .tw3 { fill: #ffd9a8; animation: twinkle 7s ease-in-out infinite 0.6s; }
  @keyframes twinkle { 0%, 100% { opacity: 0.25; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.25); } }
  .shoot {
    stroke: #fff; stroke-width: 1.4; stroke-linecap: round; opacity: 0;
    animation: shoot 9s ease-in infinite 4s;
  }
  @keyframes shoot {
    0% { transform: translate(120px, 40px); opacity: 0; }
    2% { opacity: 0.9; }
    7% { transform: translate(520px, 170px); opacity: 0; }
    100% { transform: translate(520px, 170px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw, .shoot { animation: none; }
  }
</style>
