<script>
  const CX = 100, CY = 100, LA = 74, SC = 0.27;
  const PERIOD = 16000, FLAP = 430, GAP = 0.2;
  const W: Record<string, any[][]> = {"far":[[[0.02,-0.08],[-0.42,-0.92],[-0.38,-0.02],5,0.06,[0.08,-0.35],[0.18,0.05]],[[0.08,-0.06],[-0.14,0.72],[-0.16,0.06],5,-0.05,[0.16,0.26],[0.22,-0.04]]],"wing":[[[0.12,-0.1],[-0.18,-1.0],[-0.2,-0.04],5,0.07,[0.08,-0.35],[0.18,0.05]],[[0.14,-0.06],[-0.5,0.8],[-0.32,-0.04],5,-0.08,[0.14,0.32],[0.3,-0.02]]],"covert":[[[0.1,-0.12],[-0.02,-0.55],[-0.06,-0.1],2,0.04,[0.08,-0.35],[0.18,0.05]],[[0.12,-0.08],[-0.12,0.34],[-0.22,-0.04],2,-0.04,[0.1,0.2],[0.14,-0.02]]]};
  const mix = (a: any, b: any, k: number): any => (Array.isArray(a) ? a.map((v, i) => mix(v, b[i], k)) : a + (b - a) * k);
  const wing = (name: string, k: number) => {
    const [sh, tp, root, bumps, amp, c1, c2] = mix(W[name][0], W[name][1], k);
    const nb = Math.round(bumps), out: string[] = [];
    const b1 = [sh[0] + c1[0], sh[1] + c1[1]], b2 = [tp[0] + c2[0], tp[1] + c2[1]];
    for (let i = 0; i < 40; i++) {
      const t = i / 39, u = 1 - t;
      out.push(`${((u * u * u * sh[0] + 3 * u * u * t * b1[0] + 3 * u * t * t * b2[0] + t * t * t * tp[0]) * 100).toFixed(1)},${((u * u * u * sh[1] + 3 * u * u * t * b1[1] + 3 * u * t * t * b2[1] + t * t * t * tp[1]) * 100).toFixed(1)}`);
    }
    const dx = root[0] - tp[0], dy = root[1] - tp[1], n = Math.hypot(dx, dy) || 1;
    for (let i = 0, m = nb * 12; i <= m; i++) {
      const q = i / m, o = -amp * Math.abs(Math.sin(Math.PI * nb * q));
      out.push(`${((tp[0] + dx * q - (dy / n) * o) * 100).toFixed(1)},${((tp[1] + dy * q + (dx / n) * o) * 100).toFixed(1)}`);
    }
    return out.join(' ');
  };
  const N = 600, pts: number[][] = [], cum = [0];
  for (let i = 0; i <= N; i++) {
    const t = (-2 * Math.PI * i) / N, d = 1 + Math.sin(t) ** 2;
    pts.push([CX + (LA * Math.cos(t)) / d, CY + (LA * Math.sin(t) * Math.cos(t)) / d]);
  }
  for (let i = 1; i <= N; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  const L = cum[N];
  const atS = (s: number) => {
    s = ((s % L) + L) % L;
    let lo = 0, hi = N;
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (cum[m] <= s) lo = m; else hi = m; }
    const f = (s - cum[lo]) / (cum[hi] - cum[lo] || 1);
    return [pts[lo][0] + f * (pts[hi][0] - pts[lo][0]), pts[lo][1] + f * (pts[hi][1] - pts[lo][1])];
  };

  const seal = document.querySelector<HTMLAnchorElement>('.seal');
  const birds = [...(seal?.querySelectorAll<SVGGElement>('.sb') ?? [])].map((el, i) => ({
    el, s0: L * 0.3 - i * GAP * L, ang: NaN, beat: i * 0.37,
    far: el.querySelector('.far')!, near: el.querySelector('.wing')!, cov: el.querySelector('.covert')!,
  }));
  const place = (el: number, flap: boolean) => {
    for (const b of birds) {
      const s = b.s0 + (el / PERIOD) * L, p = atS(s), q = atS(s + 3);
      let a = (Math.atan2(q[1] - p[1], q[0] - p[0]) * 180) / Math.PI;
      if (!isNaN(b.ang)) a += 360 * Math.round((b.ang - a) / 360);
      b.ang = a;
      let roll = Math.max(-1, Math.min(1, 5 * Math.cos((a * Math.PI) / 180)));
      if (Math.abs(roll) < 0.15) roll = roll < 0 ? -0.15 : 0.15;
      if (flap) {
        const u = ((el / FLAP + b.beat) % 1 + 1) % 1, v = u < 0.42 ? u / 0.42 : 1 - (u - 0.42) / 0.58, k = v * v * (3 - 2 * v);
        b.far.setAttribute('points', wing('far', k)); b.near.setAttribute('points', wing('wing', k)); b.cov.setAttribute('points', wing('covert', k));
      }
      b.el.setAttribute('transform', `translate(${p[0].toFixed(1)} ${p[1].toFixed(1)}) rotate(${a.toFixed(1)}) scale(${SC} ${(roll * SC).toFixed(4)})`);
    }
  };
  place(0, false);
  if (seal && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let last = 0, el = 0;
    const frame = (now: number) => {
      const dt = last ? Math.min(100, now - last) : 0;
      last = now;
      if (!document.hidden && seal.classList.contains('shown')) { el += dt; place(el, true); }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
  // on the home page, appear once the poster's own sparrows are out of sight
  const poster = document.querySelector('.poster');
  if (seal && poster) new IntersectionObserver(([e]) => seal.classList.toggle('shown', !e.isIntersecting), { threshold: 0.15 }).observe(poster);
  else seal?.classList.add('shown');
</script>

<style>
  .seal {
    position: fixed; right: max(16px, 1.6vw); bottom: max(16px, 1.6vw); z-index: 40; width: 76px; height: 76px; border-radius: 50%;
    box-shadow: 0 10px 30px -12px rgb(23 19 46 / 0.55), 0 0 0 1px rgb(242 215 166 / 0.45);
    opacity: 0; transform: translateY(12px) scale(0.9); pointer-events: none;
    transition: opacity 0.6s, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s;
  }
  .seal.shown { opacity: 1; transform: none; pointer-events: auto; }
  .seal:hover, .seal:focus-visible { box-shadow: 0 12px 34px -10px rgb(23 19 46 / 0.65), 0 0 0 1.5px #f2d7a6; }
  .seal svg { display: block; width: 100%; height: 100%; }
  .disc { fill: #17132e; }
  .loop { fill: none; stroke: #ffb894; stroke-width: 1.4; opacity: 0.4; stroke-dasharray: 2 5; stroke-linecap: round; }
  @media (max-width: 600px) { .seal { width: 60px; height: 60px; } }
  @media print { .seal { display: none; } }
</style>
