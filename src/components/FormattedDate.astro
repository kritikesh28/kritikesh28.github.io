---
import { langFromUrl, LOCALES } from '../i18n/config';
interface Props { date: Date }
const { date } = Astro.props;
const locale = LOCALES[langFromUrl(Astro.url)].dateLocale;
---

<time datetime={date.toISOString()}>
  {date.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
</time>
