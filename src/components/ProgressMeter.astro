---
// "3 of 12 read" with a bar. Filled in by src/scripts/library-progress.ts
interface Props { twig: string; total: number }
const { twig, total } = Astro.props;
---

<div class="meter" data-progress-twig={twig} data-total={total}>
  <div class="track" data-bar><span></span></div>
  <p class="small muted" data-count>Not started yet</p>
</div>

<style>
  .meter { --done: 0%; }
  .track { height: 8px; border-radius: 999px; background: var(--accent-soft); overflow: hidden; }
  .track span { display: block; height: 100%; width: var(--done); border-radius: inherit; background: linear-gradient(90deg, var(--teal), var(--accent)); transition: width 0.6s ease; }
  .meter p { margin: 0.35rem 0 0; }
</style>
