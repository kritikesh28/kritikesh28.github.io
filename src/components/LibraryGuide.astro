---
// "How this library works": the side panel on library pages.
import { getLevels } from '../library.config';
import LevelIcon from './LevelIcon.astro';
import { langFromUrl } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { here?: string }
const { here } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const end = lang === 'hi' ? '।' : '.';
---

<details class="guide" data-guide open>
  <summary>{t('lib.guide.title')}</summary>
  <ol class="levels">
    {getLevels(lang).map((l) => (
      <li class:list={{ here: l.name === here }}>
        <LevelIcon level={l.name} size={24} class="icon" />
        <span><strong data-here={t('lib.youAreHere')}>{l.label}</strong> {l.means}{end} <span class="muted">{t('lib.guide.like', { x: l.like })}</span></span>
      </li>
    ))}
  </ol>
  <ul class="promises small">
    <li>{t('lib.guide.p1')}</li>
    <li>{t('lib.guide.p2')}</li>
    <li>{t('lib.guide.p3')}</li>
  </ul>
</details>

<script>
  // Open by default on first visit; afterwards it remembers if you closed it.
  const g = document.querySelector<HTMLDetailsElement>('[data-guide]');
  if (g) {
    try {
      if (localStorage.getItem('cs-guide') === 'closed') g.open = false;
      g.addEventListener('toggle', () => localStorage.setItem('cs-guide', g.open ? 'open' : 'closed'));
    } catch {}
  }
</script>

<style>
  .guide { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.9rem 1rem; font-size: 0.92rem; }
  .guide summary { cursor: pointer; font-weight: 600; font-family: var(--font-serif); font-size: 1rem; }
  .levels { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .levels li { display: flex; gap: 0.55rem; align-items: baseline; padding: 0.35rem 0.5rem; border-radius: 10px; line-height: 1.4; }
  .levels li.here { background: var(--accent-soft); }
  .levels li.here strong::after { content: ' · ' attr(data-here); font-weight: 500; font-size: 0.8em; color: var(--accent); }
  .levels :global(.icon) { flex: none; align-self: center; color: #8a6a3b; }
  :global([data-theme='dark']) .levels :global(.icon) { color: #e0b45e; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .levels :global(.icon) { color: #e0b45e; } }
  .promises { margin: 0.8rem 0 0; padding-left: 1.1rem; color: var(--ink-soft); display: grid; gap: 0.25rem; }
</style>
