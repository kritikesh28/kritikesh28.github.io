  {name === 'sewing' && (
    <>
      <circle cx="50" cy="140" r="14" /><circle cx="90" cy="140" r="14" /><path d="M60 130l90-100M80 130L30 40" />
      <path d="M130 110h70v50h-70z" /><circle cx="152" cy="128" r="4" /><circle cx="176" cy="128" r="4" /><circle cx="152" cy="146" r="4" /><circle cx="176" cy="146" r="4" />
      <path d="M190 20l-30 70M190 20l4-4" /><path d="M160 90c-20 20-60 0-90 30" stroke-dasharray="4 4" />
