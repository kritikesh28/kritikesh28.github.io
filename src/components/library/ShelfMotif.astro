---
// Faint line drawings behind the Library cards: one per shelf (topic) and one per theme.
// Same style as TreeMotif (the six long-read trees): thin strokes in the card's colour, with a sparrow hidden in each.
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const sparrow = 'M23 6.2l-2.8-1c-.6-2.6-3.2-3.8-5.4-3.4-2.2.4-3.6 1.8-4.4 3.6C8.2 6.4 5.6 7.6 3.2 8.4L.4 9.4l3.2 1.2c2.4 3 6.4 4 10 3 4-1 6.4-3.4 6.8-6.2L23 6.2zM18.3 4.6a.7.7 0 1 1-1.4 0 .7.7 0 1 1 1.4 0zM9 8.4c2.6-.6 5.4 0 7.2 1.8-2.4.4-5 .2-7.2-1.8z';
const bird = (x: number, y: number, s = 0.9) => `translate(${x} ${y}) scale(${s})`;
---

<svg class:list={['motif', cls]} viewBox="0 0 220 180" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  {(name === 'the-universe' || name === 'cosmos') && (
    <>
      <path d="M110 92c0-12 18-16 26-4 10 16-6 38-30 36-30-2-44-34-26-58 22-30 70-24 86 10 18 38-12 78-54 80" />
      <path d="M110 92c0 8-10 10-14 4-6-10 4-22 18-20 18 2 24 24 12 38" />
      <circle cx="110" cy="92" r="3" fill="currentColor" />
      <circle cx="40" cy="40" r="10" /><ellipse cx="40" cy="40" rx="20" ry="5" transform="rotate(-20 40 40)" />
      <path d="M180 30v10M175 35h10M30 140v8M26 144h8M196 120v6M193 123h6" />
      <g transform={bird(150, 140)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
  )}
  {name === 'movies' && (
    <>
      <circle cx="70" cy="70" r="40" /><circle cx="70" cy="70" r="8" />
      {[0, 72, 144, 216, 288].map((a) => <circle cx={70 + 22 * Math.cos((a * Math.PI) / 180)} cy={70 + 22 * Math.sin((a * Math.PI) / 180)} r="9" />)}
      <path d="M110 70c30 0 40 20 60 20h40M118 120h84v44h-84zM118 120l10-16h84l-10 16M140 104l-8 16M164 104l-8 16M188 104l-8 16" />
      <path d="M30 120c-8 20 0 40 20 48" stroke-dasharray="3 6" />
      <g transform={bird(170, 60)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
  )}
  {name === 'books' && (
    <>
      <path d="M20 120c30-12 60-12 90 4 30-16 60-16 90-4V50c-30-12-60-12-90 4-30-16-60-16-90-4z" />
      <path d="M110 54v70M36 70c18-6 36-6 56 2M36 86c18-6 36-6 56 2M128 72c20-8 38-8 56-2M128 88c20-8 38-8 56-2" />
      <path d="M40 140h140M48 152h124M56 164h108" />
      <path d="M150 20c10 6 14 16 12 28" />
      <g transform={bird(66, 26)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
  )}
  {(name === 'music' || name === 'arts') && (
    <>
      <path d="M10 60c50-20 150-20 200 0M10 76c50-20 150-20 200 0M10 92c50-20 150-20 200 0M10 108c50-20 150-20 200 0M10 124c50-20 150-20 200 0" opacity="0.7" />
      <ellipse cx="60" cy="112" rx="10" ry="7" fill="currentColor" stroke="none" /><path d="M70 112V52" />
      <ellipse cx="110" cy="96" rx="10" ry="7" fill="currentColor" stroke="none" /><path d="M120 96V40l40 8v54" />
      <ellipse cx="150" cy="104" rx="10" ry="7" fill="currentColor" stroke="none" />
      <path d="M30 150c20-10 40 10 60 0s40-10 60 0 40 10 50 0" />
      <g transform={bird(168, 20)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
