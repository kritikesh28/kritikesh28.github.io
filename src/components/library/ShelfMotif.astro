      <ellipse cx="160" cy="130" rx="40" ry="12" /><path d="M120 130v26c0 8 18 14 40 14s40-6 40-14v-26M130 140l10 24M190 140l-10 24" />
      <g transform={bird(150, 90)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
