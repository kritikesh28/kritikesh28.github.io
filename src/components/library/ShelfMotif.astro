    <>
      <circle cx="60" cy="70" r="14" /><circle cx="110" cy="56" r="16" /><circle cx="160" cy="70" r="14" />
      <path d="M34 140c0-30 12-46 26-46s26 16 26 46M80 140c0-36 14-56 30-56s30 20 30 56M134 140c0-30 12-46 26-46s26 16 26 46" />
