  {name === 'sports-and-games' && (
    <>
      <circle cx="70" cy="110" r="40" /><path d="M70 92l16 12-6 18H60l-6-18zM70 92V70M86 104l20-6M80 122l12 18M60 122l-12 18M54 104l-20-6" />
      <path d="M150 20l40 120M190 140l10 30M146 18l12-4" /><rect x="150" y="136" width="60" height="36" rx="3" />
      <path d="M162 136v36M174 136v36M186 136v36M198 136v36" opacity="0.6" />
      <g transform={bird(30, 30)}><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /></g>
    </>
  )}
  {(name === 'technology' || name === 'making') && (
    <>
      <circle cx="70" cy="90" r="26" /><circle cx="70" cy="90" r="10" />
      <path d="M70 52v12M70 116v12M32 90h12M96 90h12M43 63l9 9M88 108l9 9M97 63l-9 9M52 108l-9 9" />
