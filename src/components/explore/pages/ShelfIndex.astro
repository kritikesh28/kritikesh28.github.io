---
// One Encyclopedic Index: cover, the five starting questions, the map of Parts, progress and the booklet download.
// Used by both languages: src/pages/library/[topic]/index.astro and src/pages/hi/library/[topic]/index.astro.
// The text is English for now; on the Hindi site the frame, buttons and links are Hindi and a note says so.
import Base from '../../../layouts/Base.astro';
import Progress from '../Progress.astro';
import Contents from '../Contents.astro';
import { getTopic, minutes, isLeaf, flatPages } from '../../../explore';
import { SHELVES, fieldName, fieldUrl, nodeName, themeOf, shelfTitle, branchName, getField } from '../../../library-map';
import { langFromUrl, localizePath, pick } from '../../../i18n/config';
import '../../../styles/explore.css';
import '../../../styles/explore-topics.css';

interface Props { topic: string }
const lang = langFromUrl(Astro.url);
const hi = lang === 'hi';
const L = (p: string) => localizePath(p, lang);
const t = getTopic(Astro.props.topic);
const shelf = SHELVES.find((x) => x.slug === t.slug)!;
const tUrl = shelf.url;
const node = nodeName(shelf.node);
const branchCode = shelf.node?.split('.').slice(0, 2).join('.');
const nodeLabel = hi && branchCode ? branchName(getField(shelf.field).branches.find((b) => b.code === branchCode) ?? { code: '', name: node ?? '' }, lang) : node;
const [part0, ...rest] = t.parts;
const leaves = part0.sections.filter((s) => isLeaf(s.id));
const gateway = part0.sections[0];
const nPages = flatPages(t).length;
const allIds = t.parts.flatMap((p) => p.sections.flatMap((s) => s.entries.map((e) => e.id)));
const description = `${t.short}: The Encyclopedic Index. ${t.subtitle}. ${t.sections} short pages and ${t.entries} entries covering ${t.tagline.replace(/ · /g, ', ').toLowerCase()}.`.slice(0, 300);
const schema = [
  {
    '@type': 'Book',
    name: `${t.short}: The Encyclopedic Index`,
    alternateName: t.subtitle,
    url: new URL(tUrl, Astro.site).href,
    bookEdition: t.edition,
    inLanguage: 'en',
    author: { '@id': new URL('/#person', Astro.site).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Library', item: new URL('/library/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: fieldName(shelf.field), item: new URL(fieldUrl(shelf.field), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: t.short, item: new URL(tUrl, Astro.site).href },
    ],
  },
];
const T = pick({
  en: { lib: 'Library', level: 'A twig of the Library · The Encyclopedic Index', parts: 'Parts', pages: 'short pages', entries: 'entries', about: (m: number) => `about ${m} min in all`,
    start: 'Start with question 1 →', seeMap: 'See the whole map', over: 'Overview',
    overP: (n: number) => ['Everything here is cut into', `${n} short pages`, 'of two to three minutes. Each one opens with an overview, keeps the answers short and ends with a summary. Use the Parts on the left, or start with the five questions below and press', 'Next', '.'],
    fiveH: 'Five questions to begin', fiveP: 'About two minutes each.', why: 'Why these five?', recap: 'Recap', q: (i: number) => `Question ${i}`,
    mapH: 'The whole map', mapP: (n: number, x: string) => `${n} Parts, each a branch of ${x}.`, npages: (n: number) => ` · ${n} pages`,
    ed: 'More pictures, videos and the Hindi pages are on their way. Compiled and edited by Kritikesh Rajpurohit with AI assistance; sources and credits are on the', src: 'Sources page',
    prog: 'Your progress', glance: 'At a glance', mins: (m: number) => `about ${m} minutes in all`, contents: 'Contents', close: 'Close', note: '' },
  hi: { lib: 'लाइब्रेरी', level: 'लाइब्रेरी की एक टहनी · विश्वकोशीय सूचकांक', parts: 'भाग', pages: 'छोटे पन्ने', entries: 'प्रविष्टियाँ', about: (m: number) => `कुल लगभग ${m} मिनट`,
    start: 'सवाल 1 से शुरू करें →', seeMap: 'पूरा नक्शा देखें', over: 'एक नज़र में',
    overP: (n: number) => ['यहाँ की हर बात', `${n} छोटे पन्नों`, 'में बँटी है, हर एक दो-तीन मिनट का। हर पन्ना एक झलक से शुरू होता है, जवाब छोटे रखता है और आख़िर में सार देता है। बाईं ओर के भागों से चुनिए, या नीचे के पाँच सवालों से शुरू करके', 'आगे', 'दबाते जाइए।'],
    fiveH: 'शुरुआत के पाँच सवाल', fiveP: 'हर एक लगभग दो मिनट का।', why: 'यही पाँच क्यों?', recap: 'दोहराव', q: (i: number) => `सवाल ${i}`,
    mapH: 'पूरा नक्शा', mapP: (n: number, x: string) => `${n} भाग, हर एक ${x} की एक डाल।`, npages: (n: number) => ` · ${n} पन्ने`,
    ed: 'और तस्वीरें, वीडियो और हिंदी पन्ने रास्ते में हैं। कृतिकेश राजपुरोहित ने AI की मदद से संकलित और संपादित किया; स्रोत और आभार यहाँ हैं:', src: 'स्रोतों वाला पन्ना',
    prog: 'आपकी प्रगति', glance: 'एक नज़र में', mins: (m: number) => `कुल लगभग ${m} मिनट`, contents: 'विषय-सूची', close: 'बंद करें', note: '' },
}, lang);
const shelfName = hi ? shelfTitle(shelf, lang) : t.short;
const overP = T.overP(nPages);
const srcUrl = t.parts.at(-1)!.sections.find((x) => x.id.endsWith('-S'))?.url;
---

<Base title={`${t.short}: The Encyclopedic Index`} {description} {schema} translated={['en']} image={t.cover?.src}>
  <div class={`t-${t.slug}`}>
    <section class="x-cover x-topic-hero">
      {t.cover && <img class="x-cover-img" src={t.cover.src} alt={t.cover.alt} decoding="async" />}
      <span class="x-code" aria-hidden="true">{t.code}</span>
      <div class="x-wrap">
        <p class="x-crumbs"><a href={L('/library/')}>{T.lib}</a><span aria-hidden="true">›</span><a href={`${L('/library/map/')}#${themeOf(shelf.field).id}`}>{hi ? themeOf(shelf.field).hi : themeOf(shelf.field).en}</a><span aria-hidden="true">›</span><a href={L(fieldUrl(shelf.field))}>{fieldName(shelf.field, lang)}</a>{node && <><span aria-hidden="true">›</span><a href={`${L(fieldUrl(shelf.field))}#${branchCode}`}>{nodeLabel}</a></>}</p>
        <p class="x-level">{T.level}</p>
        <h1>{shelfName}</h1>
        <p class="x-question" lang={hi ? 'en' : undefined}>{t.subtitle}</p>
        <ul class="x-facts">
          <li>{t.parts.length} {T.parts}</li><li>{nPages} {T.pages}</li><li>{t.entries} {T.entries}</li><li>{T.about(minutes(t.words))}</li><li lang={hi ? 'en' : undefined}>{t.edition}</li>
        </ul>
        <div class="x-actions">
          <a class="x-btn" href={L(leaves[0]?.url ?? gateway.url)}>{T.start}</a>
          <a class="x-btn ghost" href="#map">{T.seeMap}</a>
        </div>
      </div>
      {t.cover?.credit && <span class="x-cover-credit">{t.cover.credit}</span>}
    </section>

    <div class="x-wrap x-page x-3col">
      <Contents t={t} />
      <div>
        <section class="x-over" aria-label={T.over}>
          <h2>{T.over}</h2>
          <p lang={hi ? 'en' : undefined}>{t.tagline}.</p>
          <p>{overP[0]} <strong>{overP[1]}</strong> {overP[2]} <em>{overP[3]}</em>{hi ? ' ' : ''}{overP[4]}</p>
        </section>

        <div class="x-section-title"><h2>{T.fiveH}</h2><p>{T.fiveP} <a href={L(gateway.url)}>{T.why}</a></p></div>
        <ol class="x-questions">
          {leaves.map((s, i) => (
            <li><a class="x-q" href={L(s.url)}><small>{/^Recap/.test(s.title) ? T.recap : T.q(i + 1)}</small><span lang={hi ? 'en' : undefined}>{s.title.replace(/^Recap:\s*/, '')}</span></a></li>
          ))}
        </ol>

        <div class="x-section-title" id="map"><h2>{T.mapH}</h2><p>{T.mapP(rest.length, hi ? shelfName : t.short.toLowerCase())}</p></div>
        <ol class="x-parts" start="1" lang={hi ? 'en' : undefined}>
          {rest.map((p) => (
            <li class="x-part">
              <header><span class="num">{p.num}</span><h3>{p.title}</h3></header>
              <ul>
                {p.sections.map((s) => (
                  <li><a href={L(s.url)}><span class="eid">{s.id}</span><span>{s.title}{s.pages.length > 1 && <small class="np" lang={hi ? 'hi' : undefined}>{T.npages(s.pages.length)}</small>}</span></a></li>
                ))}
              </ul>
            </li>
          ))}
        </ol>

        <p class="x-edition"><small><span lang={hi ? 'en' : undefined}>{t.edition}</span>. {T.ed} <a href={srcUrl ? L(srcUrl) : '#'}>{T.src}</a>.</small></p>
      </div>
      <aside class="x-rail" aria-label={T.prog}>
        <Progress ids={allIds} label={T.prog} clear={`${t.code}-`} />
        <div class="x-rail-box">
          <h2>{T.glance}</h2>
          <p class="x-rail-facts">{t.parts.length - 1} {T.parts} · {nPages} {T.pages} · {t.entries} {T.entries} · {T.mins(minutes(t.words))}</p>
          <a href={L(leaves[0]?.url ?? gateway.url)}>{T.start}</a>
        </div>
      </aside>
    </div>

    <button class="x-toc-btn" type="button" data-open-toc>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      {T.contents}
    </button>
    <dialog class="toc-sheet" aria-label={T.contents}>
      <div class="sheet-head"><strong>{shelfName}</strong><button type="button" data-close-toc>{T.close}</button></div>
      <Contents t={t} />
    </dialog>
  </div>
</Base>

<script>
  import '../../../scripts/explore';
</script>

<style>
  .x-edition { color: var(--ink-soft); margin: 1.2rem 0 2rem; }
  .np { color: var(--ink-soft); font-size: 0.8em; }
  .x-3col .x-questions { grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .x-3col .x-parts { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .x-3col .x-section-title:first-of-type { margin-top: 1.4rem; }
  .x-level { margin: 0.35rem 0 0.4rem; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; }
  ol.x-questions { counter-reset: none; }
</style>
