---
// The left bar of a shelf: every Part as a drop-down, its Sections inside, and the pages of the Section you are reading.
// Shown beside the text on laptops and in a sheet on phones.
import { pageUrl, pageLabel, TOPICS, type Topic } from '../../explore';
import { SHELVES, shelfTitle } from '../../library-map';
import { langFromUrl, localizePath } from '../../i18n/config';
interface Props { t: Topic; current?: string; page?: number }
const { t, current, page = 0 } = Astro.props;
const lang = langFromUrl(Astro.url);
const hi = lang === 'hi';
const L = (p: string) => localizePath(p, lang);
const shelf = SHELVES.find((x) => x.slug === t.slug);
const tUrl = L(TOPICS.find((x) => x.slug === t.slug)?.url ?? `/library/${t.slug}/`);
---
<nav class="x-toc" aria-label={hi ? `${shelf ? shelfTitle(shelf, lang) : t.short}: विषय-सूची` : `${t.short} contents`}>
  <a class="x-toc-topic" href={tUrl}>{hi && shelf ? shelfTitle(shelf, lang) : t.short}<small>{hi ? 'एक नज़र में और नक्शा' : 'Overview and map'}</small></a>
  {t.parts.map((p) => (
    <details open={p.sections.some((s) => s.id === current) || undefined}>
      <summary><span class="n">{p.num}</span><span class="pt" lang={hi ? 'en' : undefined}>{p.title}</span><span class="ct">{p.sections.reduce((a, s) => a + s.pages.length, 0)}</span></summary>
      <ul lang={hi ? 'en' : undefined}>
        {p.sections.map((s) => (
          <li>
            <a href={L(s.url)} aria-current={s.id === current && page === 0 ? 'page' : s.id === current ? 'true' : undefined}>{s.title.replace(/^The Gateway:\s*/, 'Gateway: ')}{s.pages.length > 1 && <span class="pp" lang={hi ? 'hi' : undefined}>{s.pages.length} {hi ? 'पन्ने' : 'pages'}</span>}</a>
            {s.id === current && s.pages.length > 1 && (
              <ol class="x-toc-pages">
                {s.pages.map((pg, n) => <li><a href={L(pageUrl(s, n))} aria-current={n === page ? 'page' : undefined}>{pageLabel(pg, 1)}</a></li>)}
              </ol>
            )}
          </li>
        ))}
      </ul>
    </details>
  ))}
</nav>
