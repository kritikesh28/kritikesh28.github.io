---
// One topic on the Explore hub: its cover (colours, or a picture once added) and its gateway question.
import { minutes, type TopicSummary } from '../../explore';
interface Props { t: TopicSummary }
const { t } = Astro.props;
---
<a class={`x-card t-${t.slug}`} href={t.url}>
  <div class="x-cover">
    {t.cover && <img class="x-cover-img" src={t.cover.src} alt="" loading="lazy" decoding="async" />}
    <span class="x-code" aria-hidden="true">{t.code}</span>
    <h3>{t.short}</h3>
  </div>
  <div class="x-card-body">
    <p>{t.question}</p>
    <span class="x-card-meta">{t.sections} pages · {t.entries} entries · about {minutes(t.words)} min in all</span>
  </div>
</a>
