---
// Home page band: the 12 Encyclopedic Indexes as small coloured tiles, linking to /explore/.
import { TOPICS } from '../../explore';
import { langFromUrl, pick } from '../../i18n/config';
import '../../styles/explore-topics.css';

const lang = langFromUrl(Astro.url);
const T = pick({
  en: { eyebrow: 'New · Explore', title: 'Twelve worlds, mapped', text: 'Encyclopedic maps of movies, books, music, cooking, gardening, sports, technology and the needle arts. Start with five two-minute questions, then tick your way through.', open: 'Open Explore →', note: '' },
  hi: { eyebrow: 'नया · Explore', title: 'बारह दुनियाएँ, एक नक्शे में', text: 'फ़िल्म, किताबें, संगीत, खाना, बागवानी, खेल, तकनीक और सुई-धागे की कलाओं के पूरे नक्शे। पाँच छोटे सवालों से शुरू कीजिए, फिर एक-एक करके टिक लगाते चलिए।', open: 'Explore खोलें →', note: 'ये पन्ने अभी अंग्रेज़ी में हैं, हिंदी जल्द आएगी।' },
}, lang);
---
<section class="wrap xb">
  <div class="xb-text">
    <p class="eyebrow">{T.eyebrow}</p>
    <h2>{T.title}</h2>
    <p class="muted">{T.text}</p>
    {T.note && <p class="xb-note">{T.note}</p>}
    <p><a class="btn" href="/explore/">{T.open}</a></p>
  </div>
  <ul class="xb-tiles">
    {TOPICS.map((t) => (
      <li class={`t-${t.slug}`}><a href={t.url} hreflang="en"><span>{t.short}</span><small>{t.code}</small></a></li>
    ))}
  </ul>
</section>

<style>
  .xb { margin-top: 4rem; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2.5rem; align-items: center; }
  .xb h2 { margin-top: 0.2rem; }
  .xb-note { font-size: 0.9rem; color: var(--ink-soft); }
  .xb-tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .xb-tiles a {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 84px; padding: 0.7rem 0.8rem; border-radius: 14px; overflow: hidden;
    color: #fff; text-decoration: none; font-family: var(--font-serif); font-weight: 600; line-height: 1.2;
    background: radial-gradient(120% 140% at 90% 0%, color-mix(in srgb, var(--c2) 80%, transparent), transparent 60%), var(--c1);
    transition: transform 0.2s;
  }
  .xb-tiles a:hover { transform: translateY(-3px); color: #fff; }
  .xb-tiles small { position: absolute; right: 0.6rem; top: 0.45rem; font-family: var(--font-sans); font-size: 0.7rem; letter-spacing: 0.08em; opacity: 0.7; }
  @media (max-width: 860px) { .xb { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; } }
  @media (max-width: 420px) { .xb-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } .xb-tiles a { min-height: 64px; } }
</style>
