---
import Sparrow from './Sparrow.astro';
// A small infinity "engine": two sparrows run in place and their steps keep the loop turning.
// One stands on top of the left loop, the other inside the bottom of the right loop.
const loop = 'M180 90 C 228 22, 336 22, 336 90 C 336 158, 228 158, 180 90 C 132 22, 24 22, 24 90 C 24 158, 132 158, 180 90 Z';
---

<div class="engine">
  <svg viewBox="0 -20 360 200" role="img" aria-label="Two sparrows running on an infinity loop and keeping it turning">
    <defs>
      <radialGradient id="glow">
        <stop offset="0" stop-color="#ffd59a" stop-opacity="0.9" />
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="180" cy="90" r="22" fill="url(#glow)" class="core" />
    <path class="trail" d={loop} />
    <g transform="translate(56 -1) scale(0.52)"><Sparrow variant="him" running class="runner" /></g>
    <g transform="translate(249 100) scale(0.52)"><Sparrow variant="her" running class="runner" /></g>
  </svg>
</div>

<style>
  .engine svg { display: block; width: 100%; height: auto; overflow: visible; }
  .trail {
    fill: none; stroke: #f6a27f; stroke-width: 6; stroke-linecap: round;
    stroke-dasharray: 12 10 3 10; animation: turn 2.6s linear infinite;
  }
  @keyframes turn { to { stroke-dashoffset: -70; } }
  .core { animation: pulse 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pulse { 50% { transform: scale(1.3); opacity: 0.6; } }
  .engine :global(.runner) { width: 100px; height: 82px; }
  @media (prefers-reduced-motion: reduce) {
    .trail, .core { animation: none; }
  }
</style>
