---
// Home poster: the cosmic YouTube artwork, re-rendered larger so the story fills the screen.
// The two sparrows are the banner's own drawing (same shapes and colours). They fly on the Morse infinity line itself,
// one following the other, wings beating continuously (the wing shapes are redrawn every frame between the banner's two poses).
// The overlay SVG shares the image's viewBox and uses "slice", so it lines up with object-fit: cover at every size.
// On top: the tagline, six glowing points that tell the poster's story, a guided tour, and a secret in the infinity's Morse code.
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';

// story points, in image px (2560x1600), read left to right
const SPOTS = [
  { x: 470, y: 650, title: 'Seeds', text: 'Every mind begins as scattered pieces of curiosity.' },
  { x: 896.5, y: 800, title: 'The yantra', text: 'Small skills lock together into larger ones, again and again, without end.' },
  { x: 896.5, y: 528, title: 'The orbit', text: 'Twelve fields and passions circle one centre, each feeding the next.' },
  { x: 1676.5, y: 650, title: 'The engine', text: 'Every thread runs into one engine: learning to find patterns with AI.' },
  { x: 2126, y: 862, title: 'Growth', text: 'What is learned keeps growing.' },
  { x: 2378.5, y: 709, title: 'The loop', text: 'Two sparrows keep the loop turning: no one reaches freedom alone.' },
];
---

