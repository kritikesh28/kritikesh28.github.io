<script>
  // Geometry from the banner generator (curious_v2.py, cosmic, YouTube layout with 160 px more sky top and bottom).
  const X0 = 508.0, Y0 = 687.0, H = 386;           // band origin and band height in image px
  const LC = [3.36, 0.36], LA = 0.24;           // infinity centre and size, in band units
  const SC = 0.105 * H / 100;                   // sparrow scale (the banner uses 0.14; a little smaller here)
  const OFF = 0.065 * H;                        // how far the birds fly outside the loop
  const PERIOD = 22000;                         // one full round, ms

  const P = (t: number) => {
    const d = 1 + Math.sin(t) ** 2;
    return [X0 + H * (LC[0] + LA * Math.cos(t) / d), Y0 + H * (LC[1] + LA * Math.sin(t) * Math.cos(t) / d)];
  };
  // sample the loop by arc length so the birds fly at an even speed
  const N = 1200, pts: number[][] = [], cum = [0];
  for (let i = 0; i <= N; i++) pts.push(P((-2 * Math.PI * i) / N));
  for (let i = 1; i <= N; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  const L = cum[N];
  const atS = (s: number) => {
    s = ((s % L) + L) % L;
    let lo = 0, hi = N;
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (cum[m] <= s) lo = m; else hi = m; }
    const f = (s - cum[lo]) / (cum[hi] - cum[lo] || 1);
    return [pts[lo][0] + f * (pts[hi][0] - pts[lo][0]), pts[lo][1] + f * (pts[hi][1] - pts[lo][1])];
  };
  // push each bird outward from the centre of the loop it is on; fades to zero at the crossing so there is no jump
  const fx = H * LA / Math.SQRT2, cx = X0 + H * LC[0], cy = Y0 + H * LC[1];
  const outward = (p: number[]) => {
    const dx = p[0] - cx, side = dx < 0 ? -1 : 1;
    const v = [p[0] - (cx + side * fx), p[1] - cy];
    const n = Math.hypot(v[0], v[1]) || 1;
    const w = Math.min(1, Math.abs(dx) / (0.35 * H * LA));
    const k = OFF * w * w * (3 - 2 * w);
    return [p[0] + (v[0] / n) * k, p[1] + (v[1] / n) * k];
  };

  const svg = document.querySelector<SVGSVGElement>('.poster .flight');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (svg && !reduce) {
    const birds = [...svg.querySelectorAll<SVGGElement>('.sp')].map((el, i) => {
      // the first bird starts where the banner shows it (top of the left loop); the second follows a little over a quarter round behind
      // (half a round would make them meet at the crossing), so the two keep the loop turning between them
      const i0 = Math.round((3.7575 / (2 * Math.PI)) * N);
      el.classList.remove('rest-down');
      return { el, s0: cum[i0] - i * L * 0.28, sx: 1, tilt: 0, lag: i * 700 };
    });
    let start = 0, visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(svg);
    const frame = (now: number) => {
      if (!start) start = now;
      if (visible) {
        const el = now - start;
        for (const b of birds) {
          const s = b.s0 + (el / PERIOD) * L;
          const p = outward(atS(s)), q = outward(atS(s + 6));
          const vx = q[0] - p[0], vy = q[1] - p[1];
          b.sx += ((vx >= 0 ? 1 : -1) - b.sx) * 0.22;
          const tilt = Math.max(-22, Math.min(22, (Math.atan2(vy, Math.abs(vx) + 1e-6) * 180) / Math.PI * 0.7));
          b.tilt += (tilt - b.tilt) * 0.1;
          const sx = Math.abs(b.sx) < 0.3 ? Math.sign(b.sx || 1) * 0.3 : b.sx;
          // flap in short bursts, then glide: the bounding flight of a real sparrow
          const c = (el + b.lag) % 2100;
          const up = c < 1200 ? Math.floor(c / 150) % 2 === 0 : true;
          b.el.classList.toggle('glide', !up);
          b.el.setAttribute('transform', `translate(${p[0].toFixed(1)} ${p[1].toFixed(1)}) scale(${(sx * SC).toFixed(3)} ${SC.toFixed(3)}) rotate(${b.tilt.toFixed(1)})`);
        }
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

