---
// One band at the end of pages that routes each kind of visitor to the right next step.
import { langFromUrl, localizePath } from '../i18n/config';
import { useT } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const contact = localizePath('/contact/', lang);
---

<section class="cta reveal">
  <div class="wrap inner">
    <div>
      <h2>{t('cta.title')}</h2>
      <p class="muted">{t('cta.text')}</p>
    </div>
    <div class="paths">
      <a class="btn" href={`${contact}?intent=hiring`}>{t('cta.hiring')}</a>
      <a class="btn ghost" href={`${contact}?intent=collab`}>{t('cta.build')}</a>
      <a class="btn ghost" href={`${contact}?intent=learning`}>{t('cta.learn')}</a>
    </div>
  </div>
</section>

<style>
  .cta { margin-top: 3.5rem; }
  .inner {
    display: flex; flex-wrap: wrap; gap: 1.2rem 2rem; align-items: center; justify-content: space-between;
    padding: 1.8rem; border-radius: 22px; border: 1px solid var(--line);
    background: linear-gradient(120deg, var(--lavender), var(--blush), var(--peach));
  }
  h2 { margin: 0 0 0.3rem; }
  p { margin: 0; }
  .paths { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
