---
import Sparrow from './Sparrow.astro';
import { CURIOUS_FACTS } from '../site.config';
---

<div class="mascot" data-facts={JSON.stringify(CURIOUS_FACTS)}>
  <p class="bubble" role="status" aria-live="polite" hidden></p>
  <button class="perch" type="button" aria-label="Two curious sparrows. Press for a curious fact.">
    <span class="bird b1"><Sparrow variant="her" /></span>
    <span class="bird b2"><Sparrow variant="him" /></span>
    <svg class="twig" viewBox="0 0 160 20" aria-hidden="true">
      <path d="M2 10 Q60 4 158 12" stroke="#8a6440" stroke-width="5" stroke-linecap="round" fill="none" />
      <path d="M110 9 Q120 0 132 2" stroke="#8a6440" stroke-width="3" stroke-linecap="round" fill="none" />
      <ellipse cx="134" cy="3" rx="7" ry="3.5" fill="#7fb38f" />
    </svg>
  </button>
  <button class="shoo" type="button" aria-label="Hide the sparrows">×</button>
</div>

<style>
  .mascot { position: fixed; right: 14px; bottom: 10px; z-index: 20; width: 132px; }
  .mascot.gone { display: none; }
  .perch { position: relative; display: block; width: 132px; height: 70px; padding: 0; border: 0; background: none; cursor: pointer; }
  .perch:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 12px; }
  .twig { position: absolute; left: 0; bottom: 0; width: 132px; }
  .bird { position: absolute; bottom: 8px; width: 56px; transition: transform 0.3s; }
  .b1 { left: 4px; transform: scaleX(1); animation: idle-hop 11s infinite 3s; }
  .b2 { left: 62px; transform: scaleX(-1); animation: idle-hop-flip 13s infinite 7s; }
  .perch:hover .b1 { transform: rotate(-8deg); }
  .perch:hover .b2 { transform: scaleX(-1) rotate(-8deg); }
  .mascot.hop .b1 { animation: hop 0.5s ease-out 2; }
  .mascot.hop .b2 { animation: hop-flip 0.5s ease-out 2 0.12s; }
  @keyframes hop { 50% { transform: translateY(-14px); } }
  @keyframes hop-flip { 0%, 100% { transform: scaleX(-1); } 50% { transform: scaleX(-1) translateY(-14px); } }
  @keyframes idle-hop { 0%, 92%, 100% { transform: translateY(0); } 95% { transform: translateY(-9px); } }
  @keyframes idle-hop-flip { 0%, 92%, 100% { transform: scaleX(-1); } 95% { transform: scaleX(-1) translateY(-9px); } }
  .bubble {
    position: absolute; right: 8px; bottom: 82px; width: min(260px, calc(100vw - 32px)); margin: 0;
    padding: 0.7rem 0.9rem; border-radius: 14px 14px 4px 14px; font-size: 0.9rem; line-height: 1.45;
    background: var(--surface); color: var(--ink); border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgb(42 35 80 / 0.18); animation: pop 0.25s ease-out;
  }
  @keyframes pop { from { transform: translateY(6px) scale(0.96); opacity: 0; } }
  .shoo {
    position: absolute; top: -6px; right: -4px; width: 22px; height: 22px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-soft); font-size: 14px; line-height: 1;
    cursor: pointer; opacity: 0; transition: opacity 0.2s;
  }
  .mascot:hover .shoo, .shoo:focus-visible { opacity: 1; }
  @media (max-width: 600px) {
    .mascot, .perch, .twig { width: 96px; }
    .perch { height: 52px; }
    .bird { width: 40px; }
    .b2 { left: 46px; }
    .shoo { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .b1, .b2 { animation: none !important; }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('.mascot');
  if (box) {
    let hidden = false;
    try { hidden = localStorage.getItem('sparrows') === 'away'; } catch {}
    if (hidden) box.classList.add('gone');
    const facts: string[] = JSON.parse(box.dataset.facts ?? '[]');
    const bubble = box.querySelector<HTMLElement>('.bubble')!;
    let i = Math.floor(Math.random() * facts.length);
    let timer: number | undefined;
    box.querySelector('.perch')?.addEventListener('click', () => {
      i = (i + 1) % facts.length;
      bubble.textContent = facts[i];
      bubble.hidden = false;
      bubble.style.animation = 'none';
      void bubble.offsetWidth;
      bubble.style.animation = '';
      box.classList.remove('hop');
      void box.offsetWidth;
      box.classList.add('hop');
      clearTimeout(timer);
      timer = window.setTimeout(() => { bubble.hidden = true; }, 7000);
    });
    box.querySelector('.shoo')?.addEventListener('click', () => {
      box.classList.add('gone');
      try { localStorage.setItem('sparrows', 'away'); } catch {}
    });
  }
</script>
