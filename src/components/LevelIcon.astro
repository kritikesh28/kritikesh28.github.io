---
// Hand-drawn line icons for the library levels. Each one hides a small sparrow.
// Drawn in currentColor so they follow the page colours (gold on dark, ink on light).
interface Props { level: 'Forest' | 'Tree' | 'Branch' | 'Twig' | 'Leaf'; size?: number; class?: string }
const { level, size = 40, class: cls } = Astro.props;
// A small perched sparrow facing right, about 14 x 11 units, top-left at (0, 0)
const sparrow = 'M23 6.2l-2.8-1c-.6-2.6-3.2-3.8-5.4-3.4-2.2.4-3.6 1.8-4.4 3.6C8.2 6.4 5.6 7.6 3.2 8.4L.4 9.4l3.2 1.2c2.4 3 6.4 4 10 3 4-1 6.4-3.4 6.8-6.2L23 6.2zM18.3 4.6a.7.7 0 1 1-1.4 0 .7.7 0 1 1 1.4 0zM9 8.4c2.6-.6 5.4 0 7.2 1.8-2.4.4-5 .2-7.2-1.8z';
const legs = 'M12 13.6l-.4 2.8M14.2 13.4l.2 3';
---

<svg class:list={['level-icon', cls]} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {level === 'Forest' && (
    <>
      <path d="M4 41h40" />
      <path d="M12 41V35M12 35l-6 0 6-10 -4 0 4-7 4 7-4 0 6 10z" />
      <path d="M26 41v-5M26 36h-8l8-13-5 0 5-9 5 9-5 0 8 13z" />
      <path d="M38 41v-4M38 37h-5l5-8-3 0 3-5 3 5-3 0 5 8z" />
      <g transform="translate(20.5 3.6) scale(0.62)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /><path d={legs} stroke-width="1.6" /></g>
    </>
  )}
  {level === 'Tree' && (
    <>
      <path d="M24 31c-8 0-13-4.4-12.2-10.2.6-4.2 4-6.4 7.2-6.2.9-3.9 6.3-5.9 9.6-3.2 3.8-.8 7.6 1.8 7.6 5.7 3.6 1.6 3.9 8.5-.9 10.4-2 2.4-6.2 3.5-11.3 3.5z" />
      <path d="M24 41V24M24 41l-4 1.5M24 41l4 1.5M24 32l-6-6M24 29l6-7M24 24l-2-6" />
      <g transform="translate(29.5 3) scale(0.62)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /><path d={legs} stroke-width="1.6" /></g>
    </>
  )}
  {level === 'Branch' && (
    <>
      <path d="M4 38c9-2 20-8 30-16 3-2.4 6-5 10-8" />
      <path d="M17 33.4c-1.4-4-5-6-8.6-5.6 1 3.8 4.4 6 8.6 5.6z" />
      <path d="M27 27.2c.2-4.2-2.4-7.4-6-8.2-.4 3.8 2 7.4 6 8.2z" />
      <path d="M37 19.6c1.6-3.8.6-7.6-2.2-9.8-1.8 3.4-1 7.4 2.2 9.8z" />
      <path d="M29 29.4c3.8 1.6 7.6.4 9.6-2.4-3.4-1.6-7.4-.8-9.6 2.4z" />
      <g transform="translate(17 13.4) scale(0.62)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /><path d={legs} stroke-width="1.6" /></g>
    </>
  )}
  {level === 'Twig' && (
    <>
      <path d="M6 42L22 28M22 28l9-8M31 20l9-11M31 20l7 1.5" />
      <path d="M38 21.5c1.6-1.6 3.8-1.8 5.4-.6-1.6 1.6-3.8 1.8-5.4.6z" />
      <path d="M40 9c.2-2.4 1.8-4 4-4.2-.2 2.4-1.8 4-4 4.2z" />
      <path d="M13 29.5c2 5.5 13 5.5 15 0" />
      <path d="M14.5 32.5c3 1.5 9 1.5 12 0M13 29.5h15" stroke-width="1.2" />
      <g transform="translate(14 18.4) scale(0.62)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /><path d={legs} stroke-width="1.6" /></g>
    </>
  )}
  {level === 'Leaf' && (
    <>
      <path d="M9 39C8.4 23 20 11 40 8c.6 19-11 31-31 31z" />
      <path d="M9 39L34 14" />
      <path d="M15 33l-1-6M15 33l6 1M21 27l-1-7M21 27l7 1M27 21l0-6M27 21l6 0" stroke-width="1.3" />
      <path d="M9 39l-4 4" />
      <g transform="translate(30.5 21) scale(0.62)"><path d={sparrow} fill="currentColor" fill-rule="evenodd" stroke="none" /><path d={legs} stroke-width="1.6" /></g>
    </>
  )}
</svg>
